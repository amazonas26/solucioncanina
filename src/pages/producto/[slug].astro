---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { CheckCircle2, XCircle, ArrowRight, ShieldCheck } from "lucide-react";
import { slugify } from "../../utils/slugify";
import { productSchema, breadcrumbSchema } from "../../utils/seo";

export async function getStaticPaths() {
  const articulos = await getCollection("articulos");

  const categories = Array.from(
    new Set(articulos.map((a) => a.data.categoria).filter(Boolean) as string[]),
  );

  return articulos.map((art) => {
    const slug = art.data.slug || slugify(art.data.nombre);
    const related = articulos
      .filter(
        (a) =>
          a.data.categoria &&
          a.data.categoria === art.data.categoria &&
          (a.data.slug || slugify(a.data.nombre)) !== slug,
      )
      .slice(0, 8)
      .map((a) => ({
        slug: a.data.slug || slugify(a.data.nombre),
        nombre: a.data.nombre,
        imagen: a.data.imagen,
        precio: a.data.precio,
        marca: a.data.marca,
        linkAmazon: a.data.linkAmazon,
      }));
    return {
      params: { slug },
      props: { articulo: art, categories, related },
    };
  });
}

const { articulo, categories, related } = Astro.props;
const {
  nombre,
  descripcion,
  imagen,
  precio,
  precioOriginal,
  descuentoPct,
  linkAmazon,
  categoria,
  marca,
  veredicto,
  analisis,
  pros,
  contras,
  paraQuien,
  valoracion,
  valoracionesCount,
  ventas,
} = articulo.data;

function fmtCount(n) {
  if (!n || n <= 0) return null;
  if (n >= 1000) {
    const k = (n / 1000).toFixed(1);
    return (k.endsWith(".0") ? k.slice(0, -2) : k) + "k";
  }
  return n.toLocaleString("es-ES");
}

function fmtVentas(n) {
  if (!n || n <= 0) return null;
  if (n >= 1000) {
    const k = (n / 1000).toFixed(1);
    return (k.endsWith(".0") ? k.slice(0, -2) : k) + " mil";
  }
  return n.toLocaleString("es-ES");
}

const hasRating = typeof valoracion === "number" && valoracion >= 3.7;
const ratingCountTxt = fmtCount(valoracionesCount);
const ventasTxt = fmtVentas(ventas);

const productSlug = articulo.data.slug || slugify(nombre);
const productUrl = `/producto/${productSlug}`;
const categoriaSlug = categoria ? slugify(categoria) : null;

const productJsonLd = productSchema({
  name: nombre,
  description: descripcion,
  image: imagen,
  brand: marca,
  sku: productSlug,
  url: productUrl,
  price: precio,
  priceOriginal: precioOriginal,
  category: categoria,
  rating:
    typeof valoracion === "number" && valoracion > 0 ? valoracion : undefined,
  ratingCount:
    typeof valoracionesCount === "number" && valoracionesCount > 0
      ? valoracionesCount
      : undefined,
});

const breadcrumbItems = [{ name: "Inicio", url: "/" }];
if (categoria && categoriaSlug) {
  breadcrumbItems.push({ name: categoria, url: `/categoria/${categoriaSlug}` });
}
breadcrumbItems.push({ name: nombre, url: productUrl });
const breadcrumbJsonLd = breadcrumbSchema(breadcrumbItems);

const seoDescription =
  descripcion ||
  veredicto ||
  `Reseña detallada de ${nombre}${marca ? " de " + marca : ""} en Solución Canina.`;
---

<Layout
  title={`${nombre} - Reseña Editorial`}
  description={seoDescription}
  image={imagen}
  type="product"
  jsonLd={[productJsonLd, breadcrumbJsonLd]}
  categories={categories}
>
  <article class="max-w-6xl mx-auto px-4 md:px-0">
    {/* Breadcrumbs */}
    <nav
      aria-label="Breadcrumb"
      class="flex mb-6 text-[10px] font-bold uppercase tracking-widest text-neutral-400 gap-2 items-center flex-wrap"
    >
      <a href="/" class="hover:text-primary-600 transition-colors">Inicio</a>
      <span class="text-neutral-300">/</span>
      {
        categoria && (
          <>
            <a
              href={`/categoria/${categoria.toLowerCase().replace(/ /g, "-")}`}
              class="hover:text-primary-600 transition-colors"
            >
              {categoria}
            </a>
            <span class="text-neutral-300">/</span>
          </>
        )
      }
      <span
        class="text-neutral-900 truncate max-w-[150px] sm:max-w-none hidden sm:inline-block"
        >{nombre}</span
      >
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 xl:gap-16 items-start">
      {/* Columna Izquierda: Galería/Imagen */}
      <div class="lg:col-span-5 space-y-6">
        <a
          href={linkAmazon}
          target="_blank"
          rel="sponsored nofollow noopener noreferrer"
          class="group block relative rounded-3xl border border-neutral-100 bg-gradient-to-b from-white to-neutral-50/50 p-8 md:p-12 flex items-center justify-center min-h-[300px] md:min-h-[400px] shadow-sm overflow-hidden transition-all duration-500 hover:shadow-xl hover:shadow-primary-500/5 cursor-zoom-in"
          title="Ver en Amazon"
        >
          <div
            class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(60,158,145,0.03),transparent)] opacity-0 group-hover:opacity-100 transition-opacity"
          >
          </div>

          {
            descuentoPct && descuentoPct > 0 && (
              <div class="absolute top-6 left-6 z-10">
                <span class="bg-red-500 text-white text-[11px] font-black px-3 py-1.5 rounded-full shadow-lg shadow-red-500/20 uppercase tracking-wider">
                  -{descuentoPct}% Dto.
                </span>
              </div>
            )
          }

          {
            imagen ? (
              <img
                src={imagen}
                alt={nombre}
                width="600"
                height="600"
                loading="eager"
                decoding="async"
                fetchpriority="high"
                class="max-w-full max-h-[450px] object-contain mix-blend-multiply transition-transform duration-700 group-hover:scale-105"
              />
            ) : (
              <div class="text-neutral-200">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="80"
                  height="80"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <>
                    <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
                    <circle cx="9" cy="9" r="2" />
                    <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
                  </>
                </svg>
              </div>
            )
          }

          <div
            class="absolute bottom-6 right-6 opacity-0 group-hover:opacity-100 transition-opacity bg-white/90 backdrop-blur-sm p-2 rounded-xl shadow-sm border border-neutral-100"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-primary-600"
              ><path
                d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
              ></path><polyline points="15 3 21 3 21 9"></polyline><line
                x1="10"
                y1="14"
                x2="21"
                y2="3"></line></svg
            >
          </div>
        </a>

        {/* Veredicto Editorial (Destacado) */}
        {
          veredicto && (
            <div class="bg-white border border-primary-100 rounded-2xl p-6 relative overflow-hidden shadow-sm group">
              <div class="absolute top-0 left-0 w-1.5 h-full bg-gradient-to-b from-primary-400 to-primary-600" />
              <div class="flex items-center gap-2 mb-3 text-primary-700">
                <div class="p-1.5 bg-primary-50 rounded-lg">
                  <ShieldCheck size={18} />
                </div>
                <h3 class="text-[11px] font-black uppercase tracking-widest">
                  Recomendación Solución Canina
                </h3>
              </div>
              <p class="text-neutral-800 font-medium text-[15px] leading-relaxed italic">
                "{veredicto}"
              </p>
            </div>
          )
        }
      </div>

      {/* Columna Derecha: Info Principal */}
      <div class="lg:col-span-7 min-w-0">
        <div class="flex flex-wrap items-center gap-3 mb-6">
          {
            marca && (
              <span class="px-4 py-1.5 bg-navy-700 text-white rounded-lg text-[11px] font-black uppercase tracking-[0.1em] shadow-sm shadow-navy-900/10">
                {marca}
              </span>
            )
          }
          {
            categoria && (
              <span class="px-4 py-1.5 bg-primary-50 text-primary-700 rounded-lg text-[11px] font-black uppercase tracking-[0.1em] border border-primary-100">
                {categoria}
              </span>
            )
          }
        </div>

        <h1
          class="text-2xl sm:text-3xl lg:text-4xl font-sans font-black text-neutral-900 mb-2 leading-tight tracking-tight break-words [hyphens:auto]"
          lang="es"
        >
          {nombre}
        </h1>

        {
          marca && (
            <p class="text-neutral-400 text-sm font-bold uppercase tracking-widest mb-6">
              Por <span class="text-neutral-600">{marca}</span>
            </p>
          )
        }

        {/* Valoración + Social Proof */}
        {
          (hasRating || ventasTxt) && (
            <div class="flex flex-wrap items-center gap-x-8 gap-y-4 mb-6">
              {hasRating && (
                <div class="flex items-center gap-3 bg-neutral-50 px-3 py-1.5 rounded-2xl border border-neutral-100">
                  <div class="flex items-center gap-1">
                    {[...Array(5)].map((_, i) => (
                      <svg
                        viewBox="0 0 24 24"
                        class={`h-3.5 w-3.5 ${i < Math.floor(valoracion || 0) ? "text-yellow-400" : "text-neutral-200"}`}
                        fill="currentColor"
                      >
                        <polygon points="12,2 14.94,8.96 22.5,9.56 16.74,14.62 18.49,22 12,17.93 5.51,22 7.26,14.62 1.5,9.56 9.06,8.96" />
                      </svg>
                    ))}
                  </div>
                  <span class="text-base font-black text-neutral-900 tabular-nums">
                    {(valoracion ?? 0).toFixed(1)}
                  </span>
                  {ratingCountTxt && (
                    <span class="text-[10px] font-bold text-neutral-400 border-l border-neutral-200 pl-3">
                      {ratingCountTxt} reseñas
                    </span>
                  )}
                </div>
              )}

              {ventasTxt && (
                <div class="flex items-center gap-2 text-sm">
                  <span class="flex h-2 w-2 rounded-full bg-green-500 animate-pulse" />
                  <span class="font-bold text-neutral-700 uppercase tracking-tight text-[10px]">
                    {ventasTxt}+ comprados este mes
                  </span>
                </div>
              )}
            </div>
          )
        }

        {/* Extracto del Análisis para subir el contenido */}
        <div
          class="mb-6 line-clamp-3 text-neutral-600 text-sm leading-relaxed italic border-l-2 border-neutral-100 pl-4"
        >
          {analisis ? analisis.split("\n\n")[0] : descripcion}
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center gap-6 mb-8">
          <div class="flex items-baseline gap-3">
            <span
              class="text-3xl lg:text-4xl font-black text-neutral-900 tracking-tighter"
              >{precio || "Consultar"}</span
            >
            {
              precioOriginal && (
                <div class="flex flex-col">
                  <span class="text-base text-neutral-300 line-through font-bold decoration-red-500/20">
                    {precioOriginal}
                  </span>
                  {descuentoPct && (
                    <span class="text-[10px] font-black text-red-600 uppercase">
                      Ahorra -{descuentoPct}%
                    </span>
                  )}
                </div>
              )
            }
          </div>

          <a
            href={linkAmazon}
            target="_blank"
            rel="sponsored nofollow noopener noreferrer"
            class="group inline-flex items-center justify-center gap-3 px-8 py-4 bg-[#FF9900] hover:bg-[#E68A00] text-black font-black text-sm rounded-2xl transition-all shadow-lg shadow-orange-500/10 hover:shadow-orange-500/20 hover:-translate-y-0.5 active:translate-y-0"
          >
            Ver mejor precio en Amazon
            <ArrowRight
              size={18}
              class="transition-transform group-hover:translate-x-1"
            />
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
          <div
            class="flex items-center gap-3 p-4 rounded-2xl bg-neutral-50 border border-neutral-100"
          >
            <div
              class="h-10 w-10 flex items-center justify-center rounded-xl bg-white shadow-sm"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                class="text-primary-600"
                ><path d="M22 10v6M2 10v6"></path><path d="M6 12h12"
                ></path><path d="M12 4v16"></path><path d="M15 8l-3-3-3 3"
                ></path><path d="M15 16l-3 3-3-3"></path></svg
              >
            </div>
            <div>
              <span
                class="block text-[10px] font-black uppercase tracking-widest text-neutral-400"
                >Envío</span
              >
              <span class="text-sm font-bold text-neutral-700"
                >Rápido con Amazon Prime</span
              >
            </div>
          </div>
          <div
            class="flex items-center gap-3 p-4 rounded-2xl bg-neutral-50 border border-neutral-100"
          >
            <div
              class="h-10 w-10 flex items-center justify-center rounded-xl bg-white shadow-sm"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                class="text-primary-600"
                ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                ></path><path d="m9 12 2 2 4-4"></path></svg
              >
            </div>
            <div>
              <span
                class="block text-[10px] font-black uppercase tracking-widest text-neutral-400"
                >Garantía</span
              >
              <span class="text-sm font-bold text-neutral-700"
                >Compra 100% segura</span
              >
            </div>
          </div>
        </div>
        {/* Pros y Contras */}
        {
          (pros && pros.length > 0) || (contras && contras.length > 0) ? (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-10">
              {pros && pros.length > 0 && (
                <div class="bg-emerald-50/30 border border-emerald-100 rounded-2xl p-6 relative overflow-hidden group">
                  <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                    <CheckCircle2 size={40} className="text-emerald-600" />
                  </div>
                  <h4 class="text-[10px] font-black uppercase tracking-widest text-emerald-800 mb-5 flex items-center gap-2">
                    Puntos Positivos
                  </h4>
                  <ul class="space-y-3.5">
                    {pros.map((pro: string) => (
                      <li class="flex items-start gap-3 text-[14px] text-neutral-700 leading-tight">
                        <CheckCircle2
                          size={16}
                          className="text-emerald-500 mt-0.5 shrink-0"
                        />
                        <span class="font-medium">{pro}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {contras && contras.length > 0 && (
                <div class="bg-rose-50/30 border border-rose-100 rounded-2xl p-6 relative overflow-hidden group">
                  <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                    <XCircle size={40} className="text-rose-600" />
                  </div>
                  <h4 class="text-[10px] font-black uppercase tracking-widest text-rose-800 mb-5 flex items-center gap-2">
                    A tener en cuenta
                  </h4>
                  <ul class="space-y-3.5">
                    {contras.map((contra: string) => (
                      <li class="flex items-start gap-3 text-[14px] text-neutral-700 leading-tight">
                        <XCircle
                          size={16}
                          className="text-rose-400 mt-0.5 shrink-0"
                        />
                        <span class="font-medium">{contra}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          ) : null
        }
      </div>
    </div>

    {/* Sección de Análisis Detallado */}
    <div class="mt-12 border-t border-neutral-100 pt-12 max-w-4xl">
      <div class="max-w-none">
        <div
          class="inline-flex items-center gap-2 mb-8 px-4 py-1.5 bg-neutral-900 text-white rounded-full shadow-lg shadow-neutral-900/10"
        >
          <span class="w-2 h-2 rounded-full bg-primary-400 animate-pulse"
          ></span>
          <span class="text-[10px] font-black uppercase tracking-widest"
            >Análisis del Equipo</span
          >
        </div>
        <div
          class="prose prose-neutral prose-p:leading-[1.9] prose-p:text-neutral-600 prose-p:text-[16px] md:prose-p:text-[17px] prose-h2:font-sans prose-h2:text-2xl prose-h2:font-black prose-a:text-primary-600"
        >
          {
            analisis ? (
              <>
                {analisis.split("\n\n").map((paragraph: string) => (
                  <p class="mb-6">{paragraph}</p>
                ))}
              </>
            ) : (
              <p class="mb-6">{descripcion}</p>
            )
          }
        </div>
      </div>

      {/* ¿Para quién es? */}
      {
        paraQuien && (
          <div class="mt-12 bg-navy-900 text-white rounded-3xl p-8 sm:p-12 relative overflow-hidden group shadow-2xl shadow-navy-900/20">
            <div class="absolute -right-8 -bottom-8 opacity-5 group-hover:scale-110 transition-transform duration-500">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="200"
                height="200"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M10 5.172C10 3.782 8.823 2.65 7.412 2.65 5.918 2.65 4.706 3.84 4.706 5.308c0 1.25.753 2.317 1.83 2.766-.23.107-.46.244-.687.41-.837.61-1.393 1.543-1.554 2.585-.117.76-.08 1.53.11 2.26.19.73.5 1.41.91 2.02.41.61.91 1.14 1.48 1.57.57.43 1.2.78 1.87 1.03.67.25 1.37.41 2.08.48.71.07 1.43.05 2.14-.06.71-.11 1.4-.31 2.06-.61.66-.3 1.28-.69 1.83-1.16.55-.47 1.03-1.02 1.41-1.64.38-.62.66-1.3.83-2.01.17-.71.24-1.44.2-2.17-.04-.73-.18-1.45-.42-2.14-.24-.69-.58-1.34-1.01-1.92-.43-.58-.95-1.1-1.54-1.54-.59-.44-1.25-.8-1.96-1.06-.71-.26-1.46-.42-2.23-.48-.77-.06-1.54-.02-2.31.12-.77.14-1.52.38-2.22.73-.7.35-1.34.8-1.91 1.34-.57.54-1.05 1.17-1.43 1.87-.38.7-.64 1.46-.77 2.26-.13.8-.14 1.62-.03 2.44.11.82.34 1.62.67 2.38.33.76.77 1.47 1.3 2.12.53.65 1.15 1.23 1.85 1.72.7.49 1.48.88 2.31 1.16.83.28 1.7.45 2.59.51.89.06 1.79.01 2.68-.15.89-.16 1.76-.43 2.58-.81.82-.38 1.58-.87 2.27-1.46.69-.59 1.29-1.28 1.78-2.05.49-.77.86-1.62 1.1-2.52.24-.9.36-1.84.34-2.79-.02-.95-.16-1.89-.42-2.81-.26-.92-.64-1.8-1.14-2.62-.5-.82-1.11-1.58-1.81-2.26-.7-.68-1.49-1.27-2.36-1.74-.87-.47-1.81-.83-2.8-1.08-.99-.25-2.02-.38-3.06-.38-1.04 0-2.07.13-3.06.38-.99.25-1.93.61-2.8 1.08-.87.47-1.66 1.06-2.36 1.74-.7.68-1.31 1.44-1.81 2.26-.5.82-.88 1.7-1.14 2.62-.26.92-.4 1.86-.42 2.81-.02.95.1 1.89.34 2.79.24.9.61 1.75 1.1 2.52.49.77 1.09 1.46 1.78 2.05.69.59 1.45 1.08 2.27 1.46.82.38 1.69.65 2.58.81.89.16 1.79.21 2.68.15.89-.06 1.76-.23 2.59-.51.83-.28 1.61-.67 2.31-1.16.7-.49 1.32-1.07 1.85-1.72.53-.65.97-1.36 1.3-2.12.33-.76.56-1.56.67-2.38.11-.82.1-1.64-.03-2.44-.13-.8-.39-1.56-.77-2.26-.38-.7-.86-1.33-1.43-1.87-.57-.54-1.21-.99-1.91-1.34-.7-.35-1.45-.59-2.22-.73-.77-.14-1.54-.18-2.31-.12-.77.06-1.52.22-2.23.48-.71.26-1.37.62-1.96 1.06-.59.44-1.11.96-1.54 1.54-.43.58-.77 1.23-1.01 1.92-.24.69-.38 1.41-.42 2.14-.04.73.03 1.46.2 2.17.17.71.45 1.39.83 2.01.38.62.86 1.17 1.41 1.64.55.47 1.17.86 1.83 1.16.66.3 1.35.5 2.06.61.71.11 1.43.13 2.14.06.71-.07 1.41-.23 2.08-.48.67-.25 1.3-.6 1.87-1.03.57-.43 1.07-.96 1.48-1.57.41-.61.72-1.29.91-2.02.19-.73.227-1.5.11-2.26-.161-1.042-.717-1.975-1.554-2.585" />
              </svg>
            </div>
            <h3 class="text-[11px] font-black uppercase tracking-[0.2em] text-primary-400 mb-4">
              ¿Para quién es ideal?
            </h3>
            <p class="text-white/90 text-lg sm:text-xl font-medium leading-relaxed max-w-2xl">
              {paraQuien}
            </p>
          </div>
        )
      }
    </div>

    {
      related && related.length > 0 && (
        <section class="mt-20 pt-12 border-t border-neutral-100 relative overflow-hidden">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
            <div>
              <p class="text-[10px] font-black uppercase tracking-widest text-primary-600 mb-2">
                Más opciones
              </p>
              <h2 class="text-3xl md:text-4xl font-serif font-black text-neutral-900 tracking-tight leading-none">
                También te puede <br class="sm:hidden" /> interesar
              </h2>
            </div>
            <a
              href="/productos"
              class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-widest text-neutral-400 hover:text-primary-600 transition-colors whitespace-nowrap"
            >
              Ver catálogo completo
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <>
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </>
              </svg>
            </a>
          </div>

          <div class="flex gap-5 overflow-x-auto pb-12 scrollbar-none snap-x snap-mandatory -mx-4 px-4 sm:mx-0 sm:px-0">
            {related.map((r) => (
              <div class="min-w-[260px] sm:min-w-[280px] snap-start">
                <div
                  class="group flex flex-col h-full bg-white border border-neutral-100 rounded-[32px] p-5 hover:shadow-2xl hover:shadow-neutral-200/50 transition-all duration-500 hover:-translate-y-1"
                >
                  <a href={`/producto/${r.slug}`} class="block mb-6">
                    <div class="aspect-square flex items-center justify-center bg-neutral-50 rounded-2xl overflow-hidden relative group-hover:bg-white transition-colors">
                      {r.imagen ? (
                        <img
                          src={r.imagen}
                          alt={r.nombre}
                          width="300"
                          height="300"
                          loading="lazy"
                          decoding="async"
                          class="max-w-[70%] max-h-[70%] object-contain mix-blend-multiply group-hover:scale-110 transition-transform duration-500"
                        />
                      ) : null}
                    </div>
                  </a>

                  <div class="flex-grow flex flex-col">
                    <div class="mb-4">
                      {r.marca && (
                        <span class="block text-[9px] font-black uppercase tracking-[0.15em] text-neutral-400 mb-2">
                          {r.marca}
                        </span>
                      )}
                      <a href={`/producto/${r.slug}`} class="group/title">
                        <h3 class="text-sm font-bold text-neutral-900 leading-tight line-clamp-2 group-hover/title:text-primary-600 transition-colors">
                          {r.nombre}
                        </h3>
                      </a>
                    </div>

                    <div class="mt-auto space-y-4">
                      <div class="flex items-center justify-between">
                         <span class="text-lg font-black text-neutral-900">
                          {r.precio || "Consultar"}
                        </span>
                        <a 
                          href={`/producto/${r.slug}`}
                          class="text-[10px] font-black uppercase tracking-widest text-neutral-400 hover:text-primary-600 transition-colors"
                        >
                          Análisis →
                        </a>
                      </div>
                      
                      <a
                        href={r.linkAmazon}
                        target="_blank"
                        rel="sponsored nofollow noopener noreferrer"
                        class="flex items-center justify-center gap-2 w-full py-3 bg-[#FF9900] hover:bg-[#E68A00] text-black text-[11px] font-black rounded-2xl transition-all shadow-md shadow-orange-500/5 hover:shadow-orange-500/20 active:scale-[0.98]"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
                        Ver en Amazon
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }
  </article>

  {/* Sticky Mobile CTA */}
  <div
    class="fixed bottom-0 left-0 right-0 p-4 bg-white/80 backdrop-blur-xl border-t border-neutral-100 shadow-[0_-20px_40px_rgba(0,0,0,0.05)] sm:hidden z-50 flex items-center justify-between gap-4"
  >
    <div class="flex flex-col">
      <span class="text-xl font-black text-neutral-900 leading-none"
        >{precio || "Consultar"}</span
      >
      {
        descuentoPct && (
          <span class="text-[9px] font-black text-red-600 tracking-wider uppercase mt-1">
            Oferta Limitada
          </span>
        )
      }
    </div>
    <a
      href={linkAmazon}
      target="_blank"
      rel="sponsored nofollow noopener noreferrer"
      class="flex-1 flex items-center justify-center px-6 py-4 bg-[#FF9900] active:scale-95 text-black font-black text-sm rounded-2xl transition-all shadow-lg shadow-orange-500/20"
    >
      Ver en Amazon
    </a>
  </div>
</Layout>
