---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CheckCircle2, XCircle, ArrowRight, ShieldCheck } from 'lucide-react';
import { slugify } from '../../utils/slugify';

export async function getStaticPaths() {
  const articulos = await getCollection('articulos');
  
  // Extraemos las categorías para pasarlas al Layout
  const categories = Array.from(
    new Set(articulos.map((a) => a.data.categoria).filter(Boolean) as string[])
  );

  return articulos.map((art) => ({
    params: { slug: slugify(art.data.nombre) },
    props: { articulo: art, categories },
  }));
}

const { articulo, categories } = Astro.props;
const {
  nombre,
  descripcion,
  imagen,
  precio,
  precioOriginal,
  descuentoPct,
  linkAmazon,
  categoria,
  marca,
  veredicto,
  analisis,
  pros,
  contras,
  paraQuien
} = articulo.data;
---

<Layout title={`${nombre} - Reseña Editorial`} description={descripcion} categories={categories}>
  <article class="max-w-5xl mx-auto">
    {/* Breadcrumbs */}
    <nav class="flex mb-6 text-xs font-medium text-neutral-400 gap-2 items-center flex-wrap">
      <a href="/" class="hover:text-primary-600 transition-colors">Inicio</a>
      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      {categoria && (
        <>
          <a href={`/categoria/${categoria.toLowerCase().replace(/ /g, '-')}`} class="hover:text-primary-600 transition-colors">{categoria}</a>
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </>
      )}
      <span class="text-neutral-900 truncate max-w-[200px] sm:max-w-xs">{nombre}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
      {/* Columna Izquierda: Imagen y Veredicto */}
      <div class="lg:col-span-5 space-y-6">
        <div class="relative rounded-2xl border border-neutral-200 bg-white p-6 md:p-10 flex items-center justify-center min-h-[300px] shadow-sm">
          {descuentoPct && descuentoPct > 0 && (
            <div class="absolute top-4 left-4 bg-red-500 text-white text-xs font-black px-2.5 py-1 rounded-md">
              -{descuentoPct}%
            </div>
          )}
          {imagen ? (
            <img src={imagen} alt={nombre} class="max-w-full max-h-[400px] object-contain mix-blend-multiply" />
          ) : (
            <div class="text-neutral-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
            </div>
          )}
        </div>

        {/* Veredicto Editorial (Si existe) */}
        {veredicto && (
          <div class="bg-primary-50 border border-primary-100 rounded-xl p-6 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-1.5 h-full bg-primary-500"></div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-primary-700 mb-3 flex items-center gap-2">
              <ShieldCheck size={16} className="text-primary-600" />
              Nuestro Veredicto
            </h3>
            <p class="text-primary-900 font-medium text-sm leading-relaxed">
              {veredicto}
            </p>
          </div>
        )}
      </div>

      {/* Columna Derecha: Título, CTA, y Análisis */}
      <div class="lg:col-span-7">
        {marca && (
          <span class="inline-block px-2.5 py-1 bg-neutral-100 text-neutral-600 rounded-md text-xs font-bold mb-4 uppercase tracking-wide">
            {marca}
          </span>
        )}
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-black text-neutral-900 mb-6 leading-[1.15]">
          {nombre}
        </h1>

        <div class="flex items-center gap-4 mb-8">
          <div class="flex items-baseline gap-2">
            <span class="text-3xl font-black text-neutral-900">{precio || 'Consultar'}</span>
            {precioOriginal && (
              <span class="text-lg text-neutral-400 line-through font-medium">{precioOriginal}</span>
            )}
          </div>
        </div>

        <div class="mb-10">
          <a
            href={linkAmazon}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center w-full sm:w-auto gap-3 px-8 py-4 bg-[#FF9900] hover:bg-[#E68A00] text-black font-black text-lg rounded-xl shadow-lg shadow-orange-500/20 transition-all hover:-translate-y-0.5"
          >
            Ver precio en Amazon
            <ArrowRight size={20} />
          </a>
          <p class="text-xs text-neutral-400 mt-3 text-center sm:text-left">
            * Enlace de afiliado. Comprar no te supone un coste extra.
          </p>
        </div>

        <hr class="border-neutral-100 mb-10" />

        {/* Pros y Contras */}
        {(pros && pros.length > 0) || (contras && contras.length > 0) ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-12">
            {pros && pros.length > 0 && (
              <div class="bg-green-50/50 border border-green-100 rounded-xl p-5">
                <h4 class="text-sm font-bold text-green-800 mb-4 flex items-center gap-2">
                  <CheckCircle2 size={16} className="text-green-600" />
                  Lo que nos gusta
                </h4>
                <ul class="space-y-3">
                  {pros.map((pro: string) => (
                    <li class="flex items-start gap-2.5 text-sm text-neutral-700 leading-relaxed">
                      <span class="text-green-500 mt-0.5 shrink-0">•</span>
                      {pro}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {contras && contras.length > 0 && (
              <div class="bg-red-50/50 border border-red-100 rounded-xl p-5">
                <h4 class="text-sm font-bold text-red-800 mb-4 flex items-center gap-2">
                  <XCircle size={16} className="text-red-500" />
                  Aspectos a mejorar
                </h4>
                <ul class="space-y-3">
                  {contras.map((contra: string) => (
                    <li class="flex items-start gap-2.5 text-sm text-neutral-700 leading-relaxed">
                      <span class="text-red-400 mt-0.5 shrink-0">•</span>
                      {contra}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ) : null}

        {/* Análisis Detallado */}
        <div class="prose prose-neutral prose-p:leading-relaxed prose-h2:font-serif prose-h2:text-2xl prose-h2:font-black prose-a:text-primary-600 max-w-none">
          {analisis ? (
            <>
              <h2>Análisis Detallado</h2>
              {/* Splitting by double newline to create paragraphs if it comes as a single block */}
              {analisis.split('\n\n').map((paragraph: string) => (
                <p class="text-[15px] text-neutral-600 mb-5">{paragraph}</p>
              ))}
            </>
          ) : (
            <p class="text-[15px] text-neutral-600 leading-relaxed">{descripcion}</p>
          )}
        </div>

        {/* ¿Para quién es? */}
        {paraQuien && (
          <div class="mt-12 bg-neutral-50 border border-neutral-200 rounded-xl p-6 sm:p-8">
            <h3 class="text-sm font-bold uppercase tracking-wider text-neutral-900 mb-3">
              ¿Para quién es ideal?
            </h3>
            <p class="text-neutral-600 text-[15px] leading-relaxed">
              {paraQuien}
            </p>
          </div>
        )}
      </div>
    </div>
  </article>
</Layout>
