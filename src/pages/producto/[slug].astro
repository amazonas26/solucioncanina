---
import Layout from "../../layouts/Layout.astro";
import TipoAnalisisBadge from "../../components/TipoAnalisisBadge.astro";
import ProductCard from "../../components/ProductCard.astro";
import { getCollection } from "astro:content";
import { ArrowRight } from "lucide-react";
import { slugify } from "../../utils/slugify";
import { outboundProductUrl } from "../../utils/outbound";
import { productSchema, breadcrumbSchema } from "../../utils/seo";
import { blogsForProduct } from "../../utils/blogProductLinks";
import { pesoTalla } from "../../components/PanalCalculator";
import { TIPO_ANALISIS_DEFAULT, tipoAnalisisHref } from "../../utils/tipoAnalisis";
import { fechaPrecio, formatFechaPrecio, notaPrecios } from "../../utils/precioConsultado";

export async function getStaticPaths() {
  const articulos = await getCollection("articulos");

  const categories = Array.from(
    new Set(articulos.map((a) => a.data.categoria).filter(Boolean) as string[]),
  );

  return articulos.map((art) => {
    const slug = art.data.slug || slugify(art.data.nombre);
    const related = articulos
      .filter(
        (a) =>
          a.data.categoria &&
          a.data.categoria === art.data.categoria &&
          a.data.disponible !== false &&
          Boolean(a.data.precio) &&
          (a.data.slug || slugify(a.data.nombre)) !== slug,
      )
      .slice(0, 8)
      .map((a) => ({
        slug: a.data.slug || slugify(a.data.nombre),
        nombre: a.data.nombreCorto || a.data.nombre,
        imagen: a.data.imagen,
        precio: a.data.precio,
        precioOriginal: a.data.precioOriginal,
        descuentoPct: a.data.descuentoPct,
        marca: a.data.marca,
        valoracion: a.data.valoracion,
        valoracionesCount: a.data.valoracionesCount,
      }));
    return {
      params: { slug },
      props: { articulo: art, categories, related },
    };
  });
}

const { articulo, categories, related } = Astro.props;
const {
  nombre,
  nombreCorto,
  descripcion,
  imagen,
  precio,
  precioOriginal,
  descuentoPct,
  disponible,
  linkAmazon,
  categoria,
  marca,
  veredicto,
  analisis,
  experienciaReal,
  pros,
  contras,
  paraQuien,
  tipoAnalisis,
  valoracion,
  valoracionesCount,
  ventas,
} = articulo.data;

function fmtCount(n) {
  if (!n || n <= 0) return null;
  if (n >= 1000) {
    const k = (n / 1000).toFixed(1);
    return (k.endsWith(".0") ? k.slice(0, -2) : k) + "k";
  }
  return n.toLocaleString("es-ES");
}

function fmtVentas(n) {
  if (!n || n <= 0) return null;
  if (n >= 1000) {
    const k = (n / 1000).toFixed(1);
    return (k.endsWith(".0") ? k.slice(0, -2) : k) + " mil";
  }
  return n.toLocaleString("es-ES");
}

const hasRating = typeof valoracion === "number" && valoracion >= 3.7;
const ratingCountTxt = fmtCount(valoracionesCount);
const ventasTxt = fmtVentas(ventas);

const displayName = nombreCorto || nombre;
const [analisisIntro, ...analisisResto] = analisis ? analisis.split("\n\n") : [];
const isPendiente = (tipoAnalisis ?? TIPO_ANALISIS_DEFAULT) === "Pendiente";
const productSlug = articulo.data.slug || slugify(nombre);
const esPiensoRenal =
  categoria === "Alimentación específica" &&
  /renal|kidney/i.test(`${productSlug} ${nombre} ${nombreCorto ?? ""}`);
const productUrl = `/producto/${productSlug}/`;
const precioFecha = fechaPrecio(productSlug);
const noDisponible = disponible === false;
const notaRelated = notaPrecios(related.map((r) => r.slug));
const outboundUrl = outboundProductUrl(productSlug);
const categoriaSlug = categoria ? slugify(categoria) : null;

const productJsonLd = productSchema({
  name: displayName,
  description: descripcion,
  image: imagen,
  brand: marca,
  sku: productSlug,
  url: productUrl,
  price: precio,
  priceOriginal: precioOriginal,
  category: categoria,
  pros,
  cons: contras,
  reviewBody: veredicto,
});

const breadcrumbItems = [{ name: "Inicio", url: "/" }];
if (categoria && categoriaSlug) {
  breadcrumbItems.push({ name: categoria, url: `/categoria/${categoriaSlug}/` });
}
breadcrumbItems.push({ name: displayName, url: productUrl });
const breadcrumbJsonLd = breadcrumbSchema(breadcrumbItems);

// Meta description: el veredicto editorial (únic, ~120 car.) abans que la descripció
// d'Amazon (text comercial, repetit entre variants i de fins a 500 car.), retallada
// sense partir paraules perquè Google no la talli a mitja frase.
function recortar(texto: string, max = 158): string {
  if (texto.length <= max) return texto;
  const palabras = texto.slice(0, max - 1).split(" ").slice(0, -1);
  // Sense acabar en article, preposició o conjunció («…conserva muy bien el…»).
  const vacias = new Set(["el", "la", "los", "las", "un", "una", "de", "del", "y", "o", "con", "en", "a", "al", "por", "para", "que", "su", "sus"]);
  while (palabras.length > 1 && vacias.has(palabras[palabras.length - 1].toLowerCase())) palabras.pop();
  return palabras.join(" ").replace(/[\s,.;:–-]+$/, "") + "…";
}
const seoDescription = recortar(
  articulo.data.descripcionSeo ||
    veredicto ||
    descripcion ||
    `Reseña detallada de ${displayName}${marca ? " de " + marca : ""} en Solución Canina.`,
);

const pageTitle = `${displayName} · análisis y precio`;

const relatedBlogs = blogsForProduct(categoria, articulo.data.secciones);
---

<Layout
  title={pageTitle}
  description={seoDescription}
  image={imagen}
  type="product"
  jsonLd={[productJsonLd, breadcrumbJsonLd]}
  categories={categories}
  noindex={isPendiente}
>
  <article>
    {/* Breadcrumbs */}
    <nav
      aria-label="Breadcrumb"
      class="flex mb-6 lg:mb-8 text-sm text-neutral-500 gap-2 items-center flex-wrap"
    >
      <a href="/" class="hover:text-primary-600 transition-colors">Inicio</a>
      <span class="text-neutral-300">/</span>
      {
        categoria && (
          <>
            <a
              href={`/categoria/${slugify(categoria)}/`}
              class="hover:text-primary-600 transition-colors"
            >
              {categoria}
            </a>
            <span class="text-neutral-300">/</span>
          </>
        )
      }
      <span
        class="text-neutral-800 truncate max-w-[150px] sm:max-w-none hidden sm:inline-block"
        aria-current="page"
        >{displayName}</span
      >
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 xl:gap-20 items-start">
      {/* Imagen */}
      <div class="lg:col-span-6 lg:sticky lg:top-32">
        <div class="relative aspect-square bg-neutral-50 flex items-center justify-center p-8 md:p-14 overflow-hidden">
          {imagen ? (
            <img
              src={imagen}
              alt={`Comprar ${displayName} al mejor precio`}
              title={`${displayName}${marca ? ` - ${marca}` : ""}`}
              width="700"
              height="700"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              class="max-w-full max-h-full object-contain mix-blend-multiply"
            />
          ) : (
            <span class="text-neutral-400 text-sm">Sin imagen</span>
          )}
        </div>
      </div>

      {/* Columna Derecha: Info Principal */}
      <div class="lg:col-span-6 min-w-0">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 mb-3 text-sm text-neutral-500">
          {marca && <span class="font-semibold text-neutral-700">{marca}</span>}
          {marca && categoria && <span aria-hidden="true">·</span>}
          {categoria && (
            <a href={`/categoria/${slugify(categoria)}/`} class="hover:text-primary-700 hover:underline underline-offset-2">{categoria}</a>
          )}
          <span aria-hidden="true">·</span>
          <TipoAnalisisBadge tipo={tipoAnalisis ?? TIPO_ANALISIS_DEFAULT} />
        </p>

        <h1
          class="font-serif text-[2.1rem] sm:text-5xl xl:text-[3.6rem] font-semibold text-neutral-900 leading-[1.02] tracking-[-0.025em] break-words [hyphens:auto]"
          lang="es"
        >
          {displayName}
        </h1>

        {veredicto && (
          <p class="mt-5 font-serif text-xl md:text-2xl leading-snug text-neutral-700">{veredicto}</p>
        )}

        {
          isPendiente && (
            <div
              class="mb-6 rounded-2xl border border-amber-200 bg-amber-50 p-4"
              role="status"
            >
              <p class="text-sm font-bold text-amber-900 mb-1">
                Análisis pendiente
              </p>
              <p class="text-sm text-amber-950/80 leading-relaxed">
                Aún no hemos analizado esta ficha a fondo. Los datos que ves
                (medidas, materiales, capacidad) salen de la ficha del
                fabricante, no de un veredicto nuestro.{" "}
                <a
                  href={tipoAnalisisHref("Pendiente")}
                  class="font-bold text-amber-900 underline decoration-amber-400 underline-offset-2 hover:text-amber-950"
                >
                  Qué significa Pendiente
                </a>
              </p>
            </div>
          )
        }

        <p class="mt-5 mb-4 text-sm text-neutral-500 leading-snug">
          <span class="text-neutral-400">Nombre en Amazon:</span> {nombre}
        </p>

        {/* Valoración + Social Proof */}
        {
          (hasRating || ventasTxt) && (
            <div class="flex flex-wrap items-center gap-x-8 gap-y-3 pb-6 mb-6 border-b border-neutral-300">
              {hasRating && (
                <div class="flex items-center gap-2">
                  <div class="flex items-center gap-1">
                    {[...Array(5)].map((_, i) => (
                      <svg
                        viewBox="0 0 24 24"
                        class={`h-4 w-4 ${i < Math.floor(valoracion || 0) ? "text-[#d99a1e]" : "text-neutral-300"}`}
                        fill="currentColor"
                      >
                        <polygon points="12,2 14.94,8.96 22.5,9.56 16.74,14.62 18.49,22 12,17.93 5.51,22 7.26,14.62 1.5,9.56 9.06,8.96" />
                      </svg>
                    ))}
                  </div>
                  <span class="text-base font-bold text-neutral-900 tabular-nums">
                    {(valoracion ?? 0).toFixed(1)}
                  </span>
                  {ratingCountTxt ? (
                    <span class="text-xs text-neutral-500">
                      ({ratingCountTxt} reseñas en Amazon)
                    </span>
                  ) : (
                    <span class="text-xs text-neutral-500">
                      en Amazon
                    </span>
                  )}
                </div>
              )}

              {ventasTxt && (
                <div class="text-xs text-neutral-500">
                  <span>
                    {ventasTxt}+ comprados el mes pasado en Amazon
                  </span>
                </div>
              )}
            </div>
          )
        }

        {
          analisis && (
            <div class="mb-7">
              <h2 class="font-sans text-sm font-bold text-neutral-900 mb-2">
                Por qué lo hemos analizado
              </h2>
              <p class="font-serif text-lg leading-relaxed text-neutral-800">
                {analisisIntro}
              </p>
            </div>
          )
        }

        {/* Para qué tipo de perro está pensado */}
        {paraQuien && (
          <div class="mb-7">
            <h2 class="font-sans text-sm font-bold text-neutral-900 mb-2">
              Para qué tipo de perro está pensado
            </h2>
            <p class="font-serif text-lg leading-relaxed text-neutral-800">
              {paraQuien}
            </p>
          </div>
        )}

        {/* Pros y Contras (movidos arriba del precio) */}
        {((pros && pros.length > 0) || (contras && contras.length > 0)) && (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-6 mb-9">
            {pros && pros.length > 0 && (
              <div class="border-t-2 border-neutral-900 pt-3">
                <h2 class="font-sans text-sm font-bold text-neutral-900 mb-3">A favor</h2>
                <ul class="space-y-2.5">
                  {pros.map((pro: string) => (
                    <li class="flex items-start gap-2.5 text-[15px] text-neutral-800 leading-snug">
                      <span class="text-primary-600 font-bold shrink-0" aria-hidden="true">+</span>
                      <span>{pro}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {contras && contras.length > 0 && (
              <div class="border-t-2 border-neutral-900 pt-3">
                <h2 class="font-sans text-sm font-bold text-neutral-900 mb-3">A tener en cuenta</h2>
                <ul class="space-y-2.5">
                  {contras.map((contra: string) => (
                    <li class="flex items-start gap-2.5 text-[15px] text-neutral-800 leading-snug">
                      <span class="text-clay-600 font-bold shrink-0" aria-hidden="true">−</span>
                      <span>{contra}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )}

        {/* Precio + Dónde comprarlo (CTA demoure a outline) */}
        <div class="mb-3 pt-6 border-t border-neutral-900 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6">
          <div class="flex items-baseline gap-3">
            {noDisponible ? (
              <span class="text-xl lg:text-2xl font-black text-amber-700 tracking-tight">
                No disponible ahora
              </span>
            ) : (
              <span
                class="text-4xl font-bold text-neutral-900 tracking-tight tabular-nums"
                >{precio || "Consultar"}</span
              >
            )}
            {
              precioOriginal && (
                <div class="flex flex-col">
                  <s class="text-sm text-neutral-500">{precioOriginal}</s>
                  {descuentoPct && (
                    <span class="text-xs font-semibold text-clay-600">−{descuentoPct} %</span>
                  )}
                </div>
              )
            }
          </div>

          <a
            href={outboundUrl}
            target="_blank"
            rel="sponsored nofollow noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 bg-[#FF9900] text-neutral-950 hover:bg-[#F08C00] font-bold text-base transition-colors"
          >
            Ver precio en Amazon
            <ArrowRight size={18} />
          </a>
        </div>
        {noDisponible && (
          <p class="text-xs text-neutral-500 leading-relaxed mb-1 max-w-md">
            Amazon.es no lo tiene disponible{precioFecha && <> (comprobado el <time datetime={precioFecha}>{formatFechaPrecio(precioFecha)}</time>)</>}. Puede volver; mientras tanto, mira las alternativas de abajo.
          </p>
        )}
        {precio && precioFecha && (
          <p class="text-xs text-neutral-500 leading-relaxed mb-1 max-w-md">
            Precio en Amazon.es consultado el{" "}
            <time datetime={precioFecha}>{formatFechaPrecio(precioFecha)}</time>.
            Puede haber cambiado: el precio final es el que veas en Amazon.
          </p>
        )}
        <p class="text-xs text-neutral-400 leading-relaxed mb-10 max-w-md">
          Te llevamos a Amazon. Solución Canina no vende directamente:
          ganamos una pequeña comisión si decides comprar allí. Eso no
          condiciona qué entra en nuestro catálogo.
        </p>

      </div>
    </div>

    {
      categoria === "Camas ortopédicas" && (
        <section class="mt-16" id="medir-talla-cama">
          <a
            href="/calculadora-talla-cama-ortopedica-perros/"
            class="group flex flex-col sm:flex-row sm:items-center gap-5 bg-navy-800 text-white px-6 py-7 md:px-10"
          >
            <div class="flex-grow">
              <h2 class="font-serif text-2xl md:text-3xl font-semibold text-white leading-snug group-hover:underline decoration-1 underline-offset-4">
                Cómo medir a tu perro para esta cama
              </h2>
              <p class="text-[15px] text-white/70 mt-2 max-w-2xl leading-relaxed">
                Mide de hocico a cola, suma 30 cm y compara con las medidas de esta ficha. La
                calculadora te da la talla (largo y ancho) y el grosor de espuma.
              </p>
            </div>
            <span class="shrink-0 inline-flex items-center gap-2 self-start sm:self-auto px-6 py-3.5 bg-paper text-neutral-900 text-sm font-semibold group-hover:bg-white transition-colors">
              Abrir calculadora
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>
        </section>
      )
    }

    {
      (categoria === "Correas" || categoria === "Arneses") && (
        <section class="mt-16" id="medir-talla-arnes">
          <a
            href="/calculadora-talla-arnes-collar-perros/"
            class="group flex flex-col sm:flex-row sm:items-center gap-5 bg-navy-800 text-white px-6 py-7 md:px-10"
          >
            <div class="flex-grow">
              <h2 class="font-serif text-2xl md:text-3xl font-semibold text-white leading-snug group-hover:underline decoration-1 underline-offset-4">
                Cómo medir a tu perro para arnés o collar
              </h2>
              <p class="text-[15px] text-white/70 mt-2 max-w-2xl leading-relaxed">
                Perímetro de cuello y de pecho, más el peso para comprobar. Compara la talla con las
                medidas de esta ficha antes de pedir.
              </p>
            </div>
            <span class="shrink-0 inline-flex items-center gap-2 self-start sm:self-auto px-6 py-3.5 bg-paper text-neutral-900 text-sm font-semibold group-hover:bg-white transition-colors">
              Abrir calculadora
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>
        </section>
      )
    }

    {
      articulo.data.tallasPanal && (
        <section class="mt-16" id="tallas-panal">
          <h2 class="font-serif text-2xl md:text-3xl font-semibold text-neutral-900 mb-4">Tallas por cintura</h2>
          <div class="table-scroll">
            <table class="w-full max-w-xl text-sm border-collapse">
              <thead>
                <tr class="border-b-2 border-neutral-200 text-left">
                  <th class="py-2 pr-4">Talla</th>
                  <th class="py-2 pr-4">Cintura</th>
                  {articulo.data.tallasPanal.tallas.some((t) => pesoTalla(t)) && <th class="py-2">Peso</th>}
                </tr>
              </thead>
              <tbody class="text-neutral-700">
                {articulo.data.tallasPanal.tallas.map((t) => (
                  <tr class="border-b border-neutral-100">
                    <td class="py-2 pr-4 font-semibold">{t.talla}</td>
                    <td class="py-2 pr-4">{t.min}–{t.max} cm{t.deducida && ' *'}</td>
                    {articulo.data.tallasPanal?.tallas.some((x) => pesoTalla(x)) && <td class="py-2">{pesoTalla(t)}</td>}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="mt-2 text-xs text-neutral-500">
            Medidas de la marca. Cintura justo delante de las patas traseras; en Amazon se elige la talla en el desplegable.
            {articulo.data.tallasPanal.tallas.some((t) => t.deducida) && ' * La marca no la publica en texto: la deducimos de las tallas vecinas; confírmala en su tabla.'}
          </p>
          <a
            href="/calculadora-talla-panal-perros/"
            class="group mt-6 flex flex-col sm:flex-row sm:items-center gap-5 bg-navy-800 text-white px-6 py-7 md:px-10"
          >
            <div class="flex-grow">
              <p class="font-serif text-2xl md:text-3xl font-semibold text-white leading-snug group-hover:underline decoration-1 underline-offset-4">
                ¿Qué talla le pido?
              </p>
              <p class="text-[15px] text-white/70 mt-2 max-w-2xl leading-relaxed">
                Con la cintura de tu perro, la calculadora te dice la talla de este pañal y de los demás de la
                sección, desechables o lavables.
              </p>
            </div>
            <span class="shrink-0 inline-flex items-center gap-2 self-start sm:self-auto px-6 py-3.5 bg-paper text-neutral-900 text-sm font-semibold group-hover:bg-white transition-colors">
              Abrir calculadora
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>
        </section>
      )
    }

    {
      categoria === "Omega-3 y aceite de salmón" && (
        <section class="mt-16" id="calcular-omega-3">
          <a
            href="/calculadora-dosis-omega-3-perros/"
            class="group flex flex-col sm:flex-row sm:items-center gap-5 bg-navy-800 text-white px-6 py-7 md:px-10"
          >
            <div class="flex-grow">
              <h2 class="font-serif text-2xl md:text-3xl font-semibold text-white leading-snug group-hover:underline decoration-1 underline-offset-4">
                ¿Cuánto le doy al día?
              </h2>
              <p class="text-[15px] text-white/70 mt-2 max-w-2xl leading-relaxed">
                Con el peso de tu perro y el % de EPA+DHA de este producto, la calculadora te dice cuántos ml
                hacen falta para la dosis estudiada en artrosis y cuántas calorías suma.
              </p>
            </div>
            <span class="shrink-0 inline-flex items-center gap-2 self-start sm:self-auto px-6 py-3.5 bg-paper text-neutral-900 text-sm font-semibold group-hover:bg-white transition-colors">
              Abrir calculadora
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>
        </section>
      )
    }

    {
      esPiensoRenal && (
        <section class="mt-16" id="racion-pienso-renal">
          <a
            href="/calculadora-racion-pienso-renal-perros/"
            class="group flex flex-col sm:flex-row sm:items-center gap-5 bg-navy-800 text-white px-6 py-7 md:px-10"
          >
            <div class="flex-grow">
              <h2 class="font-serif text-2xl md:text-3xl font-semibold text-white leading-snug group-hover:underline decoration-1 underline-offset-4">
                Ración orientativa de este pienso renal
              </h2>
              <p class="text-[15px] text-white/70 mt-2 max-w-2xl leading-relaxed">
                Gramos diarios según peso y actividad. La pauta la marca el veterinario: la
                calculadora solo orienta la cantidad, nunca si este pienso es el adecuado.
              </p>
            </div>
            <span class="shrink-0 inline-flex items-center gap-2 self-start sm:self-auto px-6 py-3.5 bg-paper text-neutral-900 text-sm font-semibold group-hover:bg-white transition-colors">
              Abrir calculadora
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>
        </section>
      )
    }

    {/* Análisis largo + guías relacionadas al lado */}
    {(analisisResto.length > 0 || experienciaReal || (!analisis && descripcion) || relatedBlogs.length > 0) && (
      <div class="mt-16 pt-10 border-t border-neutral-900 grid lg:grid-cols-12 gap-10 lg:gap-16">
        <div class="lg:col-span-7 min-w-0">
          {analisisResto.length > 0 && (
            <section class="mb-12">
              <h2 class="font-serif text-3xl md:text-[2.2rem] font-semibold tracking-tight text-neutral-900 mb-5">
                Cómo funciona y para qué destaca
              </h2>
              <div class="prose max-w-none">
                {analisisResto.map((paragraph: string) => <p>{paragraph}</p>)}
              </div>
            </section>
          )}

          {experienciaReal && (
            <section>
              <h2 class="font-serif text-3xl md:text-[2.2rem] font-semibold tracking-tight text-neutral-900 mb-5">
                Qué dicen los dueños
              </h2>
              <div class="prose max-w-none">
                {experienciaReal.split("\n\n").map((paragraph: string) => <p>{paragraph}</p>)}
              </div>
            </section>
          )}

          {!analisis && !experienciaReal && descripcion && (
            <p class="font-serif text-xl leading-relaxed text-neutral-800">{descripcion}</p>
          )}
        </div>

        {relatedBlogs.length > 0 && (
          <aside class="lg:col-span-5 xl:col-span-4 xl:col-start-9">
            <div class="lg:sticky lg:top-32">
              <h2 class="font-sans text-sm font-bold text-neutral-900 pb-2 border-b-2 border-neutral-900">
                Guías relacionadas
              </h2>
              <ul>
                {relatedBlogs.map((b) => (
                  <li class="border-b border-neutral-300">
                    <a href={`/blog/${b.slug}/`} class="block py-4 font-serif text-lg leading-snug font-medium text-neutral-900 hover:underline decoration-1 underline-offset-4">
                      {b.titulo}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )}
      </div>
    )}

    {related && related.length > 0 && (
      <section class="mt-16 md:mt-20">
        <div class="section-rule flex flex-wrap items-baseline justify-between gap-3 mb-8">
          <h2 class="font-serif text-3xl md:text-[2.4rem] font-semibold tracking-tight text-neutral-900">Alternativas</h2>
          <a href={categoria ? `/categoria/${slugify(categoria)}/` : "/productos/"} class="text-[15px] font-semibold text-primary-700 hover:underline underline-offset-4">
            Ver toda la categoría →
          </a>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-x-6 gap-y-10">
          {related.slice(0, 6).map((r) => (
            <ProductCard
              slug={r.slug}
              nombre={r.nombre}
              imagen={r.imagen}
              precio={r.precio}
              precioOriginal={r.precioOriginal}
              descuentoPct={r.descuentoPct}
              marca={r.marca}
              valoracion={r.valoracion}
              valoracionesCount={r.valoracionesCount}
            />
          ))}
        </div>
        {notaRelated && <p class="mt-6 text-xs text-neutral-500">{notaRelated}</p>}
      </section>
    )}
  </article>

  {/* Sticky Bar (siempre visible en todas las pantallas) */}
  <div
    class="fixed bottom-0 left-0 right-0 bg-paper border-t border-neutral-900 z-50"
  >
    <div class="wrap py-3 flex items-center justify-between gap-4">
      <div class="flex items-center gap-4 min-w-0">
        {imagen && (
          <div class="hidden sm:flex items-center justify-center w-12 h-12 bg-neutral-50 overflow-hidden shrink-0">
            <img src={imagen} alt={displayName} class="max-w-full max-h-full object-contain mix-blend-multiply" loading="lazy" />
          </div>
        )}
        <div class="flex flex-col min-w-0">
          <span class="hidden sm:block text-sm font-bold text-neutral-900 truncate pr-4">{displayName}</span>
          <div class="flex items-baseline gap-2 mt-0.5">
            <span class="text-lg sm:text-xl font-bold text-neutral-900 leading-none tabular-nums">{noDisponible ? "No disponible" : precio || "Consultar"}</span>
            {precioOriginal && <s class="hidden sm:inline-block text-xs text-neutral-400">{precioOriginal}</s>}
          </div>
          {precio && precioFecha && (
            <span class="text-[10px] text-neutral-400 leading-tight mt-0.5">
              Amazon.es · {formatFechaPrecio(precioFecha)}
            </span>
          )}
        </div>
      </div>
      
      <a
        href={outboundUrl}
        target="_blank"
        rel="sponsored nofollow noopener noreferrer"
        class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-6 sm:px-8 py-3 bg-[#FF9900] text-neutral-950 hover:bg-[#F08C00] font-bold text-[15px] sm:text-base transition-colors"
      >
        Ver precio
        <ArrowRight size={18} className="hidden sm:block" />
      </a>
    </div>
  </div>
</Layout>
