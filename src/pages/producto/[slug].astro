---
import Layout from "../../layouts/Layout.astro";
import TipoAnalisisBadge from "../../components/TipoAnalisisBadge.astro";
import { getCollection } from "astro:content";
import { CheckCircle2, XCircle, ArrowRight, ShieldCheck } from "lucide-react";
import { slugify } from "../../utils/slugify";
import { outboundProductUrl } from "../../utils/outbound";
import { productSchema, breadcrumbSchema } from "../../utils/seo";
import { blogsForCategory } from "../../utils/blogProductLinks";
import { TIPO_ANALISIS_DEFAULT, tipoAnalisisHref } from "../../utils/tipoAnalisis";

export async function getStaticPaths() {
  const articulos = await getCollection("articulos");

  const categories = Array.from(
    new Set(articulos.map((a) => a.data.categoria).filter(Boolean) as string[]),
  );

  return articulos.map((art) => {
    const slug = art.data.slug || slugify(art.data.nombre);
    const related = articulos
      .filter(
        (a) =>
          a.data.categoria &&
          a.data.categoria === art.data.categoria &&
          (a.data.slug || slugify(a.data.nombre)) !== slug,
      )
      .slice(0, 8)
      .map((a) => ({
        slug: a.data.slug || slugify(a.data.nombre),
        nombre: a.data.nombreCorto || a.data.nombre,
        imagen: a.data.imagen,
        precio: a.data.precio,
        marca: a.data.marca,
        outboundUrl: outboundProductUrl(a.data.slug || slugify(a.data.nombre)),
      }));
    return {
      params: { slug },
      props: { articulo: art, categories, related },
    };
  });
}

const { articulo, categories, related } = Astro.props;
const {
  nombre,
  nombreCorto,
  descripcion,
  imagen,
  precio,
  precioOriginal,
  descuentoPct,
  linkAmazon,
  categoria,
  marca,
  veredicto,
  analisis,
  experienciaReal,
  pros,
  contras,
  paraQuien,
  tipoAnalisis,
  valoracion,
  valoracionesCount,
  ventas,
} = articulo.data;

function fmtCount(n) {
  if (!n || n <= 0) return null;
  if (n >= 1000) {
    const k = (n / 1000).toFixed(1);
    return (k.endsWith(".0") ? k.slice(0, -2) : k) + "k";
  }
  return n.toLocaleString("es-ES");
}

function fmtVentas(n) {
  if (!n || n <= 0) return null;
  if (n >= 1000) {
    const k = (n / 1000).toFixed(1);
    return (k.endsWith(".0") ? k.slice(0, -2) : k) + " mil";
  }
  return n.toLocaleString("es-ES");
}

const hasRating = typeof valoracion === "number" && valoracion >= 3.7;
const ratingCountTxt = fmtCount(valoracionesCount);
const ventasTxt = fmtVentas(ventas);

const displayName = nombreCorto || nombre;
const isPendiente = (tipoAnalisis ?? TIPO_ANALISIS_DEFAULT) === "Pendiente";
const productSlug = articulo.data.slug || slugify(nombre);
const productUrl = `/producto/${productSlug}/`;
const outboundUrl = outboundProductUrl(productSlug);
const categoriaSlug = categoria ? slugify(categoria) : null;

const productJsonLd = productSchema({
  name: displayName,
  description: descripcion,
  image: imagen,
  brand: marca,
  sku: productSlug,
  url: productUrl,
  price: precio,
  priceOriginal: precioOriginal,
  category: categoria,
  rating:
    typeof valoracion === "number" && valoracion > 0 ? valoracion : undefined,
  ratingCount:
    typeof valoracionesCount === "number" && valoracionesCount > 0
      ? valoracionesCount
      : undefined,
  pros,
  cons: contras,
  reviewBody: veredicto,
});

const breadcrumbItems = [{ name: "Inicio", url: "/" }];
if (categoria && categoriaSlug) {
  breadcrumbItems.push({ name: categoria, url: `/categoria/${categoriaSlug}/` });
}
breadcrumbItems.push({ name: displayName, url: productUrl });
const breadcrumbJsonLd = breadcrumbSchema(breadcrumbItems);

const seoDescription =
  articulo.data.descripcionSeo ||
  descripcion ||
  veredicto ||
  `Reseña detallada de ${displayName}${marca ? " de " + marca : ""} en Solución Canina.`;

const pageTitle = `${displayName} · análisis y precio`;

const relatedBlogs = blogsForCategory(categoria);
---

<Layout
  title={pageTitle}
  description={seoDescription}
  image={imagen}
  type="product"
  jsonLd={[productJsonLd, breadcrumbJsonLd]}
  categories={categories}
>
  <article class="max-w-6xl mx-auto px-4 md:px-0">
    {/* Breadcrumbs */}
    <nav
      aria-label="Breadcrumb"
      class="flex mb-6 text-[10px] font-bold uppercase tracking-widest text-neutral-400 gap-2 items-center flex-wrap"
    >
      <a href="/" class="hover:text-primary-600 transition-colors">Inicio</a>
      <span class="text-neutral-300">/</span>
      {
        categoria && (
          <>
            <a
              href={`/categoria/${slugify(categoria)}/`}
              class="hover:text-primary-600 transition-colors"
            >
              {categoria}
            </a>
            <span class="text-neutral-300">/</span>
          </>
        )
      }
      <span
        class="text-neutral-900 truncate max-w-[150px] sm:max-w-none hidden sm:inline-block font-bold"
        aria-current="page"
        >{displayName}</span
      >
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 xl:gap-16 items-start">
      {/* Columna Izquierda: Galería/Imagen */}
      <div class="lg:col-span-5 space-y-6">
        <div
          class="group relative rounded-[2rem] border border-neutral-100/60 bg-gradient-to-br from-white via-white to-neutral-50 p-8 md:p-12 flex items-center justify-center min-h-[300px] md:min-h-[400px] shadow-xl shadow-neutral-200/40 overflow-hidden"
        >
          <div
            class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(60,158,145,0.03),transparent)] opacity-0 group-hover:opacity-100 transition-opacity"
          >
          </div>

          {
            descuentoPct && descuentoPct > 0 && (
              <div class="absolute top-6 left-6 z-10">
                <span class="bg-red-500 text-white text-[11px] font-black px-3 py-1.5 rounded-full shadow-lg shadow-red-500/20 uppercase tracking-wider">
                  -{descuentoPct}% Dto.
                </span>
              </div>
            )
          }

          {
            imagen ? (
              <img
                src={imagen}
                alt={`Comprar ${displayName} al mejor precio`}
                title={`${displayName}${marca ? ` - ${marca}` : ""}`}
                width="600"
                height="600"
                loading="eager"
                decoding="async"
                fetchpriority="high"
                class="max-w-full max-h-[450px] object-contain mix-blend-multiply transition-transform duration-700 group-hover:scale-105"
              />
            ) : (
              <div class="text-neutral-200">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="80"
                  height="80"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <>
                    <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
                    <circle cx="9" cy="9" r="2" />
                    <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
                  </>
                </svg>
              </div>
            )
          }

        </div>

        {/* Veredicto Editorial (Destacado) */}
        {
          veredicto && (
            <div class="bg-white border border-primary-100 rounded-2xl p-6 relative overflow-hidden shadow-sm group">
              <div class="absolute top-0 left-0 w-1.5 h-full bg-gradient-to-b from-primary-400 to-primary-600" />
              <div class="flex items-center gap-2 mb-3 text-primary-700">
                <div class="p-1.5 bg-primary-50 rounded-lg">
                  <ShieldCheck size={18} />
                </div>
                <h3 class="text-[11px] font-black uppercase tracking-widest">
                  Recomendación Solución Canina
                </h3>
              </div>
              <p class="text-neutral-800 font-medium text-[15px] leading-relaxed italic">
                "{veredicto}"
              </p>
            </div>
          )
        }
      </div>

      {/* Columna Derecha: Info Principal */}
      <div class="lg:col-span-7 min-w-0">
        <div class="flex flex-wrap items-center gap-3 mb-6">
          {
            marca && (
              <span class="px-4 py-1.5 bg-navy-700 text-white rounded-lg text-[11px] font-black uppercase tracking-[0.1em] shadow-sm shadow-navy-900/10">
                {marca}
              </span>
            )
          }
          {
            categoria && (
              <span class="px-4 py-1.5 bg-primary-50 text-primary-700 rounded-lg text-[11px] font-black uppercase tracking-[0.1em] border border-primary-100">
                {categoria}
              </span>
            )
          }
          <TipoAnalisisBadge tipo={tipoAnalisis ?? TIPO_ANALISIS_DEFAULT} />
        </div>

        <h1
          class="text-2xl sm:text-3xl lg:text-4xl font-sans font-black text-neutral-900 mb-2 leading-tight tracking-tight break-words [hyphens:auto]"
          lang="es"
        >
          {displayName}
        </h1>

        {
          isPendiente && (
            <div
              class="mb-6 rounded-2xl border border-amber-200 bg-amber-50 p-4"
              role="status"
            >
              <p class="text-[10px] font-black uppercase tracking-widest text-amber-800 mb-1">
                Análisis pendiente
              </p>
              <p class="text-sm text-amber-950/80 leading-relaxed">
                Aún no hemos analizado esta ficha a fondo. Los datos que ves
                (medidas, materiales, capacidad) salen de la ficha del
                fabricante, no de un veredicto nuestro.{" "}
                <a
                  href={tipoAnalisisHref("Pendiente")}
                  class="font-bold text-amber-900 underline decoration-amber-400 underline-offset-2 hover:text-amber-950"
                >
                  Qué significa Pendiente
                </a>
              </p>
            </div>
          )
        }

        <div class="mb-6">
          <p class="text-[10px] font-black uppercase tracking-widest text-neutral-400 mb-1">
            Nombre en Amazon
          </p>
          <p class="text-sm text-neutral-500 leading-snug">{nombre}</p>
        </div>

        {/* Valoración + Social Proof */}
        {
          (hasRating || ventasTxt) && (
            <div class="flex flex-wrap items-center gap-x-8 gap-y-4 mb-6">
              {hasRating && (
                <div class="flex items-center gap-3 bg-white px-3 py-1.5 rounded-2xl border border-neutral-100 shadow-sm hover:shadow-md transition-shadow">
                  <div class="flex items-center gap-1">
                    {[...Array(5)].map((_, i) => (
                      <svg
                        viewBox="0 0 24 24"
                        class={`h-3.5 w-3.5 ${i < Math.floor(valoracion || 0) ? "text-yellow-400" : "text-neutral-200"}`}
                        fill="currentColor"
                      >
                        <polygon points="12,2 14.94,8.96 22.5,9.56 16.74,14.62 18.49,22 12,17.93 5.51,22 7.26,14.62 1.5,9.56 9.06,8.96" />
                      </svg>
                    ))}
                  </div>
                  <span class="text-base font-black text-neutral-900 tabular-nums">
                    {(valoracion ?? 0).toFixed(1)}
                  </span>
                  {ratingCountTxt && (
                    <span class="text-[10px] font-bold text-neutral-400 border-l border-neutral-200 pl-3">
                      {ratingCountTxt} reseñas
                    </span>
                  )}
                </div>
              )}

              {ventasTxt && (
                <div class="flex items-center gap-2 text-sm">
                  <span class="flex h-2 w-2 rounded-full bg-green-500 animate-pulse" />
                  <span class="font-bold text-neutral-700 uppercase tracking-tight text-[10px]">
                    {ventasTxt}+ comprados este mes
                  </span>
                </div>
              )}
            </div>
          )
        }

        {
          analisis && (
            <div class="mb-6 border-l-2 border-primary-200 pl-4">
              <p class="text-[10px] font-black uppercase tracking-widest text-primary-600 mb-2">
                Por qué lo hemos analizado
              </p>
              <p class="text-neutral-700 text-base leading-relaxed">
                {analisis.split("\n\n")[0]}
              </p>
            </div>
          )
        }

        {/* Para qué tipo de perro está pensado */}
        {paraQuien && (
          <div class="mb-6 bg-neutral-50 border border-neutral-200 rounded-2xl p-5">
            <p class="text-[10px] font-black uppercase tracking-widest text-neutral-500 mb-2">
              Para qué tipo de perro está pensado
            </p>
            <p class="text-neutral-700 text-sm leading-relaxed">
              {paraQuien}
            </p>
          </div>
        )}

        {/* Pros y Contras (movidos arriba del precio) */}
        {((pros && pros.length > 0) || (contras && contras.length > 0)) && (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
            {pros && pros.length > 0 && (
              <div class="bg-gradient-to-b from-emerald-50/50 to-white border border-emerald-100/80 rounded-2xl p-6 shadow-sm">
                <h4 class="text-[10px] font-black uppercase tracking-widest text-emerald-800 mb-3">
                  A favor
                </h4>
                <ul class="space-y-2">
                  {pros.map((pro: string) => (
                    <li class="flex items-start gap-2 text-sm text-neutral-700 leading-snug">
                      <CheckCircle2 size={14} className="text-emerald-500 mt-0.5 shrink-0" />
                      <span>{pro}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {contras && contras.length > 0 && (
              <div class="bg-gradient-to-b from-rose-50/50 to-white border border-rose-100/80 rounded-2xl p-6 shadow-sm">
                <h4 class="text-[10px] font-black uppercase tracking-widest text-rose-800 mb-3">
                  A tener en cuenta
                </h4>
                <ul class="space-y-2">
                  {contras.map((contra: string) => (
                    <li class="flex items-start gap-2 text-sm text-neutral-700 leading-snug">
                      <XCircle size={14} className="text-rose-400 mt-0.5 shrink-0" />
                      <span>{contra}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )}

        {/* Precio + Dónde comprarlo (CTA demoure a outline) */}
        <div class="mb-3 flex flex-col sm:flex-row sm:items-end gap-4 sm:gap-6">
          <div class="flex items-baseline gap-3">
            <span
              class="text-3xl lg:text-4xl font-black text-neutral-900 tracking-tighter"
              >{precio || "Consultar"}</span
            >
            {
              precioOriginal && (
                <div class="flex flex-col">
                  <span class="text-base text-neutral-300 line-through font-bold decoration-red-500/20">
                    {precioOriginal}
                  </span>
                  {descuentoPct && (
                    <span class="text-[10px] font-black text-red-600 uppercase">
                      Ahorra -{descuentoPct}%
                    </span>
                  )}
                </div>
              )
            }
          </div>

          <a
            href={outboundUrl}
            target="_blank"
            rel="sponsored nofollow noopener noreferrer"
            class="group w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 sm:px-10 py-4 sm:py-5 bg-[#FF9900] text-neutral-950 hover:bg-[#FFa822] shadow-[0_8px_30px_rgba(255,153,0,0.35)] hover:shadow-[0_12px_40px_rgba(255,153,0,0.55)] font-black text-lg sm:text-xl rounded-2xl transition-all duration-300 hover:-translate-y-1"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="animate-[bounce_2s_infinite]"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
            VER PRECIO EN AMAZON
            <ArrowRight
              size={22}
              className="transition-transform group-hover:translate-x-2"
            />
          </a>
        </div>
        <p class="text-xs text-neutral-400 leading-relaxed mb-8 max-w-md">
          Te llevamos a Amazon. Solución Canina no vende directamente —
          ganamos una pequeña comisión si decides comprar allí. Eso no
          condiciona qué entra en nuestro catálogo.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
          <div
            class="flex items-center gap-3 p-4 rounded-2xl bg-neutral-50 border border-neutral-100"
          >
            <div
              class="h-10 w-10 flex items-center justify-center rounded-xl bg-white shadow-sm"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                class="text-primary-600"
                ><path d="M22 10v6M2 10v6"></path><path d="M6 12h12"
                ></path><path d="M12 4v16"></path><path d="M15 8l-3-3-3 3"
                ></path><path d="M15 16l-3 3-3-3"></path></svg
              >
            </div>
            <div>
              <span
                class="block text-[10px] font-black uppercase tracking-widest text-neutral-400"
                >Envío</span
              >
              <span class="text-sm font-bold text-neutral-700"
                >Entrega según disponibilidad</span
              >
            </div>
          </div>
          <div
            class="flex items-center gap-3 p-4 rounded-2xl bg-neutral-50 border border-neutral-100"
          >
            <div
              class="h-10 w-10 flex items-center justify-center rounded-xl bg-white shadow-sm"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                class="text-primary-600"
                ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                ></path><path d="m9 12 2 2 4-4"></path></svg
              >
            </div>
            <div>
              <span
                class="block text-[10px] font-black uppercase tracking-widest text-neutral-400"
                >Garantía</span
              >
              <span class="text-sm font-bold text-neutral-700"
                >Compra 100% segura</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>

    {
      categoria === "Camas ortopédicas" && (
        <section class="mt-12" id="medir-talla-cama">
          <a
            href="/calculadora-talla-cama-ortopedica-perros/"
            class="group flex flex-col sm:flex-row sm:items-center gap-5 rounded-2xl border border-primary-200 bg-gradient-to-r from-primary-50 to-white p-6 md:p-8 hover:border-primary-300 hover:shadow-md transition-all"
          >
            <div class="shrink-0 flex h-14 w-14 items-center justify-center rounded-xl bg-primary-600 text-white shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/></svg>
            </div>
            <div class="flex-grow">
              <p class="text-xs font-bold uppercase tracking-wide text-primary-600 mb-1">
                Herramienta gratis
              </p>
              <h2 class="text-xl md:text-2xl font-serif font-black text-neutral-900 leading-snug">
                Cómo medir a tu perro para esta cama
              </h2>
              <p class="text-sm text-neutral-600 mt-1 max-w-xl">
                Mide de hocico a cola, suma 30 cm y compara con las medidas de esta ficha. La
                calculadora te da la talla (largo y ancho) y el grosor de espuma.
              </p>
            </div>
            <span class="shrink-0 inline-flex items-center gap-2 self-start sm:self-auto px-5 py-3 bg-primary-600 text-white text-sm font-bold rounded-lg group-hover:bg-primary-700 transition-colors">
              Abrir calculadora
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>
        </section>
      )
    }

    {/* Sección de Análisis Detallado */}
    {(analisis || experienciaReal) && (
      <div class="mt-12 border-t border-neutral-100 pt-12 max-w-4xl">
        <div
          class="inline-flex items-center gap-2 mb-8 px-4 py-1.5 bg-neutral-900 text-white rounded-full shadow-lg shadow-neutral-900/10"
        >
          <span class="w-2 h-2 rounded-full bg-primary-400 animate-pulse"></span>
          <span class="text-[10px] font-black uppercase tracking-widest">
            Análisis del Equipo
          </span>
        </div>

        {analisis && (
          <section class="mb-10">
            <h2 class="text-xl md:text-2xl font-sans font-black text-neutral-900 mb-4 tracking-tight">
              Cómo funciona y para qué destaca
            </h2>
            <div class="prose prose-neutral prose-p:leading-[1.9] prose-p:text-neutral-600 prose-p:text-[16px] md:prose-p:text-[17px] prose-a:text-primary-600 max-w-none">
              {analisis.split("\n\n").map((paragraph: string) => (
                <p class="mb-5">{paragraph}</p>
              ))}
            </div>
          </section>
        )}

        {experienciaReal && (
          <section>
            <h2 class="text-xl md:text-2xl font-sans font-black text-neutral-900 mb-4 tracking-tight">
              Qué dicen los dueños
            </h2>
            <div class="prose prose-neutral prose-p:leading-[1.9] prose-p:text-neutral-600 prose-p:text-[16px] md:prose-p:text-[17px] prose-a:text-primary-600 max-w-none">
              {experienciaReal.split("\n\n").map((paragraph: string) => (
                <p class="mb-5">{paragraph}</p>
              ))}
            </div>
          </section>
        )}

        {!analisis && !experienciaReal && descripcion && (
          <p class="text-neutral-600 leading-relaxed">{descripcion}</p>
        )}
      </div>
    )}

    {
      relatedBlogs.length > 0 && (
        <section class="mt-16 pt-10 border-t border-neutral-100">
          <p class="text-[10px] font-black uppercase tracking-widest text-primary-600 mb-2">
            Lee también
          </p>
          <h2 class="text-2xl md:text-3xl font-serif font-black text-neutral-900 tracking-tight mb-6">
            Guías relacionadas
          </h2>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {relatedBlogs.map((b) => (
              <li>
                <a
                  href={`/blog/${b.slug}/`}
                  class="group flex items-center gap-3 p-4 rounded-2xl border border-neutral-100 hover:border-primary-200 hover:bg-primary-50/30 transition-colors"
                >
                  <span class="text-primary-600 shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
                  </span>
                  <span class="text-sm font-bold text-neutral-800 group-hover:text-primary-700 leading-snug">
                    {b.titulo}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      related && related.length > 0 && (
        <section class="mt-20 pt-12 border-t border-neutral-100 relative overflow-hidden">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
            <div>
              <p class="text-[10px] font-black uppercase tracking-widest text-primary-600 mb-2">
                Más opciones
              </p>
              <h2 class="text-3xl md:text-4xl font-serif font-black text-neutral-900 tracking-tight leading-none">
                También te puede <br class="sm:hidden" /> interesar
              </h2>
            </div>
            <a
              href="/productos/"
              class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-widest text-neutral-400 hover:text-primary-600 transition-colors whitespace-nowrap"
            >
              Ver catálogo completo
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <>
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </>
              </svg>
            </a>
          </div>

          <div class="flex gap-5 overflow-x-auto pb-12 scrollbar-none snap-x snap-mandatory -mx-4 px-4 sm:mx-0 sm:px-0">
            {related.map((r) => (
              <div class="min-w-[260px] sm:min-w-[280px] snap-start">
                <div
                  class="group flex flex-col h-full bg-white border border-neutral-100 rounded-[32px] p-5 hover:shadow-2xl hover:shadow-neutral-200/50 transition-all duration-500 hover:-translate-y-1"
                >
                  <a href={`/producto/${r.slug}/`} class="block mb-6">
                    <div class="aspect-square flex items-center justify-center bg-neutral-50 rounded-2xl overflow-hidden relative group-hover:bg-white transition-colors">
                      {r.imagen ? (
                        <img
                          src={r.imagen}
                          alt={r.nombre}
                          width="300"
                          height="300"
                          loading="lazy"
                          decoding="async"
                          class="max-w-[70%] max-h-[70%] object-contain mix-blend-multiply group-hover:scale-110 transition-transform duration-500"
                        />
                      ) : null}
                    </div>
                  </a>

                  <div class="flex-grow flex flex-col">
                    <div class="mb-4">
                      {r.marca && (
                        <span class="block text-[9px] font-black uppercase tracking-[0.15em] text-neutral-400 mb-2">
                          {r.marca}
                        </span>
                      )}
                      <a href={`/producto/${r.slug}/`} class="group/title">
                        <h3 class="text-sm font-bold text-neutral-900 leading-tight line-clamp-2 group-hover/title:text-primary-600 transition-colors">
                          {r.nombre}
                        </h3>
                      </a>
                    </div>

                    <div class="mt-auto space-y-4">
                      <div class="flex items-center justify-between">
                         <span class="text-lg font-black text-neutral-900">
                          {r.precio || "Consultar"}
                        </span>
                      </div>

                      <a
                        href={`/producto/${r.slug}/`}
                        class="flex items-center justify-center gap-2 w-full py-3 border border-primary-200 text-primary-700 bg-primary-50/50 hover:bg-primary-100 hover:border-primary-300 text-[11px] font-black rounded-2xl transition-all duration-300 hover:-translate-y-0.5"
                      >
                        Ver análisis
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }
  </article>

  {/* Sticky Bar (siempre visible en todas las pantallas) */}
  <div
    class="fixed bottom-0 left-0 right-0 bg-white/95 backdrop-blur-md border-t border-neutral-200 z-50 shadow-[0_-10px_40px_rgba(0,0,0,0.08)]"
  >
    <div class="max-w-6xl mx-auto px-4 md:px-0 py-3 sm:py-4 flex items-center justify-between gap-4">
      <div class="flex items-center gap-4 min-w-0">
        {imagen && (
          <div class="hidden sm:flex items-center justify-center w-12 h-12 bg-white rounded-lg border border-neutral-100 overflow-hidden shrink-0">
            <img src={imagen} alt={displayName} class="max-w-full max-h-full object-contain mix-blend-multiply" loading="lazy" />
          </div>
        )}
        <div class="flex flex-col min-w-0">
          <span class="hidden sm:block text-sm font-bold text-neutral-900 truncate pr-4">{displayName}</span>
          <div class="flex items-baseline gap-2 mt-0.5">
            <span class="text-lg sm:text-xl font-black text-neutral-900 leading-none">{precio || "Consultar"}</span>
            {precioOriginal && <span class="hidden sm:inline-block text-[11px] font-bold text-neutral-400 line-through decoration-red-500/30">{precioOriginal}</span>}
          </div>
        </div>
      </div>
      
      <a
        href={outboundUrl}
        target="_blank"
        rel="sponsored nofollow noopener noreferrer"
        class="group flex-1 sm:flex-none flex items-center justify-center gap-2 px-6 sm:px-8 py-3.5 sm:py-3 bg-[#FF9900] text-neutral-950 hover:bg-[#FFa822] shadow-[0_0_20px_rgba(255,153,0,0.4)] font-black text-[15px] sm:text-base rounded-xl transition-all hover:-translate-y-0.5"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="hidden sm:block"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
        Ver precio
        <ArrowRight size={18} className="hidden sm:block transition-transform group-hover:translate-x-1" />
      </a>
    </div>
  </div>
</Layout>
