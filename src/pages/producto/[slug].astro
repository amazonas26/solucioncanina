---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CheckCircle2, XCircle, ArrowRight, ShieldCheck } from 'lucide-react';
import { slugify } from '../../utils/slugify';

export async function getStaticPaths() {
  const articulos = await getCollection('articulos');
  
  // Extraemos las categorías para pasarlas al Layout
  const categories = Array.from(
    new Set(articulos.map((a) => a.data.categoria).filter(Boolean) as string[])
  );

  return articulos.map((art) => ({
    params: { slug: art.data.slug || slugify(art.data.nombre) },
    props: { articulo: art, categories },
  }));
}

const { articulo, categories } = Astro.props;
const {
  nombre,
  descripcion,
  imagen,
  precio,
  precioOriginal,
  descuentoPct,
  linkAmazon,
  categoria,
  marca,
  veredicto,
  analisis,
  pros,
  contras,
  paraQuien,
  valoracion,
  valoracionesCount,
  ventas
} = articulo.data;

function fmtCount(n) {
  if (!n || n <= 0) return null;
  if (n >= 1000) {
    const k = (n / 1000).toFixed(1);
    return (k.endsWith('.0') ? k.slice(0, -2) : k) + 'k';
  }
  return n.toLocaleString('es-ES');
}

function fmtVentas(n) {
  if (!n || n <= 0) return null;
  if (n >= 1000) {
    const k = (n / 1000).toFixed(1);
    return (k.endsWith('.0') ? k.slice(0, -2) : k) + ' mil';
  }
  return n.toLocaleString('es-ES');
}

const hasRating = typeof valoracion === 'number' && valoracion > 0;
const ratingCountTxt = fmtCount(valoracionesCount);
const ventasTxt = fmtVentas(ventas);
---

<Layout title={`${nombre} - Reseña Editorial`} description={descripcion} categories={categories}>
  <article class="max-w-6xl mx-auto">
    {/* Breadcrumbs */}
    <nav class="flex mb-6 text-xs font-medium text-neutral-400 gap-2 items-center flex-wrap">
      <a href="/" class="hover:text-primary-600 transition-colors">Inicio</a>
      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      {categoria && (
        <>
          <a href={`/categoria/${categoria.toLowerCase().replace(/ /g, '-')}`} class="hover:text-primary-600 transition-colors">{categoria}</a>
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </>
      )}
      <span class="text-neutral-900 truncate max-w-[200px] sm:max-w-xs">{nombre}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
      {/* Columna Izquierda: Imagen y Veredicto */}
      <div class="lg:col-span-4 space-y-6">
        <div class="relative rounded-2xl border border-neutral-200 bg-white p-6 md:p-10 flex items-center justify-center min-h-[300px] shadow-sm">
          {descuentoPct && descuentoPct > 0 && (
            <div class="absolute top-4 left-4 bg-red-500 text-white text-xs font-black px-2.5 py-1 rounded-md">
              -{descuentoPct}%
            </div>
          )}
          {imagen ? (
            <img src={imagen} alt={nombre} class="max-w-full max-h-[400px] object-contain mix-blend-multiply" />
          ) : (
            <div class="text-neutral-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
            </div>
          )}
        </div>

        {/* Veredicto Editorial (Si existe) */}
        {veredicto && (
          <div class="bg-primary-50 border border-primary-100 rounded-xl p-6 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-1.5 h-full bg-primary-500"></div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-primary-700 mb-3 flex items-center gap-2">
              <ShieldCheck size={16} className="text-primary-600" />
              Nuestro Veredicto
            </h3>
            <p class="text-primary-900 font-medium text-sm leading-relaxed">
              {veredicto}
            </p>
          </div>
        )}
      </div>

      {/* Columna Derecha: Título, CTA, y Análisis */}
      <div class="lg:col-span-8 min-w-0">
        {marca && (
          <span class="inline-block px-2.5 py-1 bg-neutral-100 text-neutral-600 rounded-md text-xs font-bold mb-4 uppercase tracking-wide">
            {marca}
          </span>
        )}
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-serif font-black text-neutral-900 mb-4 leading-[1.2] break-words [hyphens:auto]" lang="es">
          {nombre}
        </h1>

        {/* Valoración + Social Proof */}
        {(hasRating || ventasTxt) && (
          <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mb-6 text-sm">
            {hasRating && (
              <div
                class="flex items-center gap-1.5"
                aria-label={`Valoración ${(valoracion ?? 0).toFixed(1)} sobre 5${ratingCountTxt ? ` con ${valoracionesCount} reseñas` : ''}`}
              >
                <div
                  class="relative inline-flex"
                  style={`--rating-pct: ${((valoracion ?? 0) / 5) * 100}%`}
                >
                  {/* Capa gris (base) */}
                  <div class="flex items-center gap-0.5 text-neutral-200">
                    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><polygon points="12,2 14.94,8.96 22.5,9.56 16.74,14.62 18.49,22 12,17.93 5.51,22 7.26,14.62 1.5,9.56 9.06,8.96"></polygon></svg>
                    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><polygon points="12,2 14.94,8.96 22.5,9.56 16.74,14.62 18.49,22 12,17.93 5.51,22 7.26,14.62 1.5,9.56 9.06,8.96"></polygon></svg>
                    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><polygon points="12,2 14.94,8.96 22.5,9.56 16.74,14.62 18.49,22 12,17.93 5.51,22 7.26,14.62 1.5,9.56 9.06,8.96"></polygon></svg>
                    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><polygon points="12,2 14.94,8.96 22.5,9.56 16.74,14.62 18.49,22 12,17.93 5.51,22 7.26,14.62 1.5,9.56 9.06,8.96"></polygon></svg>
                    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><polygon points="12,2 14.94,8.96 22.5,9.56 16.74,14.62 18.49,22 12,17.93 5.51,22 7.26,14.62 1.5,9.56 9.06,8.96"></polygon></svg>
                  </div>
                  {/* Capa amarilla (overlay con ancho proporcional) */}
                  <div
                    class="absolute inset-0 flex items-center gap-0.5 text-yellow-400 overflow-hidden"
                    style="width: var(--rating-pct)"
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 24 24" class="h-5 w-5 flex-shrink-0" fill="currentColor"><polygon points="12,2 14.94,8.96 22.5,9.56 16.74,14.62 18.49,22 12,17.93 5.51,22 7.26,14.62 1.5,9.56 9.06,8.96"></polygon></svg>
                    <svg viewBox="0 0 24 24" class="h-5 w-5 flex-shrink-0" fill="currentColor"><polygon points="12,2 14.94,8.96 22.5,9.56 16.74,14.62 18.49,22 12,17.93 5.51,22 7.26,14.62 1.5,9.56 9.06,8.96"></polygon></svg>
                    <svg viewBox="0 0 24 24" class="h-5 w-5 flex-shrink-0" fill="currentColor"><polygon points="12,2 14.94,8.96 22.5,9.56 16.74,14.62 18.49,22 12,17.93 5.51,22 7.26,14.62 1.5,9.56 9.06,8.96"></polygon></svg>
                    <svg viewBox="0 0 24 24" class="h-5 w-5 flex-shrink-0" fill="currentColor"><polygon points="12,2 14.94,8.96 22.5,9.56 16.74,14.62 18.49,22 12,17.93 5.51,22 7.26,14.62 1.5,9.56 9.06,8.96"></polygon></svg>
                    <svg viewBox="0 0 24 24" class="h-5 w-5 flex-shrink-0" fill="currentColor"><polygon points="12,2 14.94,8.96 22.5,9.56 16.74,14.62 18.49,22 12,17.93 5.51,22 7.26,14.62 1.5,9.56 9.06,8.96"></polygon></svg>
                  </div>
                </div>
                <span class="font-bold text-neutral-900 tabular-nums ml-1">
                  {(valoracion ?? 0).toFixed(1)}
                </span>
                {ratingCountTxt && (
                  <span class="text-neutral-400 tabular-nums">
                    ({ratingCountTxt} reseñas)
                  </span>
                )}
              </div>
            )}

            {ventasTxt && (
              <div class="flex items-center gap-1.5 text-neutral-500">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M3 3v18h18" />
                  <path d="m19 9-5 5-4-4-3 3" />
                </svg>
                <span class="font-medium">
                  <span class="text-neutral-900 font-bold">{ventasTxt}+</span> comprados el último mes
                </span>
              </div>
            )}
          </div>
        )}

        <div class="flex items-center gap-4 mb-8">
          <div class="flex items-baseline gap-2">
            <span class="text-3xl font-black text-neutral-900">{precio || 'Consultar'}</span>
            {precioOriginal && (
              <span class="text-lg text-neutral-400 line-through font-medium">{precioOriginal}</span>
            )}
            {descuentoPct && descuentoPct > 0 && (
              <span class="ml-1 inline-flex items-center px-2 py-0.5 rounded-md bg-red-100 text-red-700 text-xs font-bold">
                -{descuentoPct}%
              </span>
            )}
          </div>
        </div>

        <div class="mb-10">
          {descuentoPct && descuentoPct > 10 && (
            <p class="mb-3 text-sm font-semibold text-red-700">
              Precio con -{descuentoPct}% de descuento &mdash; sujeto a disponibilidad.
            </p>
          )}
          {ventas && ventas > 300 && (!descuentoPct || descuentoPct <= 10) && (
            <p class="mb-3 text-sm text-neutral-500">
              <span class="font-semibold text-neutral-700">{fmtVentas(ventas)}+ comprados</span> el último mes en Amazon.
            </p>
          )}
          <a
            href={linkAmazon}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 px-8 py-4 bg-[#FF9900] hover:bg-[#E68A00] text-black font-bold text-base rounded-lg transition-colors whitespace-nowrap"
          >
            Ver precio en Amazon
            <ArrowRight size={18} />
          </a>
        </div>

        <hr class="border-neutral-100 mb-10" />

        {/* Pros y Contras */}
        {(pros && pros.length > 0) || (contras && contras.length > 0) ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-12">
            {pros && pros.length > 0 && (
              <div class="bg-green-50/50 border border-green-100 rounded-xl p-5">
                <h4 class="text-sm font-bold text-green-800 mb-4 flex items-center gap-2">
                  <CheckCircle2 size={16} className="text-green-600" />
                  Lo que nos gusta
                </h4>
                <ul class="space-y-3">
                  {pros.map((pro: string) => (
                    <li class="flex items-start gap-2.5 text-sm text-neutral-700 leading-relaxed">
                      <span class="text-green-500 mt-0.5 shrink-0">•</span>
                      {pro}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {contras && contras.length > 0 && (
              <div class="bg-red-50/50 border border-red-100 rounded-xl p-5">
                <h4 class="text-sm font-bold text-red-800 mb-4 flex items-center gap-2">
                  <XCircle size={16} className="text-red-500" />
                  Aspectos a mejorar
                </h4>
                <ul class="space-y-3">
                  {contras.map((contra: string) => (
                    <li class="flex items-start gap-2.5 text-sm text-neutral-700 leading-relaxed">
                      <span class="text-red-400 mt-0.5 shrink-0">•</span>
                      {contra}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ) : null}

        {/* Análisis Detallado */}
        <div class="prose prose-neutral prose-p:leading-relaxed prose-h2:font-serif prose-h2:text-2xl prose-h2:font-black prose-a:text-primary-600 max-w-none">
          {analisis ? (
            <>
              <h2>Análisis Detallado</h2>
              {/* Splitting by double newline to create paragraphs if it comes as a single block */}
              {analisis.split('\n\n').map((paragraph: string) => (
                <p class="text-[15px] text-neutral-600 mb-5">{paragraph}</p>
              ))}
            </>
          ) : (
            <p class="text-[15px] text-neutral-600 leading-relaxed">{descripcion}</p>
          )}
        </div>

        {/* ¿Para quién es? */}
        {paraQuien && (
          <div class="mt-12 bg-neutral-50 border border-neutral-200 rounded-xl p-6 sm:p-8">
            <h3 class="text-sm font-bold uppercase tracking-wider text-neutral-900 mb-3">
              ¿Para quién es ideal?
            </h3>
            <p class="text-neutral-600 text-[15px] leading-relaxed">
              {paraQuien}
            </p>
          </div>
        )}
      </div>
    </div>
  </article>
  {/* Sticky Mobile CTA */}
  <div class="fixed bottom-0 left-0 right-0 p-4 bg-white border-t border-neutral-200 shadow-[0_-10px_20px_rgba(0,0,0,0.05)] sm:hidden z-50 flex items-center justify-between gap-4">
    <div class="flex flex-col">
      {descuentoPct && descuentoPct > 0 && (
        <span class="text-[10px] font-bold text-red-600 tracking-wider uppercase mb-0.5">
          Oferta -{descuentoPct}%
        </span>
      )}
      <span class="text-xl font-black text-neutral-900 leading-none">{precio || 'Consultar'}</span>
    </div>
    <a
      href={linkAmazon}
      target="_blank"
      rel="noopener noreferrer"
      class="flex-1 flex items-center justify-center px-4 py-3 bg-[#FF9900] active:bg-[#E68A00] text-black font-bold text-sm rounded-lg whitespace-nowrap"
    >
      Ver precio en Amazon
    </a>
  </div>
</Layout>
