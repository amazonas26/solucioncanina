---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import { getCollection } from "astro:content";
import { slugify } from "../utils/slugify";
import { itemListSchema } from "../utils/seo";
import { notaPrecios } from "../utils/precioConsultado";
import { problemSections, countProductsInSection } from "../utils/problemSections";
import { HERRAMIENTAS } from "../utils/herramientas";
import BlogHeaderIllustration from "../components/illustrations/BlogHeaderIllustration.astro";
import { hasBlogHeader } from "../components/illustrations/registry";
import FotoCredito from "../components/FotoCredito.astro";
import { fotoObligatoria } from "../utils/fotos";

const articulos = await getCollection("articulos");
const HERO = "/images/fotos/golden-bosque.webp";
const fotoHero = fotoObligatoria(HERO, "/");

const categories = Array.from(
  new Set(articulos.map((a) => a.data.categoria).filter(Boolean) as string[]),
);

const categoryDetails: Record<string, { description: string; icon: string }> = {
  "Camas ortopédicas": {
    description: "Descanso cómodo para perros adultos, grandes o con articulaciones sensibles.",
    icon: "bed",
  },
  Condroprotectores: {
    description: "Suplementos pensados para cuidar movilidad, cartílago y articulaciones.",
    icon: "joint",
  },
  "Alimentación específica": {
    description: "Piensos y dietas para necesidades renales, digestivas o veterinarias.",
    icon: "bowl",
  },
  "Omega-3 y aceite de salmón": {
    description: "Omega-3 de pescado para artrosis, piel y pelo, comparado por su EPA y DHA.",
    icon: "joint",
  },
  "Juguetes interactivos": {
    description: "Rellenables, alfombras de olfato y puzles para perros que se aburren en casa.",
    icon: "calm",
  },
  Ansiedad: {
    description: "Feromonas, snacks y soluciones para perros nerviosos o con estrés.",
    icon: "calm",
  },
  Bozales: {
    description: "Opciones seguras para paseos, transporte, entrenamiento y visitas al veterinario.",
    icon: "muzzle",
  },
  Correas: {
    description: "Correas largas, resistentes y de adiestramiento para paseos más controlados.",
    icon: "lead",
  },
  Rampas: {
    description: "Rampas y escaleras para subir al coche, sofá o cama con menos esfuerzo.",
    icon: "ramp",
  },
};

// Categorías genéricas ya cubiertas por una sección por problema (evita duplicar entradas
// que llevan al mismo contenido por dos URLs distintas, dañando SEO y la UX).
const CATEGORIES_COVERED_BY_PROBLEM_SECTIONS = new Set([
  "Camas ortopédicas",
  "Condroprotectores",
  "Rampas",
  "Correas",
  "Arneses",
  "Piel y pelo",
  "Incontinencia",
  "Bozales",
  "Ansiedad",
]);

const categoryCards = categories
  .filter((category) => !CATEGORIES_COVERED_BY_PROBLEM_SECTIONS.has(category))
  .map((category) => ({
    name: category,
    href: `/categoria/${slugify(category)}/`,
    count: articulos.filter((a) => a.data.categoria === category).length,
    description:
      categoryDetails[category]?.description ??
      `Productos seleccionados dentro de la sección ${category.toLowerCase()}.`,
    icon: categoryDetails[category]?.icon ?? "paw",
  }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const problemCards = problemSections
  .map((section) => ({
    name: section.name,
    href: `/categoria/${section.slug}/`,
    count: countProductsInSection(articulos, section),
    description: section.description,
    icon: section.icon,
  }))
  .filter((section) => section.count > 0);

const sectionCards = [...problemCards, ...categoryCards];

// Top 6 más vendidos, como mucho uno por categoría: si no, salían dos camas seguidas.
const topVendidos = (() => {
  const vistos = new Set<string>();
  return articulos
    .filter((a) => typeof a.data.ventas === "number" && (a.data.ventas ?? 0) > 0 && a.data.disponible !== false && Boolean(a.data.precio))
    .sort((a, b) => (b.data.ventas ?? 0) - (a.data.ventas ?? 0))
    .filter((a) => {
      const cat = a.data.categoria ?? a.id;
      if (vistos.has(cat)) return false;
      vistos.add(cat);
      return true;
    })
    .slice(0, 6);
})();
const notaTopVendidos = notaPrecios(topVendidos.map((a) => a.data.slug || slugify(a.data.nombre)));

// Últimos 5 artículos del Blog (1 destacado + 4 en lista) (orden cronológico real por fechaPublicacion).
const allBlogPosts = await getCollection("blog");
const latestPosts = allBlogPosts
  .sort((a, b) => {
    const tA = a.data.fechaPublicacion?.getTime() ?? 0;
    const tB = b.data.fechaPublicacion?.getTime() ?? 0;
    if (tA !== tB) return tB - tA;
    return b.id.localeCompare(a.id);
  })
  .slice(0, 5);
const [leadPost, ...morePosts] = latestPosts;

const BLOG_CAT: Record<string, string> = {
  comportamiento: "Comportamiento",
  guias: "Guías de compra",
  salud: "Salud",
  alimentacion: "Alimentación",
};
const pad = (n: number) => String(n).padStart(2, "0");

// Enlace «ver más» común a todas las secciones: siempre debajo del contenido
const moreLink = "inline-block text-lg font-semibold text-neutral-900 underline decoration-neutral-400 decoration-1 underline-offset-[7px] hover:decoration-neutral-900";
const moreLinkDark = "inline-block text-lg font-semibold text-white underline decoration-white/40 decoration-1 underline-offset-[7px] hover:decoration-white";
---

<Layout
  title="Solución Canina · Decisiones bien hechas para vivir mejor con tu perro"
  description="Guías y análisis de productos para perros con las fuentes a la vista: camas ortopédicas, condroprotectores, rampas, bozales, correas y dietas. Sin rankings inflados."
  categories={categories}
  jsonLd={[
    itemListSchema(
      topVendidos.map((a) => ({
        name: a.data.nombreCorto || a.data.nombre,
        url: `/producto/${a.data.slug || slugify(a.data.nombre)}/`,
        image: a.data.imagen,
      })),
      "Productos más vendidos"
    ),
  ]}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={HERO} type="image/webp" fetchpriority="high" />
  </Fragment>

  {/* Portada: titular gran + foto a tot color */}
  <section class="grid lg:grid-cols-12 gap-8 lg:gap-16 items-center pb-6 md:pb-10" id="hero-section">
    <div class="lg:col-span-7 xl:col-span-7">
      <p class="text-sm font-semibold text-clay-600 mb-6">
        {articulos.length} productos analizados · {allBlogPosts.length} guías · {HERRAMIENTAS.length} calculadoras
      </p>
      <h1 class="font-serif text-[clamp(2.6rem,6.2vw,6rem)] font-semibold leading-[0.97] tracking-[-0.03em] text-neutral-900">
        Decisiones bien hechas para vivir mejor con tu perro
      </h1>
      <p class="mt-7 font-serif text-xl md:text-[1.6rem] leading-snug text-neutral-700 max-w-3xl">
        Leemos lo que publican veterinarios y estudios, y lo que cuentan miles de
        compradores, y te lo resumimos producto a producto. Cada guía enlaza sus fuentes.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a href="/productos/" id="hero-cta" class="inline-flex items-center gap-2 bg-neutral-900 text-paper px-7 py-4 text-[15px] font-semibold hover:bg-primary-800 transition-colors">
          Explorar productos <span aria-hidden="true">→</span>
        </a>
        <a href="#sobre-nosotros" class="text-[15px] font-semibold text-neutral-900 underline decoration-neutral-400 underline-offset-[6px] hover:decoration-neutral-900">
          Cómo trabajamos
        </a>
      </div>
    </div>
    <figure class="lg:col-span-5 xl:col-span-5">
      <img
        src={HERO}
        alt={fotoHero.alt}
        width={fotoHero.ancho}
        height={fotoHero.alto}
        class="w-full aspect-[4/3] lg:aspect-[5/6] object-cover object-[50%_40%]"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <figcaption class="mt-1.5 text-right"><FotoCredito foto={fotoHero} /></figcaption>
    </figure>
  </section>

  {/* Índice por problema */}
  <section class="pt-12 md:pt-16" id="secciones-producto">
    <div class="section-rule mb-3">
      <h2 class="font-serif text-4xl md:text-[3.25rem] font-semibold tracking-tight text-neutral-900 leading-[1.05]">¿Qué le pasa a tu perro?</h2>
    </div>
    <p class="text-lg text-neutral-600 max-w-3xl mb-7">
      Cada sección parte de un problema real y explica antes de nada qué pasa y qué mirar. Los productos vienen después.
    </p>
    <ol class="grid sm:grid-cols-2 xl:grid-cols-3 gap-x-12 border-t border-neutral-300">
      {sectionCards.map((category, i) => (
        <li class="border-b border-neutral-300">
          <a href={category.href} class="group flex gap-5 py-6" aria-label={`Ver productos de ${category.name}`}>
            <span class="font-serif text-[2.4rem] leading-none font-medium text-clay-600 tabular-nums w-14 shrink-0" aria-hidden="true">{pad(i + 1)}</span>
            <span class="min-w-0">
              <span class="block font-serif text-[1.7rem] leading-tight font-semibold text-neutral-900 group-hover:underline decoration-1 underline-offset-4">{category.name}</span>
              <span class="block mt-2 text-base text-neutral-600 leading-relaxed line-clamp-2">{category.description}</span>
              <span class="block mt-2 text-sm font-medium text-neutral-500">{category.count} {category.count === 1 ? "producto" : "productos"}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
    <a href="/productos/" class={`mt-8 ${moreLink}`}>Todo el catálogo →</a>
  </section>

  {/* Calculadoras: bloque oscuro */}
  <section class="mt-14 md:mt-20 bg-navy-800 text-white px-6 py-12 sm:px-10 md:py-16 lg:px-14 scroll-mt-28" id="herramientas">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14">
      <div class="lg:col-span-4">
        <h2 class="font-serif text-4xl md:text-[3.5rem] font-semibold leading-[1.02] tracking-tight text-white">Calcula antes de comprar</h2>
        <p class="mt-5 text-lg text-white/70 leading-relaxed max-w-sm">
          Dos o tres datos de tu perro y una cifra orientativa: talla, dosis, medida o ración.
          El método está a la vista; no sustituyen al veterinario.
        </p>
        <a href="/herramientas/" class={`mt-8 ${moreLinkDark}`}>Todas las calculadoras →</a>
      </div>
      <ul class="lg:col-span-8 grid sm:grid-cols-2 gap-x-12">
        {HERRAMIENTAS.map((h) => (
          <li class="border-t border-white/20">
            <a href={h.href} class="group block py-6">
              <span class="block font-serif text-[1.7rem] leading-snug font-medium text-white group-hover:underline decoration-1 underline-offset-4">{h.pregunta}</span>
              <span class="block mt-2 text-base text-white/60">
                Pide: {h.inputLabels.map((input) => input.label.toLowerCase()).join(", ")}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* Últimas guías: una destacada + lista */}
  {leadPost && (
    <section class="pt-14 md:pt-20" id="blog-destacado">
      <div class="section-rule mb-8">
        <h2 class="font-serif text-4xl md:text-[3.25rem] font-semibold tracking-tight text-neutral-900 leading-[1.05]">Últimas guías</h2>
      </div>
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14">
        <div class="lg:col-span-7">
        <a href={`/blog/${leadPost.slug}/`} class="group block">
          <div class="aspect-[16/9] overflow-hidden bg-neutral-100">
            {hasBlogHeader(leadPost.slug) ? (
              <BlogHeaderIllustration slug={leadPost.slug} title={leadPost.data.titulo} decorative />
            ) : leadPost.data.imagen && (
              <img src={leadPost.data.imagen} alt={leadPost.data.titulo} width="1200" height="675" loading="lazy" decoding="async" class="w-full h-full object-cover" />
            )}
          </div>
          <p class="mt-5 text-sm font-semibold text-clay-600">{BLOG_CAT[leadPost.data.categoria] ?? "Guía"}</p>
          <h3 class="mt-2 font-serif text-3xl md:text-[2.8rem] leading-[1.06] font-semibold tracking-tight text-neutral-900 group-hover:underline decoration-2 underline-offset-[6px]">{leadPost.data.titulo}</h3>
          <p class="mt-4 font-serif text-xl md:text-2xl text-neutral-700 leading-snug max-w-2xl">{leadPost.data.descripcion}</p>
        </a>
        <a href="/blog/" class={`mt-8 ${moreLink}`}>Todas las guías →</a>
        </div>
        <ul class="lg:col-span-5 border-t border-neutral-300 lg:border-t-0">
          {morePosts.map((post) => (
            <li class="border-b border-neutral-300 first:lg:pt-0">
              <a href={`/blog/${post.slug}/`} class="group block py-5">
                <p class="text-sm font-semibold text-clay-600">{BLOG_CAT[post.data.categoria] ?? "Guía"}</p>
                <h3 class="mt-1 font-serif text-[1.7rem] leading-snug font-semibold text-neutral-900 group-hover:underline decoration-1 underline-offset-4">{post.data.titulo}</h3>
                <p class="mt-2 text-base text-neutral-600 leading-relaxed line-clamp-2">{post.data.descripcion}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* Lo más comprado: ranking numerado */}
  <section class="pt-14 md:pt-20" id="top-vendidos">
    <div class="section-rule mb-3">
      <h2 class="font-serif text-4xl md:text-[3.25rem] font-semibold tracking-tight text-neutral-900 leading-[1.05]">Lo más comprado en Amazon</h2>
    </div>
    <p class="text-lg text-neutral-600 max-w-3xl">
      De los productos que hemos analizado, los que más se compraron el último mes en Amazon.es,
      uno de cada tipo. Primero pasan nuestros criterios; el orden lo marcan las compras.
    </p>
    {notaTopVendidos && <p class="mt-1 text-xs text-neutral-500">{notaTopVendidos}</p>}
    {topVendidos.length > 0 ? (
      <div class="mt-8 grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-x-6 gap-y-10">
        {topVendidos.map((art, i) => (
          <ProductCard
            rank={i + 1}
            slug={art.data.slug || slugify(art.data.nombre)}
            nombre={art.data.nombreCorto || art.data.nombre}
            linkAmazon={art.data.linkAmazon}
            imagen={art.data.imagen}
            descripcion={art.data.descripcion}
            precio={art.data.precio}
            precioOriginal={art.data.precioOriginal}
            descuentoPct={art.data.descuentoPct}
            categoria={art.data.categoria}
            marca={art.data.marca}
            valoracion={art.data.valoracion}
            valoracionesCount={art.data.valoracionesCount}
          />
        ))}
      </div>
    ) : (
      <p class="mt-8 text-neutral-500 text-sm">
        Aún no hay datos de ventas. Ejecuta <code class="font-mono text-xs">python scripts/update_prices.py</code> para rellenar el campo <code>ventas</code>.
      </p>
    )}
    <a href="/productos/?sort=sales-desc" class={`mt-10 ${moreLink}`}>Más vendidos →</a>
  </section>

  {/* Sobre nosotros */}
  <section id="sobre-nosotros" class="pt-14 md:pt-20 scroll-mt-28">
    <div class="section-rule mb-8">
      <h2 class="font-serif text-4xl md:text-[3.25rem] font-semibold tracking-tight text-neutral-900 leading-[1.05]">Sobre Solución Canina</h2>
    </div>
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14">
      <div class="lg:col-span-7 space-y-5 font-serif text-xl leading-relaxed text-neutral-800">
        <p class="text-2xl md:text-[1.75rem] leading-snug text-neutral-900">
          Solución Canina nació porque las webs de productos para perros casi
          siempre tienen el mismo problema: te empujan a comprar antes de
          entender qué necesitas.
        </p>
        <p>
          Aquí lo hacemos al revés. Empezamos por el problema (ansiedad,
          articulaciones, descanso, paseo, dieta veterinaria) y solo después
          hablamos de productos.
        </p>
        <p>
          Somos dos personas, no veterinarios, y no probamos los productos.
          Cada ficha resume la información del fabricante, lo que cuentan los
          compradores y lo que dicen veterinarios y estudios. Por eso cada guía
          enlaza sus fuentes: para que puedas comprobarlo.
        </p>
        <p>
          No vendemos directamente. Si compras a través de nuestros enlaces
          de Amazon, ganamos una pequeña comisión. Eso paga el catálogo y no condiciona qué entra ni qué se
          queda fuera.
        </p>
      </div>
      <div class="lg:col-span-5">
        <h3 class="font-sans text-base font-bold text-neutral-900 mb-1">Cómo decidimos qué entra en el catálogo</h3>
        <ol class="border-t border-neutral-900">
          {[
            "Resuelve un problema concreto y identificable.",
            "Composición o materiales con evidencia detrás, no marketing.",
            "Valoraciones reales sostenidas en el tiempo, no picos puntuales.",
            "Relación calidad-precio honesta para el caso de uso real.",
          ].map((item, i) => (
            <li class="flex gap-4 py-4 border-b border-neutral-300">
              <span class="font-serif text-2xl leading-none text-clay-600 tabular-nums w-8 shrink-0" aria-hidden="true">{i + 1}</span>
              <span class="text-neutral-800 leading-relaxed">{item}</span>
            </li>
          ))}
        </ol>
        <a href="/como-analizamos/#criterios-de-inclusion" class={`mt-6 ${moreLink}`}>Cómo analizamos →</a>
        <p class="mt-8 text-sm text-neutral-600 leading-relaxed border-l-2 border-neutral-900 pl-4">
          Esta web no sustituye el consejo veterinario. En dietas veterinarias
          o cuadros clínicos, consulta con tu veterinario antes de cambiar
          alimentación o introducir suplementos.
        </p>
      </div>
    </div>
  </section>
</Layout>
