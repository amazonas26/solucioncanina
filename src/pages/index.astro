---
import Layout from '../layouts/Layout.astro';
import SearchableGrid from '../components/SearchableGrid';
import { getCollection } from 'astro:content';

// Fetch all articles from the Keystatic collection
const articulos = await getCollection('articulos');
---

<Layout title="Inicio - Los mejores artículos para tu perro">
  {/* Hero Section */}
  <section class="relative mb-24 md:mb-32">
    <div class="absolute inset-0 -z-10 overflow-hidden">
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-primary-200/40 rounded-full blur-3xl animate-pulse"></div>
      <div class="absolute top-1/2 -left-24 w-72 h-72 bg-accent-200/30 rounded-full blur-3xl"></div>
    </div>

    <div class="max-w-4xl">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-2xl bg-white/50 backdrop-blur-sm border border-primary-100/50 text-primary-700 text-sm font-bold mb-8 shadow-sm">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-primary-500"></span>
        </span>
        Selección 2024 Actualizada
      </div>

      <h1 class="text-5xl md:text-7xl lg:text-8xl font-display font-black text-slate-900 mb-8 tracking-tight leading-[0.9] md:leading-[0.9]">
        Lo mejor para tu <br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-600 to-primary-400">mejor amigo</span>
      </h1>
      
      <p class="text-xl md:text-2xl text-slate-500 mb-12 max-w-2xl leading-relaxed font-medium">
        Curamos cuidadosamente los productos con mejores valoraciones en Amazon para asegurar la felicidad y salud de tu perro.
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="#articulos" class="px-8 py-4 bg-slate-900 text-white font-bold rounded-2xl shadow-xl shadow-slate-200 hover:bg-primary-600 transition-all hover:-translate-y-1">
          Explorar Productos
        </a>
      </div>
    </div>
  </section>

  {/* Search and Grid Section */}
  <section id="articulos" class="scroll-mt-32">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
      <div>
        <h2 class="text-3xl md:text-4xl font-display font-black text-slate-900 mb-4 tracking-tight">
          Catálogo de Productos
        </h2>
        <div class="h-1.5 w-20 bg-primary-500 rounded-full"></div>
      </div>
      <p class="text-slate-500 font-medium md:max-w-xs md:text-right">
        {articulos.length} artículos encontrados y listos para tu mascota.
      </p>
    </div>

    <SearchableGrid client:load articulos={articulos} />
  </section>
</Layout>

<style>
  /* Custom animations if needed */
</style>
