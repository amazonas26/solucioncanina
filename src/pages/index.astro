---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import ProductCarouselWrapper from "../components/ProductCarouselWrapper.astro";
import SectionIcon from "../components/SectionIcon.astro";
import { getCollection } from "astro:content";
import { slugify } from "../utils/slugify";
import { itemListSchema } from "../utils/seo";
import { problemSections, countProductsInSection } from "../utils/problemSections";

const articulos = await getCollection("articulos");

const categories = Array.from(
  new Set(articulos.map((a) => a.data.categoria).filter(Boolean) as string[]),
);

const categoryDetails: Record<string, { description: string; icon: string }> = {
  "Camas ortopédicas": {
    description: "Descanso cómodo para perros adultos, grandes o con articulaciones sensibles.",
    icon: "bed",
  },
  Condroprotectores: {
    description: "Suplementos pensados para cuidar movilidad, cartílago y articulaciones.",
    icon: "joint",
  },
  "Alimentación específica": {
    description: "Piensos y dietas para necesidades renales, digestivas o veterinarias.",
    icon: "bowl",
  },
  Ansiedad: {
    description: "Feromonas, snacks y soluciones para perros nerviosos o con estrés.",
    icon: "calm",
  },
  Bozales: {
    description: "Opciones seguras para paseos, transporte, entrenamiento y visitas al veterinario.",
    icon: "muzzle",
  },
  Correas: {
    description: "Correas largas, resistentes y de adiestramiento para paseos más controlados.",
    icon: "lead",
  },
  Rampas: {
    description: "Rampas y escaleras para subir al coche, sofá o cama con menos esfuerzo.",
    icon: "ramp",
  },
};

// Categorías genéricas ya cubiertas por una sección por problema (evita duplicar entradas
// que llevan al mismo contenido por dos URLs distintas, dañando SEO y la UX).
const CATEGORIES_COVERED_BY_PROBLEM_SECTIONS = new Set([
  "Camas ortopédicas",
  "Condroprotectores",
  "Rampas",
  "Correas",
  "Bozales",
  "Ansiedad",
]);

const categoryCards = categories
  .filter((category) => !CATEGORIES_COVERED_BY_PROBLEM_SECTIONS.has(category))
  .map((category) => ({
    name: category,
    href: `/categoria/${slugify(category)}`,
    count: articulos.filter((a) => a.data.categoria === category).length,
    description:
      categoryDetails[category]?.description ??
      `Productos seleccionados dentro de la sección ${category.toLowerCase()}.`,
    icon: categoryDetails[category]?.icon ?? "paw",
  }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const problemCards = problemSections
  .map((section) => ({
    name: section.name,
    href: `/categoria/${section.slug}`,
    count: countProductsInSection(articulos, section),
    description: section.description,
    icon: section.icon,
  }))
  .filter((section) => section.count > 0);

const sectionCards = [...problemCards, ...categoryCards];

// Top 6 productos más vendidos (de más a menos).
const topVendidos = articulos
  .filter((a) => typeof a.data.ventas === "number" && (a.data.ventas ?? 0) > 0)
  .sort((a, b) => (b.data.ventas ?? 0) - (a.data.ventas ?? 0))
  .slice(0, 6);

// Últimos 3 artículos del Blog (orden cronológico real por fechaPublicacion).
const allBlogPosts = await getCollection("blog");
const latestPosts = allBlogPosts
  .sort((a, b) => {
    const tA = a.data.fechaPublicacion?.getTime() ?? 0;
    const tB = b.data.fechaPublicacion?.getTime() ?? 0;
    if (tA !== tB) return tB - tA;
    return b.id.localeCompare(a.id);
  })
  .slice(0, 3);

// Polígono "starburst" para el sello TOP #N (16 puntas).
const STAR_POINTS = (() => {
  const N = 32; // 16 picos × 2 puntos
  const outerR = 50;
  const innerR = 41;
  return Array.from({ length: N }, (_, i) => {
    const angle = ((i * (360 / N) - 90) * Math.PI) / 180;
    const r = i % 2 === 0 ? outerR : innerR;
    const x = 50 + r * Math.cos(angle);
    const y = 50 + r * Math.sin(angle);
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  }).join(" ");
})();
---

<Layout
  title="Solución Canina · Decisiones bien hechas para vivir mejor con tu perro"
  description="Análisis honestos, criterio claro y solo recomendaciones que aguantarían la pregunta '¿se lo darías al tuyo?'. Sin marearte, sin spam de marketplace."
  categories={categories}
  jsonLd={[
    itemListSchema(
      topVendidos.map((a) => ({
        name: a.data.nombre,
        url: `/producto/${a.data.slug || slugify(a.data.nombre)}`,
        image: a.data.imagen,
      })),
      "Productos más vendidos"
    ),
  ]}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/hero/hero_clean.avif" type="image/avif" fetchpriority="high" />
  </Fragment>

  {/* Hero Section */}
  <section
    class="relative mb-14 md:mb-20 overflow-hidden rounded-xl border border-neutral-200"
    id="hero-section"
  >
    <div class="absolute inset-0 -z-10">
      <picture>
        <source srcset="/images/hero/hero_clean.avif" type="image/avif" />
        <source srcset="/images/hero/hero_clean.webp" type="image/webp" />
        <img
          src="/images/hero/hero_clean.png"
          alt="Perro jugando en el campo"
          width="1024"
          height="1024"
          class="h-full w-full object-cover object-center"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
      <div
        class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/80 to-white/30"
      >
      </div>
      <div
        class="absolute inset-0 bg-gradient-to-t from-white/50 via-transparent to-transparent"
      >
      </div>
    </div>

    <div
      class="px-6 py-10 sm:px-10 sm:py-12 md:px-12 md:py-16 lg:px-14 lg:py-20 max-w-3xl"
    >
      <div
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-primary-50 border border-primary-200 text-primary-700 text-xs font-bold mb-6"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg
        >
        Análisis editorial · Sin presión de venta
      </div>

      <h1
        class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-serif font-black text-neutral-900 mb-5 leading-tight"
      >
        Decisiones bien hechas <br class="hidden sm:block" />
        <span class="text-primary-600">para vivir mejor con tu perro</span>
      </h1>

      <p
        class="text-base md:text-lg text-neutral-600 mb-8 max-w-xl leading-relaxed"
      >
        Analizamos producto a producto con criterio veterinario y de educadores.
        Aquí no recomendamos nada que no le daríamos al nuestro — y los enlaces
        a Amazon están al final del análisis, no al principio.
      </p>

      <div class="flex flex-wrap gap-3">
        <a
          href="/productos"
          class="inline-flex items-center gap-2 px-6 py-3 bg-navy-700 text-white text-sm font-bold rounded-lg hover:bg-navy-800 transition-colors"
          id="hero-cta"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"
            ></path></svg
          >
          Explorar productos
        </a>
        <a
          href="#sobre-nosotros"
          class="inline-flex items-center gap-2 px-6 py-3 bg-white text-neutral-700 text-sm font-semibold rounded-lg border border-neutral-200 hover:border-neutral-300 hover:bg-neutral-50 transition-colors"
        >
          Cómo trabajamos
        </a>
      </div>
    </div>
  </section>

  {/* Banner: Calculadora de dosis de condroprotector */}
  <section class="mb-14 md:mb-20" id="banner-calculadora">
    <a
      href="/calculadora-dosis-condroprotector-perros"
      class="group flex flex-col sm:flex-row sm:items-center gap-5 rounded-2xl border border-primary-200 bg-gradient-to-r from-primary-50 to-white p-6 md:p-8 hover:border-primary-300 hover:shadow-md transition-all"
    >
      <div class="shrink-0 flex h-14 w-14 items-center justify-center rounded-xl bg-primary-600 text-white shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/></svg>
      </div>
      <div class="flex-grow">
        <p class="text-xs font-bold uppercase tracking-wide text-primary-600 mb-1">Herramienta gratis</p>
        <h2 class="text-xl md:text-2xl font-serif font-black text-neutral-900 leading-snug">
          Calculadora de dosis de condroprotector
        </h2>
        <p class="text-sm text-neutral-600 mt-1 max-w-xl">
          Introduce el peso de tu perro y calcula la dosis diaria de glucosamina, condroitina y MSM que
          debe cubrir el producto. Así no pagas de más por suplementos con dosis bajas.
        </p>
      </div>
      <span class="shrink-0 inline-flex items-center gap-2 self-start sm:self-auto px-5 py-3 bg-primary-600 text-white text-sm font-bold rounded-lg group-hover:bg-primary-700 transition-colors">
        Abrir calculadora
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </span>
    </a>
  </section>

  {/* Artículos destacados del Blog */}
  <section class="mb-14 md:mb-20" id="blog-destacado">
    <div class="border-b border-neutral-200 pb-4 mb-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-primary-600 mb-1">
            Contenido Editorial
          </p>
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-serif font-black text-neutral-900 tracking-tight">
            Guías y Consejos Caninos
          </h2>
        </div>
        <a href="/blog" class="inline-flex items-center gap-1.5 px-4 py-2 bg-neutral-50 text-neutral-700 text-xs font-bold uppercase tracking-wide rounded-md border border-neutral-200 hover:bg-neutral-100 hover:text-neutral-900 transition-colors sm:self-center">
          Ir al blog completo
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {latestPosts.map((post) => (
        <a href={`/blog/${post.slug}`} class="group flex flex-col bg-white border border-neutral-200 rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-300">
          <div class="aspect-[16/9] overflow-hidden relative">
            {post.data.imagen ? (
              <img
                src={post.data.imagen}
                alt={post.data.titulo}
                width="640"
                height="360"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            ) : (
              <div class="w-full h-full bg-neutral-100 flex items-center justify-center text-neutral-300">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M8 7h6"/><path d="M8 11h8"/></svg>
              </div>
            )}
            <div class="absolute top-4 left-4">
              <span class="px-2.5 py-1 bg-white/90 backdrop-blur-sm text-primary-700 text-[10px] font-black uppercase tracking-widest rounded-md shadow-sm">
                {post.data.categoria}
              </span>
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-lg font-black text-neutral-900 leading-tight mb-3 group-hover:text-primary-600 transition-colors">
              {post.data.titulo}
            </h3>
            <p class="text-neutral-500 text-sm line-clamp-2 leading-relaxed">
              {post.data.descripcion}
            </p>
            <div class="mt-4 flex items-center gap-2 text-primary-600 font-bold text-xs uppercase tracking-widest">
              Leer artículo
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  {/* Secciones de producto */}
  <section class="mb-14 md:mb-20" id="secciones-producto">
    <div class="border-b border-neutral-200 pb-4 mb-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <p
            class="text-xs font-bold uppercase tracking-wider text-primary-600 mb-1"
          >
            Guía por necesidades
          </p>
          <h2
            class="text-3xl md:text-4xl lg:text-5xl font-serif font-black text-neutral-900 tracking-tight"
          >
            ¿Qué le pasa a tu perro? Empieza por aquí
          </h2>
          <p class="mt-2 text-sm text-neutral-500 max-w-2xl">
            Cada sección parte de un problema real (ansiedad, articulaciones, descanso, paseo)
            y explica antes de nada qué pasa y qué mirar. Los productos vienen después.
          </p>
        </div>
        <a href="/productos" class="inline-flex items-center gap-1.5 px-4 py-2 bg-neutral-50 text-neutral-700 text-xs font-bold uppercase tracking-wide rounded-md border border-neutral-200 hover:bg-neutral-100 hover:text-neutral-900 transition-colors sm:self-center">
          Ver catálogo completo
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {sectionCards.map((category) => (
        <a
          href={category.href}
          class="group relative overflow-hidden rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-primary-200 hover:shadow-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
          aria-label={`Ver productos de ${category.name}`}
        >
          <div class="absolute -right-8 -top-8 h-28 w-28 rounded-full bg-primary-50 transition-transform duration-300 group-hover:scale-125"></div>
          <div class="relative flex h-full flex-col gap-5">
            <div class="flex items-start justify-between gap-4">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary-100 text-primary-700 ring-1 ring-primary-200">
                <SectionIcon name={category.icon} />
              </div>
              <span class="rounded-full bg-neutral-100 px-3 py-1 text-xs font-black text-neutral-500">
                {category.count} {category.count === 1 ? "producto" : "productos"}
              </span>
            </div>
            <div>
              <h3 class="mb-2 text-xl font-black text-neutral-900 transition-colors group-hover:text-primary-700">
                {category.name}
              </h3>
              <p class="text-sm leading-relaxed text-neutral-500">
                {category.description}
              </p>
            </div>
            <div class="mt-auto flex items-center gap-2 text-xs font-black uppercase tracking-widest text-primary-600">
              Ver sección
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  {/* Productos más vendidos */}
  <section class="mb-14 md:mb-20" id="top-vendidos">
    <div class="border-b border-neutral-200 pb-4 mb-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <p
            class="text-xs font-bold uppercase tracking-wider text-primary-600 mb-1"
          >
            Curaduría del mes
          </p>
          <h2
            class="text-3xl md:text-4xl lg:text-5xl font-serif font-black text-neutral-900 tracking-tight"
          >
            Lo que mejor está funcionando este mes
          </h2>
          <p class="mt-2 text-sm text-neutral-500 max-w-2xl">
            Los productos que más están conectando con nuestros lectores. No es solo
            ranking de ventas: es lo que pasa nuestros criterios y, encima, la gente repite la compra.
          </p>
        </div>
        <a href="/productos?sort=sales-desc" class="inline-flex items-center gap-1.5 px-4 py-2 bg-neutral-50 text-neutral-700 text-xs font-bold uppercase tracking-wide rounded-md border border-neutral-200 hover:bg-neutral-100 hover:text-neutral-900 transition-colors sm:self-center">
          Ver todos los más populares
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
      </div>
    </div>

    {
      topVendidos.length > 0 ? (
        <ProductCarouselWrapper>
          {topVendidos.map((art, i) => (
            <div class="relative w-56 flex-shrink-0 h-[420px]">
              <div
                class="absolute -top-3 -left-3 z-20 h-14 w-14 pointer-events-none drop-shadow-[0_4px_6px_rgba(0,0,0,0.15)]"
                aria-label={`Top número ${i + 1} en ventas`}
                role="img"
              >
                <svg viewBox="0 0 100 100" class="w-full h-full">
                  <polygon
                    points={STAR_POINTS}
                    fill="#FACC15"
                    stroke="#DC2626"
                    stroke-width="5"
                    stroke-linejoin="round"
                  />
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center leading-none text-red-700 font-black">
                  <span class="text-[8px] uppercase tracking-wider -mb-0.5">Top</span>
                  <span class="text-base">#{i + 1}</span>
                </div>
              </div>
              <ProductCard
                slug={art.data.slug || slugify(art.data.nombre)}
                nombre={art.data.nombre}
                linkAmazon={art.data.linkAmazon}
                imagen={art.data.imagen}
                descripcion={art.data.descripcion}
                precio={art.data.precio}
                precioOriginal={art.data.precioOriginal}
                descuentoPct={art.data.descuentoPct}
                categoria={art.data.categoria}
                marca={art.data.marca}
                valoracion={art.data.valoracion}
                valoracionesCount={art.data.valoracionesCount}
              />
            </div>
          ))}
        </ProductCarouselWrapper>
      ) : (
        <div class="rounded-lg bg-neutral-50 border border-neutral-200 p-8">
          <p class="text-neutral-500 text-sm">
            Aún no hay datos de ventas. Ejecuta{" "}
            <code class="px-1.5 py-0.5 rounded bg-neutral-100 text-neutral-700 font-mono text-xs">
              python scripts/update_prices.py
            </code>{" "}
            para rellenar el campo <code>ventas</code>.
          </p>
        </div>
      )
    }
  </section>

  {/* Sobre nosotros */}
  <section id="sobre-nosotros" class="scroll-mt-28">
    <div class="border-b border-neutral-200 pb-4 mb-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <p
            class="text-xs font-bold uppercase tracking-wider text-neutral-400 mb-1"
          >
            Quiénes somos
          </p>
          <h2
            class="text-3xl md:text-4xl lg:text-5xl font-serif font-black text-neutral-900 tracking-tight"
          >
            Sobre Solución Canina
          </h2>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div
        class="lg:col-span-2 space-y-4 text-neutral-600 text-sm leading-relaxed"
      >
        <p class="text-base text-neutral-800 font-semibold leading-relaxed">
          Solución Canina nació porque las webs de productos para perros casi
          siempre tienen el mismo problema: te empujan a comprar antes de
          entender qué necesitas.
        </p>
        <p>
          Aquí lo hacemos al revés. Empezamos por el problema —ansiedad,
          articulaciones, descanso, paseo, dieta veterinaria— y solo después
          hablamos de productos. Cada ficha es un análisis nuestro, escrito
          por personas que conviven con perros y que se hacen las mismas
          preguntas que tú antes de comprar.
        </p>
        <p>
          No vendemos directamente. Si compras a través de los enlaces de
          Amazon que aparecen al final del análisis, ganamos una pequeña
          comisión. Eso paga el catálogo y no condiciona qué entra ni qué se
          queda fuera.
        </p>
      </div>

      <div class="space-y-4">
        <div class="rounded-lg bg-navy-700 text-white p-6">
          <h3
            class="text-xs font-bold uppercase tracking-wider text-white/50 mb-3"
          >
            Cómo decidimos qué entra en el catálogo
          </h3>
          <ul class="space-y-2.5 text-sm">
            {[
              "Resuelve un problema concreto y identificable.",
              "Composición o materiales con evidencia detrás, no marketing.",
              "Valoraciones reales sostenidas en el tiempo, no picos puntuales.",
              "Relación calidad-precio honesta para el caso de uso real.",
            ].map((item) => (
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary-300 mt-0.5 shrink-0" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-lg bg-neutral-50 border border-neutral-200 p-6">
          <h3
            class="text-xs font-bold uppercase tracking-wider text-neutral-400 mb-3"
          >
            Lo que no hacemos
          </h3>
          <p class="text-sm text-neutral-500 leading-relaxed">
            Esta web no sustituye el consejo veterinario. En dietas veterinarias
            o cuadros clínicos, consulta con tu veterinario antes de cambiar
            alimentación o introducir suplementos. Aquí no recomendamos a ciegas.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
