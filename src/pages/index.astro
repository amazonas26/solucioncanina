---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getCollection } from 'astro:content';

// Fetch all products from the Keystatic collection
const products = await getCollection('products');

// Fallback sample data in case the collection is empty initially
const sampleProducts = [
  {
    data: {
      title: "Cama Ortopédica para Perros Grandes",
      amazonLink: "https://amazon.es",
      image: "https://images.unsplash.com/photo-1544568100-847a948585b9?auto=format&fit=crop&q=80&w=800&h=600",
      description: "Cama de espuma viscoelástica para aliviar el dolor articular y mejorar el descanso de tu mascota."
    }
  },
  {
    data: {
      title: "Arnés Antitirones Premium",
      amazonLink: "https://amazon.es",
      image: "https://images.unsplash.com/photo-1601758174114-e711c0cbaa69?auto=format&fit=crop&q=80&w=800&h=600",
      description: "Diseño ergonómico, reflectante y ajustable. Perfecto para paseos seguros y cómodos."
    }
  },
  {
    data: {
      title: "Juguete Interactivo Kong Classic",
      amazonLink: "https://amazon.es",
      image: "https://images.unsplash.com/photo-1576201836106-db1758fd1c97?auto=format&fit=crop&q=80&w=800&h=600",
      description: "El juguete más resistente para perros que adoran masticar. Se puede rellenar con premios."
    }
  }
];

const displayProducts = products.length > 0 ? products : sampleProducts;
---

<Layout title="Inicio">
  <div class="mb-12 md:mb-20">
    <div class="bg-gradient-to-br from-primary-50 to-primary-100 rounded-3xl p-8 md:p-12 lg:p-16 text-center shadow-inner relative overflow-hidden border border-primary-100">
      <!-- Decorative blobs -->
      <div class="absolute top-0 left-0 w-64 h-64 bg-primary-200/50 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-blob transform -translate-x-1/2 -translate-y-1/2"></div>
      <div class="absolute bottom-0 right-0 w-64 h-64 bg-accent-200/50 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-blob animation-delay-2000 transform translate-x-1/3 translate-y-1/3"></div>
      
      <div class="relative z-10 max-w-3xl mx-auto">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-['Outfit'] font-extrabold text-slate-900 mb-6 tracking-tight">
          Lo mejor para tu <span class="text-primary-600">mejor amigo</span>
        </h1>
        <p class="text-lg md:text-xl text-slate-600 mb-8 max-w-2xl mx-auto leading-relaxed">
          Seleccionamos cuidadosamente los artículos mejor valorados en Amazon para que tu perro tenga una vida feliz, saludable y llena de diversión.
        </p>
      </div>
    </div>
  </div>

  <div class="mb-8 flex items-center justify-between">
    <h2 class="text-2xl md:text-3xl font-['Outfit'] font-bold text-slate-900">
      Productos Destacados
    </h2>
  </div>

  {displayProducts.length === 0 ? (
    <div class="text-center py-20 bg-white rounded-2xl border border-dashed border-slate-300">
      <p class="text-slate-500 text-lg">Aún no hay productos. Añade algunos desde el <a href="/keystatic" class="text-primary-600 hover:underline">panel de administración</a>.</p>
    </div>
  ) : (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 md:gap-8">
      {displayProducts.map((product) => (
        <ProductCard 
          title={product.data.title}
          amazonLink={product.data.amazonLink}
          image={product.data.image}
          description={product.data.description}
        />
      ))}
    </div>
  )}
</Layout>

<style>
  @keyframes blob {
    0% { transform: translate(0px, 0px) scale(1); }
    33% { transform: translate(30px, -50px) scale(1.1); }
    66% { transform: translate(-20px, 20px) scale(0.9); }
    100% { transform: translate(0px, 0px) scale(1); }
  }
  .animate-blob {
    animation: blob 7s infinite;
  }
  .animation-delay-2000 {
    animation-delay: 2s;
  }
</style>
