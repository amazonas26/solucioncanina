---
import Layout from '../../layouts/Layout.astro';
import HerramientaCard from '../../components/HerramientaCard.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema, collectionPageSchema } from '../../utils/seo';
import { HERRAMIENTAS, HERRAMIENTAS_PATH } from '../../utils/herramientas';

const articulos = await getCollection('articulos');
const categories = Array.from(
  new Set(articulos.map((a) => a.data.categoria).filter(Boolean) as string[]),
);

const title = 'Herramientas para elegir mejor el producto de tu perro';
const description =
  'Calculadoras de dosis de condroprotector, talla de bozal, talla de cama, medida de rampa, talla de arnés o collar, talla de pañal, ración de pienso renal y dosis de omega-3. Orientativas, con el método a la vista.';
const pageUrl = HERRAMIENTAS_PATH;

const jsonLd = [
  collectionPageSchema({
    name: 'Herramientas',
    description,
    url: pageUrl,
    items: HERRAMIENTAS.map((h) => ({ name: h.nombre, url: h.href })),
  }),
  breadcrumbSchema([
    { name: 'Inicio', url: '/' },
    { name: 'Herramientas', url: pageUrl },
  ]),
];
---

<Layout title={title} description={description} jsonLd={jsonLd} categories={categories}>
  <nav aria-label="Breadcrumb" class="flex mb-6 text-sm text-neutral-500 gap-2 items-center">
    <a href="/" class="hover:text-neutral-900 hover:underline underline-offset-4">Inicio</a>
    <span class="text-neutral-300">/</span>
    <span class="text-neutral-800">Calculadoras</span>
  </nav>

  <header class="border-b border-neutral-900 pb-8 mb-10">
    <h1 class="font-serif text-5xl md:text-7xl font-semibold tracking-[-0.03em] text-neutral-900 leading-[1.02]">
      Calcula antes de comprar
    </h1>
    <p class="mt-5 font-serif text-xl md:text-2xl text-neutral-700 leading-snug max-w-3xl">
      Cada calculadora responde una pregunta concreta. Introduce dos o tres datos y obtén talla,
      dosis, medida o ración orientativa. No sustituyen al veterinario. Las fórmulas y las fuentes
      están en
      <a href="/como-analizamos/#fuentes" class="text-primary-700 underline decoration-primary-300 underline-offset-4 hover:decoration-primary-700">cómo analizamos</a>.
    </p>
  </header>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10">
    {HERRAMIENTAS.map((h) => (
      <HerramientaCard herramienta={h} heading="h2" />
    ))}
  </div>

  <p class="mt-12 text-sm text-neutral-500 max-w-2xl leading-relaxed">
    Método y fuentes de estas herramientas:
    <a href="/como-analizamos/#fuentes" class="text-primary-600 font-semibold hover:underline">política de fuentes</a>.
    Si un dato no está en la etiqueta o en la literatura, no lo inventamos.
  </p>
</Layout>
