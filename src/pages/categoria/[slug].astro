---
import Layout from '../../layouts/Layout.astro';
import SearchableGrid from '../../components/SearchableGrid';
import { getCollection } from 'astro:content';
import { slugify } from '../../utils/slugify';

export async function getStaticPaths() {
  const articulos = await getCollection('articulos');
  const categories = Array.from(
    new Set(articulos.map((a) => a.data.categoria).filter(Boolean) as string[])
  );

  return categories.map((category) => ({
    params: { slug: slugify(category) },
    props: { category, categories },
  }));
}

const { category, categories } = Astro.props;
const allArticulos = await getCollection('articulos');
const filteredArticulos = allArticulos.filter(a => a.data.categoria === category);
---

<Layout title={`${category} - Solución Canina`} categories={categories}>
  <div class="mb-10">
    <nav class="flex mb-4 text-xs font-medium text-neutral-400 gap-2 items-center">
      <a href="/" class="hover:text-primary-600 transition-colors">Inicio</a>
      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      <span class="text-neutral-900">{category}</span>
    </nav>
    
    <div class="border-b border-neutral-200 pb-4">
      <h1 class="text-3xl md:text-4xl font-serif font-black text-neutral-900 mb-2">
        {category}
      </h1>
      <p class="text-neutral-500 text-sm">
        Explora nuestra selección de {filteredArticulos.length} {filteredArticulos.length === 1 ? 'producto' : 'productos'} para {category.toLowerCase()}.
      </p>
    </div>
  </div>

  <SearchableGrid client:load articulos={allArticulos} />
</Layout>

<script define:vars={{ category }}>
  // Pre-select category for SearchableGrid
  window.__sc = window.__sc || {};
  window.__sc.category = category;
</script>
