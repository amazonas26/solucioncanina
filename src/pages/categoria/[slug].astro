---
import Layout from '../../layouts/Layout.astro';
import SearchableGrid from '../../components/SearchableGrid';
import { getCollection } from 'astro:content';
import { slugify } from '../../utils/slugify';
import { itemListSchema, breadcrumbSchema, collectionPageSchema } from '../../utils/seo';
import { problemSections, productInPrimarySection, getCategoryGuide, getCategorySeo } from '../../utils/problemSections';
import { blogsForCategory } from '../../utils/blogProductLinks';
import { FOTO_CATEGORIA, fotoObligatoria } from '../../utils/fotos';
import FotoCredito from '../../components/FotoCredito.astro';

export async function getStaticPaths() {
  const articulos = await getCollection('articulos');
  const categories = Array.from(
    new Set(articulos.map((a) => a.data.categoria).filter(Boolean) as string[])
  );

  const categoryPaths = categories.map((category) => ({
    params: { slug: slugify(category) },
    props: { category, categories },
  }));

  // Les seccions amb `aliasOf` no tenen pàgina: enllacen a la de la categoria (301 a nginx).
  const problemPaths = problemSections.filter((section) => !section.aliasOf).map((section) => ({
    params: { slug: section.slug },
    props: { category: section.name, categories, sectionSlug: section.slug },
  }));

  return [...categoryPaths, ...problemPaths];
}

const { category, categories, sectionSlug } = Astro.props;
const allArticulos = await getCollection('articulos');
const publicArticulos = allArticulos.map((art) => ({
  ...art,
  data: {
    ...art.data,
    linkAmazon: '',
  },
}));
const problemSection = problemSections.find((section) => section.slug === sectionSlug);
const filteredArticulos = problemSection
  ? allArticulos.filter((a) => productInPrimarySection(a, problemSection))
  : allArticulos.filter(a => a.data.categoria === category);

const categorySlug = problemSection?.slug ?? slugify(category);
const categoryUrl = `/categoria/${categorySlug}/`;
const fotoSrc = FOTO_CATEGORIA[categorySlug];
const foto = fotoSrc ? fotoObligatoria(fotoSrc, categoryUrl) : null;
const categoryListJsonLd = itemListSchema(
  filteredArticulos.map((a) => ({
    name: a.data.nombreCorto || a.data.nombre,
    url: `/producto/${a.data.slug || slugify(a.data.nombre)}/`,
    image: a.data.imagen,
  })),
  category
);
const categoryBreadcrumbJsonLd = breadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: category, url: categoryUrl },
]);
const categoryPageJsonLd = collectionPageSchema({
  name: category,
  description: `Productos para perros en la categoría ${category.toLowerCase()}.`,
  url: categoryUrl,
  numberOfItems: filteredArticulos.length,
});
const categoryDescription = problemSection?.description ??
  `${filteredArticulos.length} ${filteredArticulos.length === 1 ? 'producto analizado' : 'productos analizados'} para ${category.toLowerCase()}: comparativa, precios y valoraciones de Amazon.`;

const categoryGuide = problemSection
  ? {
      problema: problemSection.problema,
      cuandoConviene: problemSection.cuandoConviene,
      queMirar: problemSection.queMirar,
    }
  : getCategoryGuide(category);
const hasGuide = Boolean(
  categoryGuide && (categoryGuide.problema || categoryGuide.cuandoConviene || categoryGuide.queMirar)
);
// Títol/descripció SEO propis (només per a categories reals; les problemSection mantenen els seus).
const seo = getCategorySeo(category);
// Guies de blog relacionades amb aquesta categoria (clúster intern categoria↔blog).
const relatedBlogs = blogsForCategory(category);
---

<Layout
  title={seo?.title ?? category}
  description={seo?.description ?? categoryDescription}
  categories={categories}
  jsonLd={[categoryPageJsonLd, categoryListJsonLd, categoryBreadcrumbJsonLd]}
>
  <div class="mb-10">
    <nav aria-label="Breadcrumb" class="flex mb-6 text-sm text-neutral-500 gap-2 items-center">
      <a href="/" class="hover:text-neutral-900 hover:underline underline-offset-4">Inicio</a>
      <span class="text-neutral-300">/</span>
      <span class="text-neutral-800">{category}</span>
    </nav>

    <div class="border-b border-neutral-900 pb-8 grid lg:grid-cols-12 gap-x-12 gap-y-6 items-end">
      <div class={foto ? 'lg:col-span-7' : 'lg:col-span-12'}>
        <h1 class="font-serif text-[2.6rem] sm:text-5xl md:text-7xl font-semibold tracking-[-0.03em] text-neutral-900 break-words [hyphens:auto]" lang="es">
          {category}
        </h1>
        <p class="mt-4 font-serif text-xl md:text-2xl text-neutral-700 max-w-3xl leading-snug">
          {problemSection?.description ?? `${filteredArticulos.length} ${filteredArticulos.length === 1 ? 'producto analizado' : 'productos analizados'}.`}
        </p>
      </div>
      {foto && fotoSrc && (
        <figure class="lg:col-span-5">
          <img src={fotoSrc} alt={foto.alt} width={foto.ancho} height={foto.alto} loading="eager" decoding="async" class="w-full aspect-[16/9] lg:aspect-[4/3] object-cover" />
          <figcaption class="mt-1.5 text-right"><FotoCredito foto={foto} /></figcaption>
        </figure>
      )}
    </div>
  </div>

  {hasGuide && categoryGuide && (
    <section class="mb-14 grid lg:grid-cols-12 gap-10 lg:gap-16">
      {categoryGuide.problema && (
        <div class="lg:col-span-7">
          <h2 class="font-sans text-sm font-bold text-neutral-900 mb-3">El problema en breve</h2>
          <p class="font-serif text-2xl md:text-[1.75rem] leading-snug text-neutral-900">
            {categoryGuide.problema}
          </p>
        </div>
      )}
      <div class="lg:col-span-5 space-y-8">
        {categoryGuide.cuandoConviene && categoryGuide.cuandoConviene.length > 0 && (
          <div>
            <h2 class="font-sans text-sm font-bold text-neutral-900 pb-2 border-b-2 border-neutral-900">Cuándo conviene plantearse algo</h2>
            <ul>
              {categoryGuide.cuandoConviene.map((item) => (
                <li class="py-3 border-b border-neutral-300 text-[15px] text-neutral-800 leading-relaxed">{item}</li>
              ))}
            </ul>
          </div>
        )}
        {categoryGuide.queMirar && categoryGuide.queMirar.length > 0 && (
          <div>
            <h2 class="font-sans text-sm font-bold text-neutral-900 pb-2 border-b-2 border-neutral-900">Qué mirar antes de comprar</h2>
            <ul>
              {categoryGuide.queMirar.map((item) => (
                <li class="py-3 border-b border-neutral-300 text-[15px] text-neutral-800 leading-relaxed">{item}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  {categorySlug === 'condroprotectores' && (
    <section class="mb-12" id="banner-calculadora">
      <a
        href="/calculadora-dosis-condroprotector-perros/"
        class="group flex flex-col sm:flex-row sm:items-center gap-5 bg-navy-800 text-white px-6 py-7 md:px-10"
      >
        <div class="flex-grow">
          <h2 class="font-serif text-2xl md:text-3xl font-semibold text-white leading-snug group-hover:underline decoration-1 underline-offset-4">
            Calculadora de dosis de condroprotector
          </h2>
          <p class="text-[15px] text-white/70 mt-2 max-w-2xl leading-relaxed">
            Introduce el peso de tu perro y calcula la dosis diaria de glucosamina, condroitina y MSM que
            debe cubrir el producto. Así no pagas de más por suplementos con dosis bajas.
          </p>
        </div>
        <span class="shrink-0 inline-flex items-center gap-2 self-start sm:self-auto px-6 py-3.5 bg-paper text-neutral-900 text-sm font-semibold group-hover:bg-white transition-colors">
          Abrir calculadora
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </span>
      </a>
    </section>
  )}

  {categorySlug === 'omega-3-y-aceite-de-salmon' && (
    <section class="mb-12" id="banner-calculadora">
      <a
        href="/calculadora-dosis-omega-3-perros/"
        class="group flex flex-col sm:flex-row sm:items-center gap-5 bg-navy-800 text-white px-6 py-7 md:px-10"
      >
        <div class="flex-grow">
          <h2 class="font-serif text-2xl md:text-3xl font-semibold text-white leading-snug group-hover:underline decoration-1 underline-offset-4">
            Calculadora de dosis de omega-3
          </h2>
          <p class="text-[15px] text-white/70 mt-2 max-w-2xl leading-relaxed">
            Introduce el peso de tu perro y el % de EPA+DHA de tu aceite: te decimos cuántos ml al día
            hacen falta para la dosis estudiada en artrosis y cuántas calorías suma.
          </p>
        </div>
        <span class="shrink-0 inline-flex items-center gap-2 self-start sm:self-auto px-6 py-3.5 bg-paper text-neutral-900 text-sm font-semibold group-hover:bg-white transition-colors">
          Abrir calculadora
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </span>
      </a>
    </section>
  )}

  {categorySlug === 'incontinencia' && (
    <section class="mb-12" id="banner-calculadora">
      <a
        href="/calculadora-talla-panal-perros/"
        class="group flex flex-col sm:flex-row sm:items-center gap-5 bg-navy-800 text-white px-6 py-7 md:px-10"
      >
        <div class="flex-grow">
          <h2 class="font-serif text-2xl md:text-3xl font-semibold text-white leading-snug group-hover:underline decoration-1 underline-offset-4">
            Calculadora de talla de pañal
          </h2>
          <p class="text-[15px] text-white/70 mt-2 max-w-2xl leading-relaxed">
            Mide la cintura de tu perro y te decimos qué talla pedir de cada pañal y faja de esta sección:
            cada marca usa sus propios centímetros.
          </p>
        </div>
        <span class="shrink-0 inline-flex items-center gap-2 self-start sm:self-auto px-6 py-3.5 bg-paper text-neutral-900 text-sm font-semibold group-hover:bg-white transition-colors">
          Abrir calculadora
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </span>
      </a>
    </section>
  )}

  {categorySlug === 'bozales' && (
    <section class="mb-12" id="banner-calculadora">
      <a
        href="/calculadora-talla-bozal-perros/"
        class="group flex flex-col sm:flex-row sm:items-center gap-5 bg-navy-800 text-white px-6 py-7 md:px-10"
      >
        <div class="flex-grow">
          <h2 class="font-serif text-2xl md:text-3xl font-semibold text-white leading-snug group-hover:underline decoration-1 underline-offset-4">
            Calculadora de talla de bozal
          </h2>
          <p class="text-[15px] text-white/70 mt-2 max-w-2xl leading-relaxed">
            Mide perímetro y longitud del hocico y obtén la talla orientativa (cesta o silicona). El
            bozal debe permitir jadear y beber: nunca elijas una talla más pequeña «por si acaso».
          </p>
        </div>
        <span class="shrink-0 inline-flex items-center gap-2 self-start sm:self-auto px-6 py-3.5 bg-paper text-neutral-900 text-sm font-semibold group-hover:bg-white transition-colors">
          Abrir calculadora
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </span>
      </a>
    </section>
  )}

  {categorySlug === 'rampas' && (
    <section class="mb-12" id="banner-calculadora">
      <a
        href="/calculadora-medida-rampa-perros/"
        class="group flex flex-col sm:flex-row sm:items-center gap-5 bg-navy-800 text-white px-6 py-7 md:px-10"
      >
        <div class="flex-grow">
          <h2 class="font-serif text-2xl md:text-3xl font-semibold text-white leading-snug group-hover:underline decoration-1 underline-offset-4">
            Calculadora de medida de rampa
          </h2>
          <p class="text-[15px] text-white/70 mt-2 max-w-2xl leading-relaxed">
            Calcula la longitud mínima según la altura del sofá, cama o maletero y el peso del perro.
            Si pide más de 200 cm, te recomendamos escalera de peldaños.
          </p>
        </div>
        <span class="shrink-0 inline-flex items-center gap-2 self-start sm:self-auto px-6 py-3.5 bg-paper text-neutral-900 text-sm font-semibold group-hover:bg-white transition-colors">
          Abrir calculadora
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </span>
      </a>
    </section>
  )}

  {categorySlug === 'camas-ortopedicas' && (
    <section class="mb-12" id="banner-calculadora">
      <a
        href="/calculadora-talla-cama-ortopedica-perros/"
        class="group flex flex-col sm:flex-row sm:items-center gap-5 bg-navy-800 text-white px-6 py-7 md:px-10"
      >
        <div class="flex-grow">
          <h2 class="font-serif text-2xl md:text-3xl font-semibold text-white leading-snug group-hover:underline decoration-1 underline-offset-4">
            Calculadora de talla de cama
          </h2>
          <p class="text-[15px] text-white/70 mt-2 max-w-2xl leading-relaxed">
            Cómo medir a tu perro para la cama: hocico a cola, talla de largo +30 cm, ancho según postura
            y grosor de espuma. Mejor pasarse de talla que quedarse corto.
          </p>
        </div>
        <span class="shrink-0 inline-flex items-center gap-2 self-start sm:self-auto px-6 py-3.5 bg-paper text-neutral-900 text-sm font-semibold group-hover:bg-white transition-colors">
          Abrir calculadora
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </span>
      </a>
    </section>
  )}

  {(categorySlug === 'correas' || categorySlug === 'arneses') && (
    <section class="mb-12" id="banner-calculadora">
      <a
        href="/calculadora-talla-arnes-collar-perros/"
        class="group flex flex-col sm:flex-row sm:items-center gap-5 bg-navy-800 text-white px-6 py-7 md:px-10"
      >
        <div class="flex-grow">
          <h2 class="font-serif text-2xl md:text-3xl font-semibold text-white leading-snug group-hover:underline decoration-1 underline-offset-4">
            Calculadora de talla de arnés o collar
          </h2>
          <p class="text-[15px] text-white/70 mt-2 max-w-2xl leading-relaxed">
            Cómo medir a tu perro para arnés o collar: perímetro de cuello y de pecho, más el peso
            para comprobar. El pecho manda en el arnés; el cuello, en el collar.
          </p>
        </div>
        <span class="shrink-0 inline-flex items-center gap-2 self-start sm:self-auto px-6 py-3.5 bg-paper text-neutral-900 text-sm font-semibold group-hover:bg-white transition-colors">
          Abrir calculadora
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </span>
      </a>
    </section>
  )}

  {categorySlug === 'alimentacion-especifica' && (
    <section class="mb-12" id="banner-calculadora">
      <a
        href="/calculadora-racion-pienso-renal-perros/"
        class="group flex flex-col sm:flex-row sm:items-center gap-5 bg-navy-800 text-white px-6 py-7 md:px-10"
      >
        <div class="flex-grow">
          <h2 class="font-serif text-2xl md:text-3xl font-semibold text-white leading-snug group-hover:underline decoration-1 underline-offset-4">
            Calculadora de ración de pienso renal
          </h2>
          <p class="text-[15px] text-white/70 mt-2 max-w-2xl leading-relaxed">
            Gramos diarios de pienso renal seco según peso y actividad. La pauta la marca el
            veterinario: aquí solo se orienta la cantidad, nunca si el pienso es adecuado.
          </p>
        </div>
        <span class="shrink-0 inline-flex items-center gap-2 self-start sm:self-auto px-6 py-3.5 bg-paper text-neutral-900 text-sm font-semibold group-hover:bg-white transition-colors">
          Abrir calculadora
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </span>
      </a>
    </section>
  )}

  <div class="section-rule mb-6 flex flex-wrap items-baseline justify-between gap-3">
    <h2 class="font-serif text-3xl md:text-[2.4rem] font-semibold text-neutral-900 tracking-tight">
      {filteredArticulos.length} {filteredArticulos.length === 1 ? 'opción analizada' : 'opciones analizadas'}
    </h2>
    <p class="text-sm text-neutral-500 hidden sm:block">Filtra y compara abajo. Cada ficha incluye análisis propio.</p>
  </div>

  <SearchableGrid
    client:load
    articulos={publicArticulos}
    initialCategory={problemSection ? null : category}
    initialSectionSlug={sectionSlug}
  />

  {relatedBlogs.length > 0 && (
    <section class="mt-20">
      <div class="section-rule mb-4">
        <h2 class="font-serif text-3xl md:text-[2.4rem] font-semibold text-neutral-900 tracking-tight">Guías relacionadas</h2>
      </div>
      <ul class="grid sm:grid-cols-2 xl:grid-cols-3 gap-x-12">
        {relatedBlogs.map((b) => (
          <li class="border-b border-neutral-300">
            <a href={`/blog/${b.slug}/`} class="block py-5 font-serif text-xl leading-snug font-medium text-neutral-900 hover:underline decoration-1 underline-offset-4">{b.titulo}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Layout>
