---
import Layout from '../../layouts/Layout.astro';
import SearchableGrid from '../../components/SearchableGrid';
import { getCollection } from 'astro:content';
import { slugify } from '../../utils/slugify';
import { itemListSchema, breadcrumbSchema, collectionPageSchema } from '../../utils/seo';
import { problemSections, productInPrimarySection, getCategoryGuide, getCategorySeo } from '../../utils/problemSections';
import { blogsForCategory } from '../../utils/blogProductLinks';

export async function getStaticPaths() {
  const articulos = await getCollection('articulos');
  const categories = Array.from(
    new Set(articulos.map((a) => a.data.categoria).filter(Boolean) as string[])
  );

  const categoryPaths = categories.map((category) => ({
    params: { slug: slugify(category) },
    props: { category, categories, sectionSlug: null },
  }));

  const problemPaths = problemSections.map((section) => ({
    params: { slug: section.slug },
    props: { category: section.name, categories, sectionSlug: section.slug },
  }));

  return [...categoryPaths, ...problemPaths];
}

const { category, categories, sectionSlug } = Astro.props;
const allArticulos = await getCollection('articulos');
const publicArticulos = allArticulos.map((art) => ({
  ...art,
  data: {
    ...art.data,
    linkAmazon: '',
  },
}));
const problemSection = problemSections.find((section) => section.slug === sectionSlug);
const filteredArticulos = problemSection
  ? allArticulos.filter((a) => productInPrimarySection(a, problemSection))
  : allArticulos.filter(a => a.data.categoria === category);

const categorySlug = problemSection?.slug ?? slugify(category);
const categoryUrl = `/categoria/${categorySlug}`;
const categoryListJsonLd = itemListSchema(
  filteredArticulos.map((a) => ({
    name: a.data.nombre,
    url: `/producto/${a.data.slug || slugify(a.data.nombre)}`,
    image: a.data.imagen,
  })),
  category
);
const categoryBreadcrumbJsonLd = breadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: category, url: categoryUrl },
]);
const categoryPageJsonLd = collectionPageSchema({
  name: category,
  description: `Productos para perros en la categoría ${category.toLowerCase()}.`,
  url: categoryUrl,
  numberOfItems: filteredArticulos.length,
});
const categoryDescription = problemSection?.description ??
  `Selección curada de ${filteredArticulos.length} ${filteredArticulos.length === 1 ? 'producto' : 'productos'} para ${category.toLowerCase()}: comparativa, precios y reseñas verificadas.`;

const categoryGuide = problemSection
  ? {
      problema: problemSection.problema,
      cuandoConviene: problemSection.cuandoConviene,
      queMirar: problemSection.queMirar,
    }
  : getCategoryGuide(category);
const hasGuide = Boolean(
  categoryGuide && (categoryGuide.problema || categoryGuide.cuandoConviene || categoryGuide.queMirar)
);
// Títol/descripció SEO propis (només per a categories reals; les problemSection mantenen els seus).
const seo = getCategorySeo(category);
// Guies de blog relacionades amb aquesta categoria (clúster intern categoria↔blog).
const relatedBlogs = blogsForCategory(category);
---

<Layout
  title={seo?.title ?? category}
  description={seo?.description ?? categoryDescription}
  categories={categories}
  jsonLd={[categoryPageJsonLd, categoryListJsonLd, categoryBreadcrumbJsonLd]}
>
  <div class="mb-10">
    <nav aria-label="Breadcrumb" class="flex mb-4 text-xs font-medium text-neutral-400 gap-2 items-center">
      <a href="/" class="hover:text-primary-600 transition-colors">Inicio</a>
      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      <span class="text-neutral-900">{category}</span>
    </nav>
    
    <div class="border-b border-neutral-200 pb-4">
      <h1 class="text-3xl md:text-4xl font-serif font-black text-neutral-900 mb-2">
        {category}
      </h1>
      <p class="text-neutral-500 text-sm">
        {problemSection?.description ?? `Selección curada de ${filteredArticulos.length} ${filteredArticulos.length === 1 ? 'producto' : 'productos'} para ${category.toLowerCase()}.`}
      </p>
    </div>
  </div>

  {hasGuide && categoryGuide && (
    <section class="mb-12 grid gap-6 md:grid-cols-3 md:gap-8">
      {categoryGuide.problema && (
        <div class="md:col-span-3 bg-white border border-neutral-200 rounded-2xl p-6 md:p-8">
          <p class="text-xs font-bold uppercase tracking-wide text-primary-600 mb-2">El problema en breve</p>
          <p class="text-neutral-700 leading-relaxed text-base">
            {categoryGuide.problema}
          </p>
        </div>
      )}
      {categoryGuide.cuandoConviene && categoryGuide.cuandoConviene.length > 0 && (
        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 md:col-span-1">
          <p class="text-xs font-bold uppercase tracking-wide text-amber-700 mb-3">Cuándo conviene plantearse algo</p>
          <ul class="space-y-2 text-sm text-amber-900">
            {categoryGuide.cuandoConviene.map((item) => (
              <li class="flex gap-2"><span class="text-amber-500 mt-0.5">•</span><span>{item}</span></li>
            ))}
          </ul>
        </div>
      )}
      {categoryGuide.queMirar && categoryGuide.queMirar.length > 0 && (
        <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-6 md:col-span-2">
          <p class="text-xs font-bold uppercase tracking-wide text-emerald-700 mb-3">Qué mirar antes de comprar</p>
          <ul class="space-y-2 text-sm text-emerald-900">
            {categoryGuide.queMirar.map((item) => (
              <li class="flex gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>{item}</span></li>
            ))}
          </ul>
        </div>
      )}
    </section>
  )}

  {categorySlug === 'condroprotectores' && (
    <section class="mb-12" id="banner-calculadora">
      <a
        href="/calculadora-dosis-condroprotector-perros"
        class="group flex flex-col sm:flex-row sm:items-center gap-5 rounded-2xl border border-primary-200 bg-gradient-to-r from-primary-50 to-white p-6 md:p-8 hover:border-primary-300 hover:shadow-md transition-all"
      >
        <div class="shrink-0 flex h-14 w-14 items-center justify-center rounded-xl bg-primary-600 text-white shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/></svg>
        </div>
        <div class="flex-grow">
          <p class="text-xs font-bold uppercase tracking-wide text-primary-600 mb-1">Herramienta gratis</p>
          <h2 class="text-xl md:text-2xl font-serif font-black text-neutral-900 leading-snug">
            Calculadora de dosis de condroprotector
          </h2>
          <p class="text-sm text-neutral-600 mt-1 max-w-xl">
            Introduce el peso de tu perro y calcula la dosis diaria de glucosamina, condroitina y MSM que
            debe cubrir el producto. Así no pagas de más por suplementos con dosis bajas.
          </p>
        </div>
        <span class="shrink-0 inline-flex items-center gap-2 self-start sm:self-auto px-5 py-3 bg-primary-600 text-white text-sm font-bold rounded-lg group-hover:bg-primary-700 transition-colors">
          Abrir calculadora
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </span>
      </a>
    </section>
  )}

  <div class="mb-4 flex items-baseline justify-between">
    <h2 class="text-lg font-bold text-neutral-900">
      {filteredArticulos.length} {filteredArticulos.length === 1 ? 'opción analizada' : 'opciones analizadas'}
    </h2>
    <p class="text-xs text-neutral-500 hidden sm:block">Filtra y compara abajo. Cada ficha incluye análisis propio.</p>
  </div>

  <SearchableGrid
    client:load
    articulos={publicArticulos}
    initialCategory={problemSection ? null : category}
    initialSectionSlug={sectionSlug}
  />

  {relatedBlogs.length > 0 && (
    <section class="mt-16 border-t border-neutral-200 pt-10">
      <h2 class="text-lg font-bold text-neutral-900 mb-5">Guías relacionadas</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {relatedBlogs.map((b) => (
          <a
            href={`/blog/${b.slug}`}
            class="group flex items-center justify-between gap-4 rounded-xl border border-neutral-200 bg-white p-4 hover:border-primary-300 hover:shadow-sm transition-all"
          >
            <span class="text-sm font-semibold text-neutral-800 group-hover:text-primary-600 transition-colors">{b.titulo}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-primary-500 transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>
