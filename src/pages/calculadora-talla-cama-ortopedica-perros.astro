---
import Layout from '../layouts/Layout.astro';
import CamaOrtopedicaCalculator from '../components/CamaOrtopedicaCalculator';
import { getCollection } from 'astro:content';
import { slugify } from '../utils/slugify';
import { breadcrumbSchema, faqPageSchema } from '../utils/seo';

const articulos = await getCollection('articulos');
const categories = Array.from(
  new Set(articulos.map((a) => a.data.categoria).filter(Boolean) as string[])
);

const productos = articulos
  .filter((a) => a.data.categoria === 'Camas ortopédicas')
  .map((a) => ({
    slug: a.data.slug || slugify(a.data.nombre),
    titulo: a.data.tituloSeo || a.data.nombre,
    marca: a.data.marca || '',
    precio: a.data.precio || '',
    valoracion: typeof a.data.valoracion === 'number' ? a.data.valoracion : 0,
    imagen: a.data.imagen,
  }))
  .sort((x, y) => y.valoracion - x.valoracion);

const faqs = [
  {
    pregunta: '¿Cómo mido la longitud del perro para la cama?',
    respuesta:
      'Con el perro de pie o tumbado estirado, mide desde la punta del hocico hasta la base de la cola (donde empieza el rabo, sin incluirlo). Anota el resultado en centímetros. La calculadora suma siempre 30 cm de margen al largo, independientemente de cómo duerma.',
  },
  {
    pregunta: '¿Por qué añadir 30 cm de margen?',
    respuesta:
      'Para que pueda estirarse del todo sin que codos o cadera cuelguen. Muchos dueños compran la talla justa y el perro duerme encogido o a medias fuera de la cama. El margen fijo de +30 cm en largo es el mismo criterio que usamos en nuestras guías; la postura solo ajusta el ancho.',
  },
  {
    pregunta: '¿Qué grosor de espuma necesita un perro grande?',
    respuesta:
      'Hasta 15 kg: mínimo 8 cm. Entre 15 y 30 kg: mínimo 10 cm. Más de 30 kg: mínimo 12 cm, ideal 15–19 cm. Por debajo de eso, el perro «toca suelo» y pierde el beneficio ortopédico. Prioriza viscoelástica (memory foam) frente a relleno de bolitas o espuma blanda barata.',
  },
  {
    pregunta: '¿Memory foam o espuma normal?',
    respuesta:
      'Memory foam (viscoelástica) de densidad adecuada reparte el peso y reduce puntos de presión en codos, caderas y columna. La espuma convencional o las bolitas se hunden y dejan que las articulaciones toquen el suelo. Busca funda extraíble y lavable; en senior, impermeable ayuda con escapes leves.',
  },
  {
    pregunta: '¿Cuándo hay que cambiar la cama ortopédica?',
    respuesta:
      'Cuando la espuma no recupera forma (queda el hueco del perro horas después), cuando prefiere el suelo frío a su cama, o cuando se levanta más rígido tras dormir. En perros con artrosis o displasia conviene una cama ortopédica adecuada desde joven, no solo cuando ya hay cojera evidente.',
  },
];

const pageUrl = '/calculadora-talla-cama-ortopedica-perros';
const breadcrumbJsonLd = breadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Calculadora de talla de cama ortopédica', url: pageUrl },
]);
const faqJsonLd = faqPageSchema(faqs);
---

<Layout
  title="Calculadora de talla de cama ortopédica para perros"
  description="Calcula el tamaño mínimo de cama ortopédica y el grosor de espuma según la longitud, el peso y la postura de sueño de tu perro."
  categories={categories}
  jsonLd={[breadcrumbJsonLd, faqJsonLd]}
>
  <div class="mb-8">
    <nav aria-label="Breadcrumb" class="flex mb-4 text-xs font-medium text-neutral-400 gap-2 items-center">
      <a href="/" class="hover:text-primary-600 transition-colors">Inicio</a>
      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      <span class="text-neutral-900">Calculadora de talla de cama ortopédica</span>
    </nav>
    <h1 class="text-3xl md:text-4xl font-serif font-black text-neutral-900 mb-3">
      Calculadora de talla de cama ortopédica para perros
    </h1>
    <p class="text-neutral-600 max-w-2xl leading-relaxed">
      Introduce la <strong>longitud</strong> (morro a base de la cola), el <strong>peso</strong> y la
      <strong>postura</strong> habitual. Te damos las medidas mínimas de cama y el grosor de espuma
      recomendado. El largo suma siempre +30 cm; la postura solo cambia el ancho.
    </p>
  </div>

  <CamaOrtopedicaCalculator client:load productos={productos} />

  <section class="mt-12 prose prose-neutral max-w-2xl">
    <h2 class="text-2xl font-serif font-black text-neutral-900 mb-3">Cómo se calcula el tamaño</h2>
    <p class="text-neutral-700 leading-relaxed">
      El <strong>largo mínimo</strong> es siempre la longitud del perro <strong>+ 30 cm</strong>, redondeado
      al alza a múltiplos de 5. La postura no reduce ese margen: aunque duerma ovillado, puede estirarse
      por la noche.
    </p>

    <table class="w-full text-sm my-6 border-collapse">
      <thead>
        <tr class="border-b-2 border-neutral-200 text-left">
          <th class="py-2 pr-4">Postura</th>
          <th class="py-2 pr-4">Ancho mínimo</th>
          <th class="py-2">Nota</th>
        </tr>
      </thead>
      <tbody class="text-neutral-700">
        <tr class="border-b border-neutral-100"><td class="py-2 pr-4 font-semibold">Estirado</td><td>máx(40, 0,55 × L)</td><td class="text-neutral-500">Más estrecha relativa</td></tr>
        <tr class="border-b border-neutral-100"><td class="py-2 pr-4 font-semibold">De lado</td><td>máx(45, 0,70 × L)</td><td class="text-neutral-500">Más ancha</td></tr>
        <tr><td class="py-2 pr-4 font-semibold">Ovillado</td><td>máx(40, 0,65 × L)</td><td class="text-neutral-500">Intermedio</td></tr>
      </tbody>
    </table>

    <p class="text-neutral-700 leading-relaxed font-semibold mb-2">Grosor de espuma por peso</p>
    <table class="w-full text-sm my-4 border-collapse">
      <thead>
        <tr class="border-b-2 border-neutral-200 text-left">
          <th class="py-2 pr-4">Peso</th>
          <th class="py-2">Grosor mínimo</th>
        </tr>
      </thead>
      <tbody class="text-neutral-700">
        <tr class="border-b border-neutral-100"><td class="py-2 pr-4 font-semibold">≤ 15 kg</td><td>≥ 8 cm</td></tr>
        <tr class="border-b border-neutral-100"><td class="py-2 pr-4 font-semibold">15–30 kg</td><td>≥ 10 cm</td></tr>
        <tr><td class="py-2 pr-4 font-semibold">&gt; 30 kg</td><td>≥ 12 cm (ideal 15–19 cm)</td></tr>
      </tbody>
    </table>

    <p class="text-neutral-700 leading-relaxed">
      Más detalle en
      <a href="/blog/mejores-camas-ortopedicas-perros/" class="text-primary-600 font-semibold hover:underline">camas ortopédicas: guía completa</a>
      y en
      <a href="/blog/camas-ortopedicas-perros-artrosis-displasia/" class="text-primary-600 font-semibold hover:underline">camas para artrosis y displasia</a>.
      Compara fichas en la
      <a href="/categoria/camas-ortopedicas/" class="text-primary-600 font-semibold hover:underline">sección de camas ortopédicas</a>.
    </p>

    <h2 class="text-2xl font-serif font-black text-neutral-900 mt-10 mb-3">Preguntas frecuentes</h2>
    {faqs.map((f) => (
      <div class="mb-5">
        <p class="font-bold text-neutral-900 mb-1">{f.pregunta}</p>
        <p class="text-neutral-700 leading-relaxed text-sm">{f.respuesta}</p>
      </div>
    ))}

    <p class="text-xs text-neutral-400 mt-8 border-t border-neutral-200 pt-4">
      Esta calculadora es orientativa y no sustituye el consejo veterinario. Ante dolor articular,
      displasia o cirugía reciente, consulta a tu veterinario sobre descanso y movilidad.
    </p>
  </section>
</Layout>
