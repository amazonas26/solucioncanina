---
import Layout from '../layouts/Layout.astro';
import CamaOrtopedicaCalculator from '../components/CamaOrtopedicaCalculator';
import { getCollection } from 'astro:content';
import { slugify } from '../utils/slugify';
import { breadcrumbSchema, faqPageSchema } from '../utils/seo';
import { HERRAMIENTAS_PATH } from '../utils/herramientas';
import OtrasHerramientas from '../components/OtrasHerramientas.astro';

const articulos = await getCollection('articulos');
const categories = Array.from(
  new Set(articulos.map((a) => a.data.categoria).filter(Boolean) as string[])
);

const productos = articulos
  .filter((a) => a.data.categoria === 'Camas ortopédicas')
  .map((a) => ({
    slug: a.data.slug || slugify(a.data.nombre),
    titulo: a.data.nombreCorto || a.data.tituloSeo || a.data.nombre,
    marca: a.data.marca || '',
    precio: a.data.precio || '',
    valoracion: typeof a.data.valoracion === 'number' ? a.data.valoracion : 0,
    imagen: a.data.imagen,
  }))
  .sort((x, y) => y.valoracion - x.valoracion);

const faqs = [
  {
    pregunta: '¿Cómo medir a mi perro para la cama?',
    respuesta:
      'Con el perro de pie o tumbado estirado, mide desde la punta del hocico hasta la base de la cola (donde empieza el rabo, sin incluirlo). Anota esa longitud en centímetros: es la cifra que pide la calculadora. El peso sirve para el grosor de espuma, no para la talla de largo. Si estás entre dos tallas comerciales, elige la superior.',
  },
  {
    pregunta: '¿Cómo se pasa esa medida a talla de cama?',
    respuesta:
      'La talla de largo es siempre la longitud del perro + 30 cm, redondeada al alza a múltiplos de 5. La postura (estirado, de lado u ovillado) solo cambia el ancho. Un «L» de un fabricante no equivale al «L» de otro: confirma largo × ancho en la ficha, no te fíes solo de la letra.',
  },
  {
    pregunta: '¿Por qué añadir 30 cm de margen a la talla?',
    respuesta:
      'Para que pueda estirarse del todo sin que codos o cadera cuelguen. Muchos dueños compran la talla justa y el perro duerme encogido o a medias fuera. El margen fijo de +30 cm en largo es el mismo criterio que usamos en nuestras guías; la postura solo ajusta el ancho.',
  },
  {
    pregunta: '¿Qué grosor de espuma necesita un perro grande?',
    respuesta:
      'Hasta 15 kg: mínimo 8 cm. Entre 15 y 30 kg: mínimo 10 cm. Más de 30 kg: mínimo 12 cm, ideal 15–19 cm. Por debajo de eso, el perro «toca suelo». Prioriza viscoelástica (memory foam) frente a relleno de bolitas o espuma blanda barata.',
  },
  {
    pregunta: '¿Si duerme ovillado puedo bajar de talla?',
    respuesta:
      'No. Aunque se enrolle de día, puede estirarse de noche. La calculadora mantiene el largo +30 cm en las tres posturas; ovillado solo mueve el ancho a un punto intermedio. Bajar de talla es el error que deja la cadera fuera del colchón.',
  },
];

const pageUrl = '/calculadora-talla-cama-ortopedica-perros/';
const breadcrumbJsonLd = breadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Herramientas', url: HERRAMIENTAS_PATH },
  { name: 'Talla de cama', url: pageUrl },
]);
const faqJsonLd = faqPageSchema(faqs);
---

<Layout
  title="Calculadora de talla de cama para perros (cómo medir a tu perro)"
  description="Mide a tu perro de hocico a cola y obtén la talla de cama: largo mínimo (+30 cm), ancho según postura y grosor de espuma. Cómo medir a tu perro para la cama, paso a paso."
  categories={categories}
  jsonLd={[breadcrumbJsonLd, faqJsonLd]}
>
  <div class="mb-8">
    <nav aria-label="Breadcrumb" class="flex mb-4 text-xs font-medium text-neutral-400 gap-2 items-center flex-wrap">
      <a href="/" class="hover:text-primary-600 transition-colors">Inicio</a>
      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      <a href="/herramientas/" class="hover:text-primary-600 transition-colors">Herramientas</a>
      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      <span class="text-neutral-900">Talla de cama</span>
    </nav>
    <h1 class="text-3xl md:text-4xl font-serif font-black text-neutral-900 mb-3">
      Calculadora de talla de cama para perros
    </h1>
    <p class="text-neutral-600 max-w-2xl leading-relaxed">
      <strong>Cómo medir a tu perro para la cama:</strong> de la <strong>punta del hocico a la base de la cola</strong>,
      más el <strong>peso</strong> y la <strong>postura</strong> habitual. Te damos la <strong>talla</strong> mínima
      (largo +30 cm; el ancho cambia con cómo duerma) y el grosor de espuma. Así no compras a ojo la talla de abajo.
    </p>
  </div>

  <CamaOrtopedicaCalculator client:load productos={productos} />

  <section class="mt-12 prose prose-neutral max-w-2xl">
    <h2 class="text-2xl font-serif font-black text-neutral-900 mb-3">Cómo medir a tu perro para la cama</h2>
    <p class="text-neutral-700 leading-relaxed">
      Cómo medir a tu perro para la cama no es adivinar una S/M/L en la ficha: es una <strong>medida en centímetros</strong>
      y un margen fijo. Cuatro pasos:
    </p>
    <ol class="text-neutral-700 leading-relaxed space-y-2 my-4 pl-5 list-decimal">
      <li>
        Con el perro de pie o tumbado estirado, <strong>mide</strong> desde la punta del hocico hasta la base de la cola,
        sin incluir el rabo. Anota los centímetros: esa es la longitud.
      </li>
      <li>
        El peso no cambia la talla de largo: sirve para el grosor de espuma. Usa la última cifra del veterinario si no
        tienes báscula.
      </li>
      <li>
        Observa cómo duerme (estirado, de lado u ovillado). La postura solo ajusta el <strong>ancho</strong>; el largo
        siempre lleva +30 cm por si se estira de noche.
      </li>
      <li>
        Introduce longitud, peso y postura. La calculadora convierte esa medida en <strong>talla de cama</strong>,
        redondeada al alza a múltiplos de 5.
      </li>
    </ol>

    <h2 class="text-2xl font-serif font-black text-neutral-900 mt-10 mb-3">Cómo se calcula la talla</h2>
    <p class="text-neutral-700 leading-relaxed">
      El <strong>largo mínimo</strong> es siempre la longitud del perro <strong>+ 30 cm</strong>, redondeado
      al alza a múltiplos de 5. La postura no reduce ese margen: aunque duerma ovillado, puede estirarse
      por la noche. Si dudas entre dos tallas comerciales, quédate con la grande.
    </p>

    <table class="w-full text-sm my-6 border-collapse">
      <thead>
        <tr class="border-b-2 border-neutral-200 text-left">
          <th class="py-2 pr-4">Talla habitual</th>
          <th class="py-2 pr-4">Largo mínimo de cama</th>
          <th class="py-2">Cómo medir (longitud del perro)</th>
        </tr>
      </thead>
      <tbody class="text-neutral-700">
        <tr class="border-b border-neutral-100"><td class="py-2 pr-4 font-semibold">S</td><td>60–70 cm</td><td class="text-neutral-500">30–40 cm (hocico–cola)</td></tr>
        <tr class="border-b border-neutral-100"><td class="py-2 pr-4 font-semibold">M</td><td>75–90 cm</td><td class="text-neutral-500">45–60 cm</td></tr>
        <tr class="border-b border-neutral-100"><td class="py-2 pr-4 font-semibold">L</td><td>95–110 cm</td><td class="text-neutral-500">65–80 cm</td></tr>
        <tr><td class="py-2 pr-4 font-semibold">XL</td><td>115–130 cm</td><td class="text-neutral-500">85–100 cm</td></tr>
      </tbody>
    </table>

    <p class="text-neutral-700 leading-relaxed font-semibold mb-2">Ancho según postura</p>
    <table class="w-full text-sm my-4 border-collapse">
      <thead>
        <tr class="border-b-2 border-neutral-200 text-left">
          <th class="py-2 pr-4">Postura</th>
          <th class="py-2 pr-4">Ancho mínimo</th>
          <th class="py-2">Nota</th>
        </tr>
      </thead>
      <tbody class="text-neutral-700">
        <tr class="border-b border-neutral-100"><td class="py-2 pr-4 font-semibold">Estirado</td><td>máx(40, 0,55 × L)</td><td class="text-neutral-500">Más estrecha relativa</td></tr>
        <tr class="border-b border-neutral-100"><td class="py-2 pr-4 font-semibold">De lado</td><td>máx(45, 0,70 × L)</td><td class="text-neutral-500">Más ancha</td></tr>
        <tr><td class="py-2 pr-4 font-semibold">Ovillado</td><td>máx(40, 0,65 × L)</td><td class="text-neutral-500">Intermedio</td></tr>
      </tbody>
    </table>

    <p class="text-neutral-700 leading-relaxed font-semibold mb-2">Grosor de espuma por peso</p>
    <table class="w-full text-sm my-4 border-collapse">
      <thead>
        <tr class="border-b-2 border-neutral-200 text-left">
          <th class="py-2 pr-4">Peso</th>
          <th class="py-2">Grosor mínimo</th>
        </tr>
      </thead>
      <tbody class="text-neutral-700">
        <tr class="border-b border-neutral-100"><td class="py-2 pr-4 font-semibold">≤ 15 kg</td><td>≥ 8 cm</td></tr>
        <tr class="border-b border-neutral-100"><td class="py-2 pr-4 font-semibold">15–30 kg</td><td>≥ 10 cm</td></tr>
        <tr><td class="py-2 pr-4 font-semibold">&gt; 30 kg</td><td>≥ 12 cm (ideal 15–19 cm)</td></tr>
      </tbody>
    </table>

    <p class="text-xs text-neutral-500 leading-relaxed mt-2">
      <strong>Nota:</strong> cada fabricante numera distinto (un «L» de 90 cm no equivale a un «L» de 110 cm).
      Usa la tabla de talla como orientación y confirma largo × ancho reales en la ficha del producto.
    </p>

    <p class="text-neutral-700 leading-relaxed">
      El criterio de talla y espuma está desarrollado en
      <a href="/blog/mejores-camas-ortopedicas-perros/" class="text-primary-600 font-semibold hover:underline">camas ortopédicas: guía completa</a>
      y en
      <a href="/blog/camas-ortopedicas-perros-artrosis-displasia/" class="text-primary-600 font-semibold hover:underline">camas para artrosis y displasia</a>.
      Cuando tengas la talla, compara fichas en la
      <a href="/categoria/camas-ortopedicas/" class="text-primary-600 font-semibold hover:underline">sección de camas analizadas</a>.
    </p>

    <h2 class="text-2xl font-serif font-black text-neutral-900 mt-10 mb-3">Preguntas frecuentes</h2>
    {faqs.map((f) => (
      <div class="mb-5">
        <p class="font-bold text-neutral-900 mb-1">{f.pregunta}</p>
        <p class="text-neutral-700 leading-relaxed text-sm">{f.respuesta}</p>
      </div>
    ))}

    <p class="text-xs text-neutral-400 mt-8 border-t border-neutral-200 pt-4">
      Método y fuentes:
      <a href="/como-analizamos/#fuentes" class="text-primary-600 font-semibold hover:underline">cómo analizamos</a>.
      Esta calculadora es orientativa y no sustituye el consejo veterinario. Ante dolor articular,
      displasia o cirugía reciente, consulta a tu veterinario sobre descanso y movilidad.
    </p>
  </section>

  <OtrasHerramientas currentPath={pageUrl} />
</Layout>
