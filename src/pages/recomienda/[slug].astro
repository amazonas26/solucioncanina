---
import { getCollection } from "astro:content";
import { slugify } from "../../utils/slugify";

export async function getStaticPaths() {
  const articulos = await getCollection("articulos");

  return articulos.map((articulo) => ({
    params: { slug: articulo.data.slug || slugify(articulo.data.nombre) },
    props: {
      target: articulo.data.linkAmazon,
      nombre: articulo.data.nombreCorto || articulo.data.nombre,
      slug: articulo.data.slug || slugify(articulo.data.nombre),
      categoria: articulo.data.categoria || "",
      precio: articulo.data.precio || "",
    },
  }));
}

const { target, nombre, slug, categoria, precio } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link
      rel="preload"
      href="/fonts/libre-franklin-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>Te llevamos a Amazon…</title>
    <style is:inline>
      @font-face {
        font-family: "Libre Franklin";
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url("/fonts/libre-franklin-latin.woff2") format("woff2");
      }
      @font-face {
        font-family: "Newsreader";
        font-style: normal;
        font-weight: 200 800;
        font-display: swap;
        src: url("/fonts/newsreader-latin.woff2") format("woff2");
      }

      :root {
        --primary: #2a6557;
        --primary-600: #225347;
        --primary-50: #ecf4f1;
        --navy: #1b1916;
        --neutral-50: #f7f4ee;
        --neutral-200: #dcd5c8;
        --neutral-500: #73695b;
        --neutral-700: #423c34;
        --neutral-900: #1b1916;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
      }

      body {
        font-family: "Libre Franklin", "Helvetica Neue", Arial, sans-serif;
        color: var(--neutral-900);
        background: var(--neutral-50);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
      }

      .card {
        width: 100%;
        max-width: 26rem;
        text-align: center;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 1.75rem;
        text-decoration: none;
        color: inherit;
      }

      .brand img {
        width: 2.25rem;
        height: 2.25rem;
      }

      .brand-name {
        font-size: 1.05rem;
        font-weight: 800;
        letter-spacing: -0.02em;
      }

      .brand-name span {
        color: var(--primary);
      }

      .spinner {
        width: 2rem;
        height: 2rem;
        margin: 0 auto 1.25rem;
        border: 2.5px solid var(--neutral-200);
        border-top-color: var(--primary);
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
      }

      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }

      h1 {
        margin: 0 0 0.5rem;
        font-family: "Newsreader", Georgia, serif;
        font-size: 1.6rem;
        font-weight: 600;
        line-height: 1.3;
        color: var(--neutral-900);
      }

      .product {
        margin: 0 0 1.5rem;
        font-size: 0.9rem;
        line-height: 1.45;
        color: var(--neutral-700);
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .fallback {
        margin: 0;
        font-size: 0.8rem;
        color: var(--neutral-500);
      }

      .fallback a {
        color: var(--primary-600);
        font-weight: 700;
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .fallback a:hover {
        color: var(--navy);
      }

      @media (prefers-reduced-motion: reduce) {
        .spinner {
          animation: none;
          border-top-color: var(--neutral-200);
          border-right-color: var(--primary);
        }
      }
    </style>
    <script is:inline define:vars={{ target, slug, categoria, precio }}>
      (function () {
        var GA_ID = "G-FH339B1P51";
        var done = false;
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        window.gtag = gtag;

        function go() {
          if (done) return;
          done = true;
          window.location.replace(target);
        }

        function trackAndRedirect() {
          gtag("js", new Date());
          gtag("config", GA_ID, { send_page_view: false });
          gtag("event", "click_afiliado", {
            slug: slug,
            categoria: categoria,
            precio: precio,
            referrer: document.referrer || "",
            transport_type: "beacon",
          });
          setTimeout(go, 0);
        }

        // Sin consentimiento de cookies analíticas no se carga GA: redirección directa.
        var consent = null;
        try { consent = localStorage.getItem("sc_cookie_consent"); } catch (e) {}
        if (consent !== "accepted") {
          go();
          return;
        }

        var s = document.createElement("script");
        s.async = true;
        s.src = "https://www.googletagmanager.com/gtag/js?id=" + GA_ID;
        s.onload = trackAndRedirect;
        s.onerror = go;
        setTimeout(go, 1200); // watchdog: Amazon sí o sí ≤1,2s
        document.head.appendChild(s);
      })();
    </script>
  </head>
  <body>
    <main class="card">
      <a class="brand" href="/" aria-label="Solución Canina">
        <img src="/logo.png" alt="" width="36" height="36" />
        <span class="brand-name">Solución<span>Canina</span></span>
      </a>

      <div class="spinner" role="status" aria-label="Cargando"></div>

      <h1>Te llevamos a Amazon…</h1>
      <p class="product">{nombre}</p>

      <p class="fallback">
        Si no redirige automáticamente,
        <a href={target} rel="sponsored nofollow noopener noreferrer">Continuar</a>.
      </p>
    </main>
  </body>
</html>
