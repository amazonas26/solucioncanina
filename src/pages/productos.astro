---
import Layout from "../layouts/Layout.astro";
import SearchableGrid from "../components/SearchableGrid";
import { getCollection } from "astro:content";
import { slugify } from "../utils/slugify";
import { itemListSchema, collectionPageSchema } from "../utils/seo";

const articulos = await getCollection("articulos");
const publicArticulos = articulos.map((art) => ({
  ...art,
  data: {
    ...art.data,
    linkAmazon: "",
  },
}));

const categories = Array.from(
  new Set(articulos.map((a) => a.data.categoria).filter(Boolean) as string[]),
);

const catalogJsonLd = itemListSchema(
  articulos.map((a) => ({
    name: a.data.nombreCorto || a.data.nombre,
    url: `/producto/${a.data.slug || slugify(a.data.nombre)}/`,
    image: a.data.imagen,
  })),
  "Catálogo completo de productos para perros"
);
const catalogPageJsonLd = collectionPageSchema({
  name: "Catálogo de productos para perros",
  description: "Catálogo completo de productos para perros: alimentación, accesorios, salud y juguetes.",
  url: "/productos/",
  numberOfItems: articulos.length,
});
---

<Layout
  title="Catálogo de productos para perros"
  description="Todos los productos para perros que hemos analizado: camas ortopédicas, condroprotectores, rampas, bozales, correas y alimentación específica, con precio y valoración de Amazon."
  categories={categories}
  jsonLd={[catalogPageJsonLd, catalogJsonLd]}
>
  <div class="mb-6 md:mb-10">
    <header class="border-b border-neutral-900 pb-6 mb-8">
      <h1 class="font-serif text-4xl md:text-6xl font-semibold tracking-tight text-neutral-900">Todos los productos</h1>
      <p class="mt-3 font-serif text-xl text-neutral-700 max-w-3xl">
        {publicArticulos.length} productos analizados, ordenados por necesidad y por tipo. Cada ficha explica para qué perro sirve y para cuál no.
      </p>
    </header>

    <div id="articulos">
      <SearchableGrid client:load articulos={publicArticulos} />
    </div>
  </div>
</Layout>
