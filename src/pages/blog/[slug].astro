---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  
  // Categorías de artículos para el Header
  const articulos = await getCollection('articulos');
  const categories = Array.from(
    new Set(articulos.map((a) => a.data.categoria).filter(Boolean) as string[])
  );

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, categories },
  }));
}

const { post, categories } = Astro.props;
const { Content } = await post.render();

const catLabels = {
  'comportamiento': 'Problemas de comportamiento',
  'guias': 'Guías de Compra Directa',
  'salud': 'Salud e Higiene',
  'alimentacion': 'Alimentación y Curiosidades'
};
const categoryLabel = catLabels[post.data.categoria as keyof typeof catLabels] || 'Blog';
---

<Layout title={`${post.data.titulo} | Blog`} description={post.data.descripcion} categories={categories}>
  <article class="max-w-3xl mx-auto py-8">
    
    {/* Breadcrumbs */}
    <nav class="flex mb-8 text-xs font-medium text-neutral-400 gap-2 items-center flex-wrap">
      <a href="/" class="hover:text-primary-600 transition-colors">Inicio</a>
      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      <a href="/blog" class="hover:text-primary-600 transition-colors">Blog</a>
      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      <span class="text-neutral-900 truncate max-w-[200px] sm:max-w-xs">{categoryLabel}</span>
    </nav>

    {/* Header */}
    <header class="mb-10 text-center">
      <span class="inline-block px-3 py-1 bg-primary-50 text-primary-700 text-xs font-bold uppercase tracking-wider rounded-md mb-4 border border-primary-100">
        {categoryLabel}
      </span>
      <h1 class="text-3xl md:text-5xl font-serif font-black text-neutral-900 leading-tight mb-6">
        {post.data.titulo}
      </h1>
      {post.data.descripcion && (
        <p class="text-lg md:text-xl text-neutral-500 max-w-2xl mx-auto leading-relaxed">
          {post.data.descripcion}
        </p>
      )}
    </header>

    {/* Image */}
    {post.data.imagen && (
      <figure class="mb-12 rounded-2xl overflow-hidden border border-neutral-200 shadow-sm">
        <img 
          src={post.data.imagen} 
          alt={post.data.titulo} 
          class="w-full h-auto aspect-video object-cover"
        />
      </figure>
    )}

    {/* Content */}
    <div class="prose prose-lg prose-neutral mx-auto prose-headings:font-serif prose-headings:font-black prose-a:text-primary-600 prose-img:rounded-xl prose-img:border prose-img:border-neutral-200">
      <Content />
    </div>

    {/* Footer / CTA */}
    <div class="mt-16 pt-8 border-t border-neutral-200 text-center">
      <h3 class="text-xl font-serif font-bold text-neutral-900 mb-4">¿Encontraste lo que buscabas?</h3>
      <p class="text-neutral-500 mb-6">Explora nuestro catálogo completo de soluciones para tu perro.</p>
      <a href="/#articulos" class="inline-flex items-center gap-2 px-8 py-3.5 bg-navy-700 text-white font-bold rounded-xl hover:bg-navy-800 transition-colors shadow-sm">
        Ver todos los productos
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>

  </article>
</Layout>
