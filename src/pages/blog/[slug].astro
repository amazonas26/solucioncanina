---
import Layout from '../../layouts/Layout.astro';
import AffiliateBox from '../../components/AffiliateBox.astro';
import ScrollTable from '../../components/ScrollTable.astro';
import RecursosGuia from '../../components/RecursosGuia.astro';
import Foto from '../../components/Foto.astro';
import FotoCredito from '../../components/FotoCredito.astro';
import BlogHeaderIllustration from '../../components/illustrations/BlogHeaderIllustration.astro';
import DiagramMeasureMuzzle from '../../components/illustrations/diagrams/MeasureMuzzle.astro';
import DiagramMeasureBed from '../../components/illustrations/diagrams/MeasureBed.astro';
import DiagramRampAngle from '../../components/illustrations/diagrams/RampAngle.astro';
import { hasBlogHeader } from '../../components/illustrations/registry';
import { getCollection } from 'astro:content';
import { articleSchema, breadcrumbSchema, faqPageSchema } from '../../utils/seo';
import { relatedProductsForBlog } from '../../utils/blogProductLinks';
import { inlineMarkdownToHtml } from '../../utils/inlineMarkdown';
import { notaPrecios } from '../../utils/precioConsultado';
import { fuentesDe } from '../../utils/fuentes';
import { herramientasPorIds } from '../../utils/herramientas';
import { fotoDe } from '../../utils/fotos';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  const articulos = await getCollection('articulos');
  const categories = Array.from(
    new Set(articulos.map((a) => a.data.categoria).filter(Boolean) as string[])
  );

  return posts.map((post) => {
    const related = posts
      .filter((p) => p.slug !== post.slug && p.data.categoria === post.data.categoria)
      .slice(0, 3)
      .map((p) => ({
        slug: p.slug,
        titulo: p.data.titulo,
        descripcion: p.data.descripcion,
        imagen: p.data.imagen,
        categoria: p.data.categoria,
      }));

    const relatedProducts = relatedProductsForBlog(post, articulos);

    return {
      params: { slug: post.slug },
      props: { post, categories, related, relatedProducts },
    };
  });
}

const { post, categories, related, relatedProducts } = Astro.props;
const { Content, headings } = await post.render();
const herramientas = herramientasPorIds(post.data.calculadoras);
const fotoPortada = fotoDe(post.data.imagen);
const hayRecursos = (relatedProducts?.length ?? 0) > 0 || herramientas.length > 0;
// Índex lateral: els apartats principals (h2), el bloc de productes i calculadores,
// i, si n'hi ha, les preguntes freqüents i les fonts
const toc = [
  ...headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text })),
  ...(hayRecursos ? [{ slug: 'productos-guia', text: (relatedProducts?.length ?? 0) > 0 ? 'Productos de esta guía' : herramientas.length > 1 ? 'Calculadoras' : 'Calculadora' }] : []),
  ...(post.data.faqs && post.data.faqs.length > 0 ? [{ slug: 'preguntas-frecuentes', text: 'Preguntas frecuentes' }] : []),
  ...(post.data.fuentes && post.data.fuentes.length > 0 ? [{ slug: 'fuentes', text: 'Fuentes' }] : []),
];
const fuentes = fuentesDe(post.data.fuentes, `blog/${post.slug}`);
const notaRelatedProducts = notaPrecios((relatedProducts ?? []).map((p) => p.slug));

const catLabels = {
  'comportamiento': 'Problemas de comportamiento',
  'guias': 'Guías de compra',
  'salud': 'Salud e higiene',
  'alimentacion': 'Alimentación'
};
const categoryLabel = catLabels[post.data.categoria as keyof typeof catLabels] || 'Blog';

const postUrl = `/blog/${post.slug}/`;
const fechaPub = post.data.fechaPublicacion ?? new Date();
const fechaMod = post.data.fechaActualizacion ?? fechaPub;
const fechaFmt = new Intl.DateTimeFormat('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
const fechaPubTxt = fechaFmt.format(fechaPub);
const fechaModTxt = fechaFmt.format(fechaMod);
const showUpdated = fechaMod.getTime() !== fechaPub.getTime();

const articleJsonLd = articleSchema({
  title: post.data.titulo,
  description: post.data.descripcion,
  image: post.data.imagen,
  url: postUrl,
  section: categoryLabel,
  author: post.data.autor,
  datePublished: fechaPub.toISOString(),
  dateModified: fechaMod.toISOString(),
  citations: fuentesDe(post.data.fuentes, `blog/${post.slug}`).map((f) => ({ name: f.titulo, url: f.url })),
});
const breadcrumbJsonLd = breadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: post.data.titulo, url: postUrl },
]);
const faqJsonLd = post.data.faqs && post.data.faqs.length > 0
  ? faqPageSchema(post.data.faqs)
  : null;
const allBlogJsonLd = faqJsonLd
  ? [articleJsonLd, breadcrumbJsonLd, faqJsonLd]
  : [articleJsonLd, breadcrumbJsonLd];
---

<Layout
  title={post.data.tituloSeo ?? post.data.titulo}
  description={post.data.descripcionSeo ?? post.data.descripcion}
  image={post.data.imagen}
  type="article"
  jsonLd={allBlogJsonLd}
  categories={categories}
>
  <article>
    <nav aria-label="Breadcrumb" class="flex mb-8 text-sm text-neutral-500 gap-2 items-center flex-wrap">
      <a href="/" class="hover:text-neutral-900 hover:underline underline-offset-4">Inicio</a>
      <span class="text-neutral-300">/</span>
      <a href="/blog/" class="hover:text-neutral-900 hover:underline underline-offset-4">Guías</a>
      <span class="text-neutral-300">/</span>
      <span class="text-neutral-800 truncate max-w-[220px] sm:max-w-xs">{categoryLabel}</span>
    </nav>

    <header class="pb-10 border-b border-neutral-900">
      <div class="max-w-5xl">
        <p class="text-sm font-semibold text-clay-600 mb-5">{categoryLabel}</p>
        <h1 class="font-serif text-[clamp(2.3rem,5vw,4.6rem)] font-semibold text-neutral-900 leading-[1.02] tracking-[-0.028em]">
          {post.data.titulo}
        </h1>
        {post.data.descripcion && (
          <p class="mt-6 font-serif text-xl md:text-[1.6rem] text-neutral-700 leading-snug max-w-4xl">
            {post.data.descripcion}
          </p>
        )}
        <p class="mt-7 flex flex-wrap gap-x-5 gap-y-1 text-sm text-neutral-600">
          <span>Por <span class="font-semibold text-neutral-900">{post.data.autor}</span></span>
          <span>Publicado el <time datetime={fechaPub.toISOString()}>{fechaPubTxt}</time></span>
          {showUpdated && (
            <span>Actualizado el <time datetime={fechaMod.toISOString()}>{fechaModTxt}</time></span>
          )}
        </p>
      </div>
    </header>

    {/* Portades tipogràfiques: només a les targetes; aquí només fotos reals */}
    {hasBlogHeader(post.slug) ? null : post.data.imagen ? (
      <figure class="mt-10">
        <img
          src={post.data.imagen}
          alt={fotoPortada?.alt ?? post.data.titulo}
          width="1600"
          height="900"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="w-full aspect-[16/9] lg:aspect-[21/9] object-cover"
        />
        {fotoPortada && (
          <figcaption class="mt-2 text-right"><FotoCredito foto={fotoPortada} /></figcaption>
        )}
      </figure>
    ) : null}

    <div class="mt-10 grid lg:grid-cols-12 gap-x-10 xl:gap-x-14 gap-y-12">
      {/* Índice */}
      {toc.length > 1 && (
        <aside class="hidden lg:block lg:col-span-3">
          <nav class="sticky top-32" aria-label="En esta guía">
            <p class="font-sans text-sm font-bold text-neutral-900 pb-2 border-b-2 border-neutral-900">En esta guía</p>
            <ol class="mt-1">
              {toc.map((h) => (
                <li class="border-b border-neutral-300">
                  <a href={`#${h.slug}`} class="block py-2.5 text-[15px] leading-snug text-neutral-700 hover:text-neutral-900 hover:underline underline-offset-4">{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )}

      {/* Texto */}
      <div class={`min-w-0 ${toc.length > 1 ? 'lg:col-span-9 xl:col-span-7' : 'lg:col-span-9 xl:col-span-7 xl:col-start-3'}`}>
        <div class="prose prose-lg max-w-none [&_table]:max-w-full">
          <Content components={{ AffiliateBox, Foto, DiagramMeasureMuzzle, DiagramMeasureBed, DiagramRampAngle, table: ScrollTable }} />
        </div>

        <RecursosGuia productos={relatedProducts ?? []} herramientas={herramientas} notaPrecios={notaRelatedProducts} />

        {post.data.faqs && post.data.faqs.length > 0 && (
          <section class="mt-16 section-rule" aria-labelledby="preguntas-frecuentes">
            <h2 id="preguntas-frecuentes" class="font-serif text-3xl md:text-4xl font-semibold text-neutral-900 mb-6 tracking-tight scroll-mt-32">
              Preguntas frecuentes
            </h2>
            <div>
              {post.data.faqs.map((faq) => (
                <div class="py-6 border-b border-neutral-300">
                  <h3 class="font-serif text-xl md:text-[1.45rem] font-semibold text-neutral-900 mb-2 leading-snug">{faq.pregunta}</h3>
                  <p class="font-serif text-lg text-neutral-800 leading-relaxed" set:html={inlineMarkdownToHtml(faq.respuesta)} />
                </div>
              ))}
            </div>
          </section>
        )}

        {fuentes.length > 0 && (
          <section class="mt-16 section-rule" aria-labelledby="fuentes">
            <h2 id="fuentes" class="font-serif text-3xl md:text-4xl font-semibold text-neutral-900 tracking-tight scroll-mt-32">
              Fuentes
            </h2>
            <p class="mt-3 text-[15px] text-neutral-600 leading-relaxed max-w-2xl">
              No somos veterinarios: esta guía resume lo que publican estos estudios y organismos.
              Si algo de aquí no coincide con ellos o con tu veterinario, mandan ellos.
              La mayoría de estudios están en inglés.
            </p>
            <ol class="mt-4">
              {fuentes.map((f, i) => (
                <li class="flex gap-4 py-4 border-b border-neutral-300">
                  <span class="font-serif text-xl leading-none text-clay-600 tabular-nums w-6 shrink-0 pt-0.5" aria-hidden="true">{i + 1}</span>
                  <div class="min-w-0">
                    <p class="text-[15px] leading-snug text-neutral-900">
                      <span class="font-semibold">{f.autores}{f.anio ? ` (${f.anio})` : ''}.</span>{' '}
                      <a href={f.url} target="_blank" rel="noopener noreferrer" class="underline decoration-neutral-400 underline-offset-[3px] hover:decoration-neutral-900 break-words">{f.titulo}</a>.{' '}
                      <span class="text-neutral-500">{f.publicacion}.</span>
                    </p>
                    <p class="mt-1 text-sm text-neutral-600 leading-relaxed">{f.nota}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )}
      </div>
    </div>

    {related && related.length > 0 && (
      <section class="mt-20">
        <div class="section-rule mb-8">
          <h2 class="font-serif text-3xl md:text-[2.4rem] font-semibold text-neutral-900 tracking-tight">Sigue leyendo</h2>
        </div>
        <div class="grid sm:grid-cols-3 gap-x-8 gap-y-10">
          {related.map((r) => (
            <a href={`/blog/${r.slug}/`} class="group block">
              {(hasBlogHeader(r.slug) || r.imagen) && (
                <div class="aspect-[16/10] overflow-hidden bg-neutral-100">
                  {hasBlogHeader(r.slug) ? (
                    <BlogHeaderIllustration slug={r.slug} title={r.titulo} decorative />
                  ) : (
                    <img src={r.imagen} alt="" width="600" height="375" loading="lazy" decoding="async" class="w-full h-full object-cover" />
                  )}
                </div>
              )}
              <h3 class="mt-4 font-serif text-[1.45rem] font-semibold text-neutral-900 leading-snug group-hover:underline decoration-1 underline-offset-4">{r.titulo}</h3>
              {r.descripcion && <p class="mt-1.5 text-[15px] text-neutral-600 line-clamp-2 leading-relaxed">{r.descripcion}</p>}
            </a>
          ))}
        </div>
      </section>
    )}

    <p class="mt-16 pt-8 border-t border-neutral-300 text-[15px] text-neutral-700">
      ¿Buscas otra cosa?
      <a href="/productos/" class="font-semibold text-primary-700 underline decoration-primary-300 underline-offset-4 hover:decoration-primary-700">Mira el catálogo por problema</a>
      o <a href="/blog/" class="font-semibold text-primary-700 underline decoration-primary-300 underline-offset-4 hover:decoration-primary-700">el resto de guías</a>.
    </p>
  </article>
</Layout>
