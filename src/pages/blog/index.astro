---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { collectionPageSchema, itemListSchema } from '../../utils/seo';

const posts = await getCollection('blog');

// Categorize posts
const categorias = {
  'comportamiento': 'Problemas de comportamiento',
  'guias': 'Guías de Compra Directa',
  'salud': 'Salud e Higiene',
  'alimentacion': 'Alimentación y Curiosidades'
};

// Group posts by category
const groupedPosts = posts.reduce((acc, post) => {
  const cat = post.data.categoria || 'guias';
  if (!acc[cat]) {
    acc[cat] = [];
  }
  acc[cat].push(post);
  return acc;
}, {} as Record<string, typeof posts>);

// Extraemos las categorías de los artículos (no del blog) para el Layout nav
const articulos = await getCollection('articulos');
const categories = Array.from(
  new Set(articulos.map((a) => a.data.categoria).filter(Boolean) as string[])
);

const blogPageJsonLd = collectionPageSchema({
  name: 'Blog y Guías Caninas',
  description: 'Artículos sobre comportamiento, salud, alimentación y guías de compra para tu perro.',
  url: '/blog',
  numberOfItems: posts.length,
});
const blogListJsonLd = itemListSchema(
  posts.map((p) => ({
    name: p.data.titulo,
    url: `/blog/${p.slug}`,
    image: p.data.imagen,
  })),
  'Artículos del blog'
);
---

<Layout
  title="Blog y Guías Caninas"
  description="Aprende sobre comportamiento, salud y encuentra las mejores guías de compra para tu perro."
  categories={categories}
  jsonLd={[blogPageJsonLd, blogListJsonLd]}
>
  <div class="max-w-5xl mx-auto">
    
    <div class="mb-12 text-center">
      <h1 class="text-4xl md:text-5xl font-serif font-black text-neutral-900 mb-4">Blog y Guías</h1>
      <p class="text-lg text-neutral-500 max-w-2xl mx-auto">Artículos para entender mejor a tu perro y encontrar los productos exactos para solucionar sus problemas del día a día.</p>
    </div>

    {Object.entries(categorias).map(([key, label]) => {
      const categoryPosts = groupedPosts[key] || [];
      if (categoryPosts.length === 0) return null;

      return (
        <section class="mb-20">
          <div class="flex items-center gap-4 mb-8">
            <h2 class="text-2xl font-serif font-black text-neutral-900 tracking-tight flex items-center gap-3 whitespace-nowrap">
              <span class="w-2.5 h-6 bg-gradient-to-b from-primary-400 to-primary-600 rounded-full"></span>
              {label}
            </h2>
            <div class="h-[1px] bg-gradient-to-r from-neutral-200 to-transparent w-full"></div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {categoryPosts.map(post => (
              <a href={`/blog/${post.slug}`} class="group flex flex-col bg-white rounded-2xl overflow-hidden border border-neutral-100 shadow-sm hover:shadow-xl hover:shadow-neutral-200/40 transition-all duration-300 hover:-translate-y-1">
                <div class="aspect-[16/10] w-full bg-neutral-50 overflow-hidden relative">
                  {post.data.imagen ? (
                    <img src={post.data.imagen} alt={post.data.titulo} width="640" height="400" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-neutral-300 bg-neutral-50">
                      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                    </div>
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-neutral-900/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
                  {post.data.nuevo && (
                    <span class="absolute top-3 left-3 z-10 bg-primary-600 text-white text-[11px] font-black uppercase tracking-wide px-2.5 py-1 rounded-full shadow-md">Nuevo</span>
                  )}
                </div>
                <div class="p-6 flex flex-col flex-grow">
                  <h3 class="text-lg font-serif font-black text-neutral-900 mb-2 leading-snug group-hover:text-primary-600 transition-colors line-clamp-2">
                    {post.data.titulo}
                  </h3>
                  {post.data.descripcion && (
                    <p class="text-sm text-neutral-500 line-clamp-3 mb-6 flex-grow leading-relaxed">
                      {post.data.descripcion}
                    </p>
                  )}
                  <div class="mt-auto pt-4 border-t border-neutral-100 flex items-center justify-between text-xs font-bold text-primary-600 uppercase tracking-widest">
                    <span>Leer artículo</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1 duration-300"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      );
    })}

    {posts.length === 0 && (
      <div class="text-center py-20 bg-neutral-50 rounded-xl border border-neutral-200">
        <h3 class="text-lg font-bold text-neutral-900 mb-2">Aún no hay artículos</h3>
        <p class="text-neutral-500 text-sm">Vuelve pronto para descubrir nuevos contenidos.</p>
      </div>
    )}

  </div>
</Layout>
