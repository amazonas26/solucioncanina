---
import Layout from '../../layouts/Layout.astro';
import BlogHeaderIllustration from '../../components/illustrations/BlogHeaderIllustration.astro';
import { hasBlogHeader } from '../../components/illustrations/registry';
import { getCollection } from 'astro:content';
import { collectionPageSchema, itemListSchema } from '../../utils/seo';

const posts = await getCollection('blog');

// Badge «Nuevo»: publicado hace menos de 45 días (se recalcula en cada build).
const NUEVO_DIAS = 45;
const esNuevo = (post: (typeof posts)[number]) => {
  const pub = post.data.fechaPublicacion;
  return !!pub && Date.now() - pub.getTime() < NUEVO_DIAS * 24 * 60 * 60 * 1000;
};

// Categorize posts
const categorias = {
  'comportamiento': 'Problemas de comportamiento',
  'guias': 'Guías de compra',
  'salud': 'Salud e higiene',
  'alimentacion': 'Alimentación'
};

// Group posts by category
const groupedPosts = posts.reduce((acc, post) => {
  const cat = post.data.categoria || 'guias';
  if (!acc[cat]) {
    acc[cat] = [];
  }
  acc[cat].push(post);
  return acc;
}, {} as Record<string, typeof posts>);

// Extraemos las categorías de los artículos (no del blog) para el Layout nav
const articulos = await getCollection('articulos');
const categories = Array.from(
  new Set(articulos.map((a) => a.data.categoria).filter(Boolean) as string[])
);

const blogPageJsonLd = collectionPageSchema({
  name: 'Blog y guías caninas',
  description: 'Artículos sobre comportamiento, salud, alimentación y guías de compra para tu perro.',
  url: '/blog/',
  numberOfItems: posts.length,
});
const blogListJsonLd = itemListSchema(
  posts.map((p) => ({
    name: p.data.titulo,
    url: `/blog/${p.slug}/`,
    image: p.data.imagen,
  })),
  'Artículos del blog'
);
---

<Layout
  title="Blog y guías caninas"
  description="Aprende sobre comportamiento, salud y encuentra las mejores guías de compra para tu perro."
  categories={categories}
  jsonLd={[blogPageJsonLd, blogListJsonLd]}
>
  <div>
    <header class="pb-4">
      <h1 class="font-serif text-5xl md:text-7xl font-semibold tracking-[-0.03em] text-neutral-900">Guías</h1>
      <p class="mt-4 font-serif text-xl md:text-2xl text-neutral-700 max-w-3xl leading-snug">
        {posts.length} artículos para entender qué le pasa a tu perro antes de comprar nada.
      </p>
    </header>

    {Object.entries(categorias).map(([key, label]) => {
      const categoryPosts = groupedPosts[key] || [];
      if (categoryPosts.length === 0) return null;

      return (
        <section class="pt-12">
          <div class="section-rule flex items-baseline justify-between gap-3 mb-8">
            <h2 class="font-serif text-3xl md:text-[2.4rem] font-semibold text-neutral-900 tracking-tight">{label}</h2>
            <span class="text-sm text-neutral-500">{categoryPosts.length} {categoryPosts.length === 1 ? 'guía' : 'guías'}</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 gap-x-8 gap-y-12">
            {categoryPosts.map(post => (
              <a href={`/blog/${post.slug}/`} class="group flex flex-col">
                <div class="aspect-[16/10] w-full bg-neutral-100 overflow-hidden relative">
                  {hasBlogHeader(post.slug) ? (
                    <BlogHeaderIllustration slug={post.slug} title={post.data.titulo} decorative />
                  ) : post.data.imagen ? (
                    <img src={post.data.imagen} alt="" width="640" height="400" loading="lazy" decoding="async" class="w-full h-full object-cover" />
                  ) : null}
                  {esNuevo(post) && (
                    <span class="absolute top-0 left-0 bg-clay-600 text-white text-xs font-semibold px-2.5 py-1">Nuevo</span>
                  )}
                </div>
                <h3 class="mt-4 font-serif text-[1.5rem] font-semibold text-neutral-900 leading-[1.15] tracking-tight group-hover:underline decoration-1 underline-offset-4">
                  {post.data.titulo}
                </h3>
                {post.data.descripcion && (
                  <p class="mt-2 text-[15px] text-neutral-600 line-clamp-3 leading-relaxed">
                    {post.data.descripcion}
                  </p>
                )}
              </a>
            ))}
          </div>
        </section>
      );
    })}

    {posts.length === 0 && (
      <div class="text-center py-20 bg-neutral-50 rounded-xl border border-neutral-200">
        <h3 class="text-lg font-bold text-neutral-900 mb-2">Aún no hay artículos</h3>
        <p class="text-neutral-500 text-sm">Vuelve pronto para descubrir nuevos contenidos.</p>
      </div>
    )}

  </div>
</Layout>
