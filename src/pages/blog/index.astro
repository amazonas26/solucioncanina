---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');

// Categorize posts
const categorias = {
  'comportamiento': 'Problemas de comportamiento',
  'guias': 'Guías de Compra Directa',
  'salud': 'Salud e Higiene',
  'alimentacion': 'Alimentación y Curiosidades'
};

// Group posts by category
const groupedPosts = posts.reduce((acc, post) => {
  const cat = post.data.categoria || 'guias';
  if (!acc[cat]) {
    acc[cat] = [];
  }
  acc[cat].push(post);
  return acc;
}, {} as Record<string, typeof posts>);

// Extraemos las categorías de los artículos (no del blog) para el Layout nav
const articulos = await getCollection('articulos');
const categories = Array.from(
  new Set(articulos.map((a) => a.data.categoria).filter(Boolean) as string[])
);
---

<Layout title="Blog y Guías Caninas" description="Aprende sobre comportamiento, salud y encuentra las mejores guías de compra para tu perro." categories={categories}>
  <div class="max-w-5xl mx-auto">
    
    <div class="mb-12 text-center">
      <h1 class="text-4xl md:text-5xl font-serif font-black text-neutral-900 mb-4">Blog y Guías</h1>
      <p class="text-lg text-neutral-500 max-w-2xl mx-auto">Artículos para entender mejor a tu perro y encontrar los productos exactos para solucionar sus problemas del día a día.</p>
    </div>

    {Object.entries(categorias).map(([key, label]) => {
      const categoryPosts = groupedPosts[key] || [];
      if (categoryPosts.length === 0) return null;

      return (
        <section class="mb-16">
          <div class="border-b border-neutral-200 pb-3 mb-6">
            <h2 class="text-2xl font-serif font-bold text-neutral-900 flex items-center gap-3">
              <span class="w-8 h-1 bg-primary-500 rounded-full"></span>
              {label}
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {categoryPosts.map(post => (
              <a href={`/blog/${post.slug}`} class="group flex flex-col bg-white rounded-xl overflow-hidden border border-neutral-200 shadow-sm hover:shadow-md transition-all hover:-translate-y-1">
                <div class="aspect-[16/9] w-full bg-neutral-100 overflow-hidden relative">
                  {post.data.imagen ? (
                    <img src={post.data.imagen} alt={post.data.titulo} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-neutral-300">
                      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                    </div>
                  )}
                </div>
                <div class="p-5 flex flex-col flex-grow">
                  <h3 class="text-lg font-bold text-neutral-900 mb-2 leading-snug group-hover:text-primary-600 transition-colors font-serif line-clamp-2">
                    {post.data.titulo}
                  </h3>
                  {post.data.descripcion && (
                    <p class="text-sm text-neutral-500 line-clamp-3 mb-4 flex-grow">
                      {post.data.descripcion}
                    </p>
                  )}
                  <div class="mt-auto pt-4 border-t border-neutral-100 flex items-center text-xs font-bold text-primary-600 uppercase tracking-wider">
                    Leer artículo
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ml-1 group-hover:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      );
    })}

    {posts.length === 0 && (
      <div class="text-center py-20 bg-neutral-50 rounded-xl border border-neutral-200">
        <h3 class="text-lg font-bold text-neutral-900 mb-2">Aún no hay artículos</h3>
        <p class="text-neutral-500 text-sm mb-4">Usa Keystatic para añadir tu primer artículo en el blog.</p>
        <a href="/keystatic/collection/blog/create" class="inline-flex items-center justify-center px-4 py-2 bg-navy-700 text-white font-bold text-sm rounded-lg hover:bg-navy-800 transition-colors">
          Escribir un artículo
        </a>
      </div>
    )}

  </div>
</Layout>
