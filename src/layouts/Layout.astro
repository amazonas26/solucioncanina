---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Encuentra los mejores artículos para tu perro en Amazon.' } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-FH339B1P51"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-FH339B1P51');
    </script>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Solución Canina</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800;900&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen flex flex-col bg-mesh selection:bg-primary-500 selection:text-white">
    <header class="sticky top-0 z-50 glass border-b border-white/20">
      <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
        <div class="flex justify-between items-center h-20">
          <a href="/" class="flex items-center gap-3 group">
            <div class="w-10 h-10 bg-primary-600 rounded-xl flex items-center justify-center text-white shadow-lg shadow-primary-500/30 group-hover:scale-110 group-hover:rotate-6 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-dog"><path d="M10 5.172C10 3.782 8.823 2.656 7.415 2.656h-.144C5.863 2.656 4.687 3.782 4.687 5.172v.313c0 1.39 1.176 2.516 2.584 2.516h.144c1.408 0 2.584-1.126 2.584-2.516v-.313Z"/><path d="M14.687 5.172c0-1.39 1.176-2.516 2.584-2.516h.144c1.408 0 2.584 1.126 2.584 2.516v.313c0 1.39-1.176 2.516-2.584 2.516h-.144c-1.408 0-2.584-1.126-2.584-2.516v-.313Z"/><path d="M4 14v1a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3v-1"/><path d="M9 13v-1"/><path d="M15 13v-1"/><path d="M12 9v4"/><path d="M12 17v.01"/><path d="M18 9c.6 0 1 .4 1 1v2c0 .6-.4 1-1 1s-1-.4-1-1v-2c0-.6.4-1 1-1Z"/><path d="M6 9c.6 0 1 .4 1 1v2c0 .6-.4 1-1 1s-1-.4-1-1v-2c0-.6.4-1 1-1Z"/></svg>
            </div>
            <span class="text-2xl font-display font-black text-slate-900 tracking-tight">Solución<span class="text-primary-600">Canina</span></span>
          </a>
          
          <nav class="hidden md:flex items-center gap-8">
            <a href="/" class="text-sm font-bold text-slate-600 hover:text-primary-600 transition-colors">Inicio</a>
            <a href="#articulos" class="text-sm font-bold text-slate-600 hover:text-primary-600 transition-colors">Productos</a>
          </nav>
        </div>
      </div>
    </header>

    <main class="flex-grow w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-12 md:py-20">
      <slot />
    </main>

    <footer class="bg-slate-900 text-white mt-auto py-20">
      <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
          <div class="col-span-1 md:col-span-2">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-8 h-8 bg-primary-500 rounded-lg flex items-center justify-center text-white">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-dog"><path d="M10 5.172C10 3.782 8.823 2.656 7.415 2.656h-.144C5.863 2.656 4.687 3.782 4.687 5.172v.313c0 1.39 1.176 2.516 2.584 2.516h.144c1.408 0 2.584-1.126 2.584-2.516v-.313Z"/><path d="M14.687 5.172c0-1.39 1.176-2.516 2.584-2.516h.144c1.408 0 2.584 1.126 2.584 2.516v.313c0 1.39-1.176 2.516-2.584 2.516h-.144c-1.408 0-2.584-1.126-2.584-2.516v-.313Z"/><path d="M4 14v1a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3v-1"/><path d="M9 13v-1"/><path d="M15 13v-1"/><path d="M12 9v4"/><path d="M12 17v.01"/><path d="M18 9c.6 0 1 .4 1 1v2c0 .6-.4 1-1 1s-1-.4-1-1v-2c0-.6.4-1 1-1Z"/><path d="M6 9c.6 0 1 .4 1 1v2c0 .6-.4 1-1 1s-1-.4-1-1v-2c0-.6.4-1 1-1Z"/></svg>
              </div>
              <span class="text-xl font-display font-black tracking-tight">Solución<span class="text-primary-600">Canina</span></span>
            </div>
            <p class="text-slate-400 max-w-sm leading-relaxed">
              Ayudamos a dueños de perros a encontrar los mejores productos para que sus mejores amigos tengan una vida plena y feliz.
            </p>
          </div>
          <div>
            <h4 class="font-bold mb-6 uppercase tracking-widest text-xs text-primary-500">Enlaces</h4>
            <ul class="space-y-4 text-slate-400 font-medium">
              <li><a href="/" class="hover:text-white transition-colors">Inicio</a></li>
              <li><a href="#articulos" class="hover:text-white transition-colors">Productos</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-bold mb-6 uppercase tracking-widest text-xs text-primary-500">Legal</h4>
            <p class="text-slate-400 text-sm leading-relaxed">
              Participamos en el Programa de Afiliados de Amazon. Como afiliados de Amazon, percibimos ingresos por las compras adscritas que cumplen los requisitos aplicables.
            </p>
          </div>
        </div>
        <div class="pt-8 border-t border-slate-800 text-center text-slate-500 text-sm font-medium">
          <p>&copy; {new Date().getFullYear()} Solución Canina. Todos los derechos reservados.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
