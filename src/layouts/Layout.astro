---
import '../styles/global.css';
import HeaderCatalogControls from '../components/HeaderCatalogControls';
import SEO from '../components/SEO.astro';
import { slugify } from '../utils/slugify';
import { getCollection } from 'astro:content';
import { organizationSchema, websiteSchema } from '../utils/seo';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  canonical?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  categories?: string[];
}

const {
  title,
  description = 'Encuentra los mejores artículos para tu perro en Amazon. Selección curada y verificada.',
  image,
  type = 'website',
  canonical,
  noindex = false,
  jsonLd,
  categories: categoriesProp = [],
} = Astro.props as Props;

const pageJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const globalJsonLd = [organizationSchema(), websiteSchema()];
const allJsonLd = [...globalJsonLd, ...pageJsonLd];

// Carrega el catàleg sencer una sola vegada perquè el cercador del header
// (HeaderCatalogControls) pugui mostrar suggeriments en temps real des de
// QUALSEVOL pàgina del site.
const _articulos = await getCollection('articulos');

const searchIndex = _articulos.map((a) => ({
  slug: a.data.slug || slugify(a.data.nombre),
  nombre: a.data.nombre,
  marca: a.data.marca ?? '',
  categoria: a.data.categoria ?? '',
  imagen: a.data.imagen ?? '',
  precio: a.data.precio ?? '',
  descuentoPct: a.data.descuentoPct ?? null,
}));

// Si la pàgina no ens passa `categories`, les derivem del catàleg sol.
const categories = categoriesProp.length > 0
  ? categoriesProp
  : Array.from(new Set(_articulos.map((a) => a.data.categoria).filter(Boolean) as string[]));
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) — deferred to idle to free main thread for LCP/INP -->
    <script is:inline>
      (function () {
        var GA_ID = 'G-FH339B1P51';
        window.dataLayer = window.dataLayer || [];
        function gtag(){ window.dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', GA_ID);
        function loadGA() {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s);
        }
        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadGA, { timeout: 4000 });
        } else {
          window.addEventListener('load', function () { setTimeout(loadGA, 1500); });
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      canonical={canonical}
      noindex={noindex}
      jsonLd={allJsonLd}
    />
    <link rel="alternate" type="application/rss+xml" title="Solución Canina — Blog" href="/rss.xml" />
    <link rel="preconnect" href="https://m.media-amazon.com" crossorigin />
    <link rel="dns-prefetch" href="https://m.media-amazon.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="preload" href="/logo.png" as="image" type="image/png" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/merriweather-latin.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Top bar -->
    <div class="bg-navy-700 text-white text-xs font-medium py-2">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Selección verificada de productos para perros
        </span>
        <span class="hidden sm:block text-white/70">Actualizado mayo 2026</span>
      </div>
    </div>

    <!-- Header -->
    <header class="sticky top-0 z-50 bg-white border-b border-neutral-200 shadow-nav">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-4 h-16">
          <!-- Logo -->
          <a href="/" class="flex items-center gap-1 shrink-0 group" id="header-logo">
            <img src="/logo.png" alt="Solución Canina" class="w-16 h-16 scale-125 object-contain group-hover:scale-150 transition-transform duration-200" />
            <div class="leading-tight hidden sm:block ml-2">
              <span class="text-xl font-extrabold text-neutral-900 tracking-tight">Solución</span><span class="text-xl font-extrabold text-primary-500 tracking-tight">Canina</span>
            </div>
          </a>
          
          <!-- Search + controls -->
          <div class="flex-1 min-w-0">
            <HeaderCatalogControls client:load categories={categories} searchIndex={searchIndex} />
          </div>

          <!-- Nav -->
          <nav class="hidden md:flex items-center gap-6 shrink-0" id="main-nav">
            <a href="/productos" class="text-sm font-semibold text-neutral-600 hover:text-primary-600 transition-colors">Productos</a>
            <a href="/blog" class="text-sm font-semibold text-neutral-600 hover:text-primary-600 transition-colors flex items-center gap-1">
              Artículos y Guías
            </a>
            <a href="/asistente" class="ml-2 text-sm font-bold bg-gradient-to-r from-primary-500 to-amber-500 text-white px-4 py-2 rounded-full shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
              Asistente de Compras
            </a>
          </nav>
        </div>
      </div>

      <!-- Category bar (desktop) -->
      {categories.length > 0 && !Astro.url.pathname.startsWith('/productos') && !Astro.url.pathname.startsWith('/categoria') && (
        <div class="hidden lg:block border-t border-neutral-100">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center gap-1 py-1.5 overflow-x-auto" id="category-bar">
              {categories.map((cat) => {
                const catPath = `/categoria/${slugify(cat)}`;
                const isActive = Astro.url.pathname === catPath || Astro.url.pathname === `${catPath}/`;
                return (
                  <a href={catPath} class={`px-3 py-1.5 text-xs font-semibold rounded-md transition-colors whitespace-nowrap ${isActive ? 'bg-primary-50 text-primary-700' : 'text-neutral-500 hover:text-primary-600 hover:bg-primary-50'}`}>
                    {cat}
                  </a>
                );
              })}
            </div>
          </div>
        </div>
      )}
    </header>

    <main class="flex-grow w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="mt-auto bg-navy-700 text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-10">
          <!-- Brand -->
          <div class="xl:col-span-1">
            <div class="flex items-center gap-2.5 mb-4">
              <img src="/logo.png" alt="Solución Canina" class="w-12 h-12 object-contain scale-125 brightness-0 invert" />
              <div class="leading-tight ml-2">
                <span class="text-base font-extrabold tracking-tight">Solución</span><span class="text-base font-extrabold text-primary-300 tracking-tight">Canina</span>
              </div>
            </div>
            <p class="text-white/70 text-sm leading-relaxed max-w-xs">
              Seleccionamos y organizamos productos para ayudarte a encontrar las mejores opciones para tu perro.
            </p>
          </div>

          <!-- Categories -->
          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-white/50 mb-4">Categorías</h4>
            <ul class="space-y-2 text-white/70 text-sm">
              {categories.slice(0, 6).map((cat) => (
                <li><a href={`/categoria/${slugify(cat)}`} class="hover:text-white transition-colors">{cat}</a></li>
              ))}
              {categories.length === 0 && (
                <li><a href="/productos" class="hover:text-white transition-colors">Ver catálogo</a></li>
              )}
            </ul>
          </div>

          <!-- Information -->
          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-white/50 mb-4">Información</h4>
            <ul class="space-y-2 text-white/70 text-sm">
              <li><a href="/" class="hover:text-white transition-colors">Inicio</a></li>
              <li><a href="/productos" class="hover:text-white transition-colors">Productos</a></li>
              <li><a href="/blog" class="hover:text-white transition-colors">Artículos y Guías</a></li>
            </ul>
          </div>

          <!-- Legal -->
          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-white/50 mb-4">Legal</h4>
            <ul class="space-y-2 text-white/60 text-sm">
              <li><a href="/aviso-legal" class="hover:text-white transition-colors">Aviso legal</a></li>
              <li><a href="/politica-privacidad" class="hover:text-white transition-colors">Política de privacidad</a></li>
              <li><a href="/politica-cookies" class="hover:text-white transition-colors">Política de cookies</a></li>
            </ul>
            <p class="mt-4 text-xs text-white/40 leading-relaxed">
              Esta web no sustituye el consejo veterinario. Consulta con tu veterinario antes de cambiar la alimentación o suplementos.
            </p>
          </div>
        </div>

        <div class="mt-10 pt-6 border-t border-white/10 text-center">
          <h4 class="text-xs font-bold uppercase tracking-wider text-white/50 mb-2">Contáctanos</h4>
          <a href="mailto:hola@solucioncanina.es" class="text-sm text-white/80 hover:text-white transition-colors">
            hola@solucioncanina.es
          </a>
        </div>

        <div class="mt-6 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-white/40 text-[10px] sm:text-xs">
          <div class="flex flex-col gap-1">
            <p>&copy; {new Date().getFullYear()} Solución Canina. Todos los derechos reservados.</p>
            <p class="max-w-xl italic">
              Como afiliados de Amazon, recibimos ingresos por las compras adscritas que cumplen los requisitos aplicables. Esto no tiene ningún coste para ti y nos ayuda a mantener la web.
            </p>
          </div>
          <p class="shrink-0">Hecho para ayudarte a elegir mejor.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
