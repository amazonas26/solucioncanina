---
import '../styles/global.css';
import HeaderCatalogControls from '../components/HeaderCatalogControls';

interface Props {
  title: string;
  description?: string;
  categories?: string[];
}

const { title, description = 'Encuentra los mejores artículos para tu perro en Amazon.', categories = [] } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-FH339B1P51"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-FH339B1P51');
    </script>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Solución Canina</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800;900&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen flex flex-col bg-mesh selection:bg-primary-500 selection:text-white">
    <header class="sticky top-0 z-50 glass border-b border-white/20">
      <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
        <div class="flex items-center gap-5 h-20">
          <a href="/" class="flex items-center gap-3 group">
            <div class="w-10 h-10 bg-primary-600 rounded-xl flex items-center justify-center text-white shadow-lg shadow-primary-500/30 group-hover:scale-110 group-hover:rotate-6 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-dog"><path d="M10 5.172C10 3.782 8.823 2.656 7.415 2.656h-.144C5.863 2.656 4.687 3.782 4.687 5.172v.313c0 1.39 1.176 2.516 2.584 2.516h.144c1.408 0 2.584-1.126 2.584-2.516v-.313Z"/><path d="M14.687 5.172c0-1.39 1.176-2.516 2.584-2.516h.144c1.408 0 2.584 1.126 2.584 2.516v.313c0 1.39-1.176 2.516-2.584 2.516h-.144c-1.408 0-2.584-1.126-2.584-2.516v-.313Z"/><path d="M4 14v1a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3v-1"/><path d="M9 13v-1"/><path d="M15 13v-1"/><path d="M12 9v4"/><path d="M12 17v.01"/><path d="M18 9c.6 0 1 .4 1 1v2c0 .6-.4 1-1 1s-1-.4-1-1v-2c0-.6.4-1 1-1Z"/><path d="M6 9c.6 0 1 .4 1 1v2c0 .6-.4 1-1 1s-1-.4-1-1v-2c0-.6.4-1 1-1Z"/></svg>
            </div>
            <span class="text-2xl font-display font-black text-slate-900 tracking-tight">Solución<span class="text-primary-600">Canina</span></span>
          </a>
          
          <div class="flex-1 hidden md:block">
            <HeaderCatalogControls client:load categories={categories} />
          </div>

          <nav class="hidden md:flex items-center gap-8 shrink-0">
            <a href="/" class="text-sm font-bold text-slate-600 hover:text-primary-600 transition-colors">Inicio</a>
            <a href="#articulos" class="text-sm font-bold text-slate-600 hover:text-primary-600 transition-colors">Productos</a>
          </nav>
        </div>
      </div>
    </header>

    <main class="flex-grow w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-12 md:py-20">
      <slot />
    </main>

    <footer class="mt-auto text-white">
      <div class="relative overflow-hidden bg-slate-950">
        <div class="absolute inset-0 opacity-40">
          <div class="absolute -top-24 -left-32 w-[520px] h-[520px] bg-primary-600/30 rounded-full blur-3xl"></div>
          <div class="absolute -bottom-24 -right-32 w-[520px] h-[520px] bg-accent-500/20 rounded-full blur-3xl"></div>
        </div>

        <div class="relative max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-16 md:py-20">
          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-12">
            <div class="xl:col-span-2">
              <div class="flex items-center gap-3 mb-5">
                <div class="w-10 h-10 bg-white/10 rounded-2xl flex items-center justify-center text-white border border-white/10">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-dog"><path d="M10 5.172C10 3.782 8.823 2.656 7.415 2.656h-.144C5.863 2.656 4.687 3.782 4.687 5.172v.313c0 1.39 1.176 2.516 2.584 2.516h.144c1.408 0 2.584-1.126 2.584-2.516v-.313Z"/><path d="M14.687 5.172c0-1.39 1.176-2.516 2.584-2.516h.144c1.408 0 2.584 1.126 2.584 2.516v.313c0 1.39-1.176 2.516-2.584 2.516h-.144c-1.408 0-2.584-1.126-2.584-2.516v-.313Z"/><path d="M4 14v1a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3v-1"/><path d="M9 13v-1"/><path d="M15 13v-1"/><path d="M12 9v4"/><path d="M12 17v.01"/><path d="M18 9c.6 0 1 .4 1 1v2c0 .6-.4 1-1 1s-1-.4-1-1v-2c0-.6.4-1 1-1Z"/><path d="M6 9c.6 0 1 .4 1 1v2c0 .6-.4 1-1 1s-1-.4-1-1v-2c0-.6.4-1 1-1Z"/></svg>
                </div>
                <div class="leading-tight">
                  <div class="text-xl font-display font-black tracking-tight">
                    Solución<span class="text-primary-400">Canina</span>
                  </div>
                  <div class="text-xs font-black uppercase tracking-widest text-white/50">
                    Catálogo de productos para perros
                  </div>
                </div>
              </div>
              <p class="text-white/70 max-w-md leading-relaxed font-medium">
                Seleccionamos y organizamos productos para ayudarte a encontrar opciones útiles para tu perro (senior, ansiedad, suplementos, rampas, alimentación específica y más).
              </p>
              <div class="mt-7 rounded-2xl border border-white/10 bg-white/5 p-5">
                <div class="text-[11px] font-black uppercase tracking-widest text-white/60 mb-2">Transparencia</div>
                <p class="text-sm text-white/70 leading-relaxed">
                  Participamos en el Programa de Afiliados de Amazon. Si compras desde nuestros enlaces, podemos recibir una comisión sin coste adicional para ti.
                </p>
              </div>
            </div>

            <div>
              <h4 class="font-black mb-5 uppercase tracking-widest text-[11px] text-white/70">Categorías</h4>
              <ul class="space-y-3 text-white/70 font-semibold text-sm">
                {categories.slice(0, 6).map((cat) => (
                  <li><a href="#articulos" class="hover:text-white transition-colors">{cat}</a></li>
                ))}
                {categories.length === 0 && (
                  <li><a href="#articulos" class="hover:text-white transition-colors">Ver catálogo</a></li>
                )}
              </ul>
            </div>

            <div>
              <h4 class="font-black mb-5 uppercase tracking-widest text-[11px] text-white/70">Información</h4>
              <ul class="space-y-3 text-white/70 font-semibold text-sm">
                <li><a href="/" class="hover:text-white transition-colors">Inicio</a></li>
                <li><a href="#articulos" class="hover:text-white transition-colors">Productos</a></li>
                <li><a href="#sobre-nosotros" class="hover:text-white transition-colors">Sobre nosotros</a></li>
              </ul>
            </div>

            <div>
              <h4 class="font-black mb-5 uppercase tracking-widest text-[11px] text-white/70">Legal</h4>
              <ul class="space-y-3 text-white/60 font-semibold text-sm">
                <li><span class="text-white/60">Aviso legal (pendiente)</span></li>
                <li><span class="text-white/60">Política de privacidad (pendiente)</span></li>
                <li><span class="text-white/60">Política de cookies (pendiente)</span></li>
              </ul>
              <p class="mt-6 text-xs text-white/50 leading-relaxed">
                Esta web no sustituye el consejo veterinario. En dietas veterinarias o problemas de salud, consulta con tu veterinario.
              </p>
            </div>
          </div>

          <div class="mt-14 pt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4 text-white/50 text-sm font-semibold">
            <p>&copy; {new Date().getFullYear()} Solución Canina. Todos los derechos reservados.</p>
            <p class="text-white/40">Hecho para ayudarte a elegir mejor.</p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
