---
import '../styles/global.css';
import HeaderCatalogControls from '../components/HeaderCatalogControls';
import SEO from '../components/SEO.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { slugify } from '../utils/slugify';
import { getCollection } from 'astro:content';
import { organizationSchema, SITE_NAME, THEME_COLOR, websiteSchema } from '../utils/seo';
import { problemSections } from '../utils/problemSections';
import { ultimaConsultaPrecios } from '../utils/precioConsultado';

// "Actualizado <mes> <año>": mes de la última consulta real de precios del catálogo
// (src/data/precios-consultados.json), no el mes del build.
const MESES_ES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
const _ultimaConsulta = ultimaConsultaPrecios();
const actualizadoLabel = _ultimaConsulta
  ? `${MESES_ES[Number(_ultimaConsulta.slice(5, 7)) - 1]} ${_ultimaConsulta.slice(0, 4)}`
  : null;

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  canonical?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  categories?: string[];
}

const {
  title,
  description = 'Análisis honestos y opiniones de productos para perros, con el precio de Amazon y la fecha en que lo consultamos. Selección curada por Solución Canina.',
  image,
  type = 'website',
  canonical,
  noindex = false,
  jsonLd,
  categories: categoriesProp = [],
} = Astro.props as Props;

const pageJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const globalJsonLd = [organizationSchema(), websiteSchema()];
const allJsonLd = [...globalJsonLd, ...pageJsonLd];

// Carrega el catàleg sencer una sola vegada perquè el cercador del header
// (HeaderCatalogControls) pugui mostrar suggeriments en temps real des de
// QUALSEVOL pàgina del site.
const _articulos = await getCollection('articulos');

const searchIndex = _articulos.map((a) => ({
  slug: a.data.slug || slugify(a.data.nombre),
  nombre: a.data.nombreCorto || a.data.nombre,
  nombreAmazon: a.data.nombre,
  marca: a.data.marca ?? '',
  categoria: a.data.categoria ?? '',
  imagen: a.data.imagen ?? '',
  precio: a.data.precio ?? '',
  // Omitir null: en /herramientas/ el island serializa `[0,null]` y crawlers
  // lo resuelven como ruta relativa → `/herramientas/null`.
  ...(typeof a.data.descuentoPct === 'number' ? { descuentoPct: a.data.descuentoPct } : {}),
}));

// Si la pàgina no ens passa `categories`, les derivem del catàleg sol.
const categories = categoriesProp.length > 0
  ? categoriesProp
  : Array.from(new Set(_articulos.map((a) => a.data.categoria).filter(Boolean) as string[]));
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <Fragment set:html={`<meta name="p:domain_verify" content="fceefba5cd3fc4201c57eef84a3c38ff"/>`} />
    <!-- Google tag (gtag.js) — solo con consentimiento (banner «Aceptar»); diferido a idle para LCP/INP -->
    <script is:inline>
      (function () {
        var GA_ID = 'G-FH339B1P51';
        window.dataLayer = window.dataLayer || [];
        function gtag(){ window.dataLayer.push(arguments); }
        window.gtag = gtag;
        var loaded = false;
        window.scLoadAnalytics = function () {
          window['ga-disable-' + GA_ID] = false;
          if (loaded) return;
          loaded = true;
          gtag('js', new Date());
          gtag('config', GA_ID);
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s);
        };
        var consent = null;
        try { consent = localStorage.getItem('sc_cookie_consent'); } catch (e) {}
        if (consent !== 'accepted') return;
        if ('requestIdleCallback' in window) {
          requestIdleCallback(window.scLoadAnalytics, { timeout: 4000 });
        } else {
          window.addEventListener('load', function () { setTimeout(window.scLoadAnalytics, 1500); });
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="msapplication-TileColor" content={THEME_COLOR} />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      canonical={canonical}
      noindex={noindex}
      jsonLd={allJsonLd}
    />
    <link rel="alternate" type="application/rss+xml" title="Solución Canina — Blog" href="/rss.xml" />
    <link rel="preconnect" href="https://m.media-amazon.com" crossorigin />
    <link rel="dns-prefetch" href="https://m.media-amazon.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="preload" href="/logo.png" as="image" type="image/png" />
    <link rel="preload" href="/fonts/libre-franklin-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Header -->
    <header class="sticky top-0 z-50 bg-paper border-b border-neutral-900">
      <div class="wrap">
        <div class="flex items-center gap-4 lg:gap-8 h-16 lg:h-[72px]">
          <!-- Logo -->
          <a href="/" class="flex items-center gap-2.5 shrink-0" id="header-logo">
            <img src="/logo.png" alt="Solución Canina" width="44" height="44" class="w-11 h-11 object-contain" />
            <span class="hidden sm:block font-serif text-[1.65rem] font-bold leading-none tracking-tight text-neutral-900">Solución <span class="text-primary-600">Canina</span></span>
          </a>

          <!-- Search + controls -->
          <div class="flex-1 min-w-0 max-w-2xl">
            <HeaderCatalogControls client:load categories={categories} searchIndex={searchIndex} />
          </div>

          <!-- Nav -->
          <nav class="hidden md:flex items-center gap-6 lg:gap-8 shrink-0 ml-auto text-[15px]" id="main-nav">
            <a href="/productos/" class="font-medium text-neutral-800 hover:text-primary-700 hover:underline underline-offset-[6px]">Productos</a>
            <a href="/herramientas/" class="font-medium text-neutral-800 hover:text-primary-700 hover:underline underline-offset-[6px]">Calculadoras</a>
            <a href="/blog/" class="font-medium text-neutral-800 hover:text-primary-700 hover:underline underline-offset-[6px]">Guías</a>
            <a href="/asistente/" class="font-semibold text-primary-700 hover:underline underline-offset-[6px]">Asistente&nbsp;→</a>
          </nav>
        </div>
      </div>

      <!-- Barra de secciones y categorías (desktop) -->
      {!Astro.url.pathname.startsWith('/productos') && (
        <div class="hidden lg:block border-t border-neutral-200">
          <div class="wrap">
            <div class="flex items-center gap-1 py-1" id="category-bar-wrap">
              <button
                type="button"
                id="category-bar-prev"
                class="category-bar-scroll-btn shrink-0 flex h-8 w-6 items-center justify-center text-neutral-500 transition-colors hover:text-neutral-900 disabled:pointer-events-none disabled:opacity-0"
                aria-label="Desplazar secciones hacia la izquierda"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
              </button>

              <div class="relative min-w-0 flex-1">
                <div
                  class="pointer-events-none absolute inset-y-0 left-0 z-10 w-6 bg-gradient-to-r from-paper to-transparent opacity-0 transition-opacity duration-200"
                  id="category-bar-fade-left"
                  aria-hidden="true"
                />
                <div
                  class="pointer-events-none absolute inset-y-0 right-0 z-10 w-6 bg-gradient-to-l from-paper to-transparent opacity-0 transition-opacity duration-200"
                  id="category-bar-fade-right"
                  aria-hidden="true"
                />
                <div
                  class="flex items-center gap-6 overflow-x-auto scroll-smooth scrollbar-none py-2.5"
                  id="category-bar"
                >
                  {problemSections.map((section) => {
                    const sectionPath = `/categoria/${section.slug}/`;
                    const isActive = Astro.url.pathname === sectionPath;
                    return (
                      <a
                        href={sectionPath}
                        class={`text-[13.5px] font-medium whitespace-nowrap shrink-0 underline-offset-[11px] decoration-2 ${isActive ? 'text-neutral-900 underline decoration-primary-600' : 'text-neutral-700 hover:text-neutral-900 hover:underline decoration-neutral-300'}`}
                      >
                        {section.name}
                      </a>
                    );
                  })}
                  {categories.length > 0 && (
                    <>
                      <span class="h-4 w-px shrink-0 bg-neutral-300" aria-hidden="true" />
                      {categories.map((cat) => {
                        const catPath = `/categoria/${slugify(cat)}/`;
                        const isActive = Astro.url.pathname === catPath;
                        return (
                          <a
                            href={catPath}
                            class={`text-[13.5px] whitespace-nowrap shrink-0 underline-offset-[11px] decoration-2 ${isActive ? 'text-neutral-900 underline decoration-primary-600' : 'text-neutral-500 hover:text-neutral-900 hover:underline decoration-neutral-300'}`}
                          >
                            {cat}
                          </a>
                        );
                      })}
                    </>
                  )}
                </div>
              </div>

              <button
                type="button"
                id="category-bar-next"
                class="category-bar-scroll-btn shrink-0 flex h-8 w-6 items-center justify-center text-neutral-500 transition-colors hover:text-neutral-900 disabled:pointer-events-none disabled:opacity-0"
                aria-label="Desplazar secciones hacia la derecha"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
              </button>
            </div>
          </div>
        </div>
      )}
    </header>

    <main class="flex-grow wrap py-8 md:py-12">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="mt-16 bg-navy-800 text-white">
      <div class="wrap py-12 md:py-16">
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-10">
          <!-- Brand -->
          <div class="xl:col-span-1">
            <div class="flex items-center gap-2.5 mb-4">
              <img src="/logo.png" alt="Solución Canina" class="w-12 h-12 object-contain scale-125 brightness-0 invert" />
              <span class="ml-1 font-serif text-2xl font-bold tracking-tight">Solución <span class="text-primary-300">Canina</span></span>
            </div>
            <p class="text-white/70 text-sm leading-relaxed max-w-xs">
              Seleccionamos y organizamos productos para ayudarte a encontrar las mejores opciones para tu perro.
            </p>
            <div class="mt-5">
              <SocialLinks />
            </div>
          </div>

          <!-- Categories -->
          <div>
            <h4 class="font-sans text-sm font-semibold text-white mb-4">Categorías</h4>
            <ul class="space-y-2 text-white/70 text-sm">
              {categories.slice(0, 6).map((cat) => (
                <li><a href={`/categoria/${slugify(cat)}/`} class="hover:text-white transition-colors">{cat}</a></li>
              ))}
              {categories.length === 0 && (
                <li><a href="/productos/" class="hover:text-white transition-colors">Ver catálogo</a></li>
              )}
            </ul>
          </div>

          <!-- Information -->
          <div>
            <h4 class="font-sans text-sm font-semibold text-white mb-4">Información</h4>
            <ul class="space-y-2 text-white/70 text-sm">
              <li><a href="/" class="hover:text-white transition-colors">Inicio</a></li>
              <li><a href="/productos/" class="hover:text-white transition-colors">Productos</a></li>
              <li><a href="/herramientas/" class="hover:text-white transition-colors">Herramientas</a></li>
              <li><a href="/blog/" class="hover:text-white transition-colors">Artículos y guías</a></li>
              <li><a href="/preguntas-frecuentes/" class="hover:text-white transition-colors">Preguntas frecuentes</a></li>
              <li><a href="/como-analizamos/" class="hover:text-white transition-colors">Cómo analizamos</a></li>
            </ul>
          </div>

          <!-- Legal -->
          <div>
            <h4 class="font-sans text-sm font-semibold text-white mb-4">Legal</h4>
            <ul class="space-y-2 text-white/60 text-sm">
              <li><a href="/aviso-legal/" class="hover:text-white transition-colors">Aviso legal</a></li>
              <li><a href="/aviso-legal/#afiliacion-amazon" class="hover:text-white transition-colors">Afiliación Amazon</a></li>
              <li><a href="/aviso-legal/#descargo-veterinario" class="hover:text-white transition-colors">Descargo veterinario</a></li>
              <li><a href="/politica-privacidad/" class="hover:text-white transition-colors">Política de privacidad</a></li>
              <li><a href="/politica-cookies/" class="hover:text-white transition-colors">Política de cookies</a></li>
              <li><button type="button" id="cookie-settings" class="hover:text-white transition-colors">Configurar cookies</button></li>
            </ul>
            <p class="mt-4 text-xs text-white/40 leading-relaxed">
              <a href="/aviso-legal/#descargo-veterinario" class="hover:text-white/70 transition-colors">
                Esta web no sustituye el consejo veterinario. Consulta con tu veterinario antes de cambiar la alimentación o suplementos.
              </a>
            </p>
          </div>
        </div>

        <div class="mt-10 pt-6 border-t border-white/10 text-center">
          <h4 class="font-sans text-sm font-semibold text-white mb-2">Contáctanos</h4>
          <a href="mailto:hola@solucioncanina.es" class="text-sm text-white/80 hover:text-white transition-colors">
            hola@solucioncanina.es
          </a>
        </div>

        <div class="mt-6 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-white/40 text-[10px] sm:text-xs">
          <div class="flex flex-col gap-1">
            <p>&copy; {new Date().getFullYear()} Solución Canina. Todos los derechos reservados.</p>
            <p class="max-w-xl italic">
              Algunos enlaces pueden generar una comisión sin coste adicional para ti.
              <a href="/aviso-legal/#afiliacion-amazon" class="underline hover:text-white/70 transition-colors">
                Declaración de afiliación de Amazon
              </a>.
            </p>
          </div>
          {actualizadoLabel && <p class="shrink-0">Precios de Amazon.es revisados en {actualizadoLabel}.</p>}
        </div>
      </div>
    </footer>

    <!-- Cookie consent banner -->
    <div
      id="cookie-banner"
      class="fixed bottom-0 left-0 right-0 z-50 bg-navy-800 text-white py-4 border-t border-white/10"
      style="display:none"
    >
      <div class="wrap flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <p class="text-sm text-white/80 flex-1 leading-relaxed">
          Usamos cookies analíticas de Google Analytics para medir el tráfico y mejorar la web. Solo se activan si las aceptas; puedes cambiar tu elección en cualquier momento desde «Configurar cookies», al pie de la página.
          <a href="/politica-cookies/" class="underline text-white/60 hover:text-white ml-1 whitespace-nowrap">Política de cookies</a>
        </p>
        <div class="flex gap-3 shrink-0">
          <button
            id="cookie-reject"
            class="text-xs font-bold text-white border border-white/40 hover:border-white hover:bg-white/10 px-5 py-2 rounded-lg transition-colors"
          >
            Rechazar cookies
          </button>
          <button
            id="cookie-accept"
            class="text-xs font-bold bg-primary-500 hover:bg-primary-400 text-white px-5 py-2 rounded-lg transition-colors"
          >
            Aceptar cookies
          </button>
        </div>
      </div>
    </div>

    <script is:inline>
      (function () {
        var KEY = 'sc_cookie_consent';
        var banner = document.getElementById('cookie-banner');
        var consent = null;
        try { consent = localStorage.getItem(KEY); } catch (e) {}

        function save(value) {
          try { localStorage.setItem(KEY, value); } catch (e) {}
          banner.style.display = 'none';
        }

        // Al rechazar (también después de haber aceptado): corta GA en esta página
        // y borra las cookies _ga / _ga_* que ya hubiera dejado.
        function clearAnalytics() {
          window['ga-disable-G-FH339B1P51'] = true;
          var base = location.hostname.replace(/^www\./, '');
          document.cookie.split(';').forEach(function (c) {
            var name = c.split('=')[0].trim();
            if (name !== '_ga' && name.indexOf('_ga_') !== 0) return;
            ['', '; domain=' + location.hostname, '; domain=.' + base].forEach(function (d) {
              document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + d;
            });
          });
        }

        if (!consent) {
          banner.style.display = 'block';
        }

        document.getElementById('cookie-accept').addEventListener('click', function () {
          save('accepted');
          if (window.scLoadAnalytics) window.scLoadAnalytics();
        });

        document.getElementById('cookie-reject').addEventListener('click', function () {
          save('rejected');
          clearAnalytics();
        });

        var settings = document.getElementById('cookie-settings');
        if (settings) {
          settings.addEventListener('click', function () {
            banner.style.display = 'block';
          });
        }
      })();

      (function () {
        var bar = document.getElementById('category-bar');
        var prev = document.getElementById('category-bar-prev');
        var next = document.getElementById('category-bar-next');
        var fadeL = document.getElementById('category-bar-fade-left');
        var fadeR = document.getElementById('category-bar-fade-right');
        if (!bar || !prev || !next) return;

        function update() {
          var max = Math.max(0, bar.scrollWidth - bar.clientWidth);
          var left = bar.scrollLeft;
          prev.disabled = left <= 2;
          next.disabled = left >= max - 2;
          if (fadeL) fadeL.style.opacity = left > 4 ? '1' : '0';
          if (fadeR) fadeR.style.opacity = left < max - 4 ? '1' : '0';
        }

        function scrollByDir(dir) {
          bar.scrollBy({ left: dir * Math.max(200, bar.clientWidth * 0.55), behavior: 'smooth' });
        }

        prev.addEventListener('click', function () { scrollByDir(-1); });
        next.addEventListener('click', function () { scrollByDir(1); });
        bar.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
      })();
    </script>
  </body>
</html>
