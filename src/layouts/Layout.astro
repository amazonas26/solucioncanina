---
import '../styles/global.css';
import HeaderCatalogControls from '../components/HeaderCatalogControls';
import { slugify } from '../utils/slugify';

interface Props {
  title: string;
  description?: string;
  categories?: string[];
}

const { title, description = 'Encuentra los mejores artículos para tu perro en Amazon. Selección curada y verificada.', categories = [] } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-FH339B1P51"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-FH339B1P51');
    </script>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Solución Canina</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Merriweather:wght@400;700;900&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Top bar -->
    <div class="bg-navy-700 text-white text-xs font-medium py-2">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Selección verificada de productos para perros
        </span>
        <span class="hidden sm:block text-white/70">Actualizado mayo 2025</span>
      </div>
    </div>

    <!-- Header -->
    <header class="sticky top-0 z-50 bg-white border-b border-neutral-200 shadow-nav">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-4 h-16">
          <!-- Logo -->
          <a href="/" class="flex items-center gap-2.5 shrink-0 group" id="header-logo">
            <img src="/logo.png" alt="Solución Canina" class="w-9 h-9 object-contain group-hover:scale-105 transition-transform duration-200" />
            <div class="leading-tight hidden sm:block">
              <span class="text-lg font-extrabold text-neutral-900 tracking-tight">Solución</span><span class="text-lg font-extrabold text-primary-500 tracking-tight">Canina</span>
            </div>
          </a>
          
          <!-- Search + controls -->
          <div class="flex-1 min-w-0">
            <HeaderCatalogControls client:load categories={categories} />
          </div>

          <!-- Nav -->
          <nav class="hidden md:flex items-center gap-6 shrink-0" id="main-nav">
            <a href="/" class="text-sm font-semibold text-neutral-600 hover:text-primary-600 transition-colors">Inicio</a>
            <a href="/#articulos" class="text-sm font-semibold text-neutral-600 hover:text-primary-600 transition-colors">Productos</a>
            <a href="/#sobre-nosotros" class="text-sm font-semibold text-neutral-600 hover:text-primary-600 transition-colors">Sobre nosotros</a>
          </nav>
        </div>
      </div>

      <!-- Category bar (desktop) -->
      {categories.length > 0 && (
        <div class="hidden lg:block border-t border-neutral-100">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center gap-1 py-1.5 overflow-x-auto" id="category-bar">
              {categories.map((cat) => (
                <a href={`/categoria/${slugify(cat)}`} class="px-3 py-1.5 text-xs font-semibold text-neutral-500 hover:text-primary-600 hover:bg-primary-50 rounded-md transition-colors whitespace-nowrap">
                  {cat}
                </a>
              ))}
            </div>
          </div>
        </div>
      )}
    </header>

    <main class="flex-grow w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="mt-auto bg-navy-700 text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-10">
          <!-- Brand -->
          <div class="xl:col-span-1">
            <div class="flex items-center gap-2.5 mb-4">
              <img src="/logo.png" alt="Solución Canina" class="w-8 h-8 object-contain brightness-0 invert" />
              <div class="leading-tight">
                <span class="text-base font-extrabold tracking-tight">Solución</span><span class="text-base font-extrabold text-primary-300 tracking-tight">Canina</span>
              </div>
            </div>
            <p class="text-white/70 text-sm leading-relaxed max-w-xs">
              Seleccionamos y organizamos productos para ayudarte a encontrar las mejores opciones para tu perro.
            </p>
            <div class="mt-5 p-3 rounded-lg bg-white/5 border border-white/10">
              <p class="text-[11px] uppercase tracking-wider font-bold text-white/50 mb-1">Transparencia</p>
              <p class="text-xs text-white/60 leading-relaxed">
                Participamos en el Programa de Afiliados de Amazon. Si compras desde nuestros enlaces, podemos recibir una comisión sin coste adicional para ti.
              </p>
            </div>
          </div>

          <!-- Categories -->
          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-white/50 mb-4">Categorías</h4>
            <ul class="space-y-2 text-white/70 text-sm">
              {categories.slice(0, 6).map((cat) => (
                <li><a href={`/categoria/${slugify(cat)}`} class="hover:text-white transition-colors">{cat}</a></li>
              ))}
              {categories.length === 0 && (
                <li><a href="/#articulos" class="hover:text-white transition-colors">Ver catálogo</a></li>
              )}
            </ul>
          </div>

          <!-- Information -->
          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-white/50 mb-4">Información</h4>
            <ul class="space-y-2 text-white/70 text-sm">
              <li><a href="/" class="hover:text-white transition-colors">Inicio</a></li>
              <li><a href="/#articulos" class="hover:text-white transition-colors">Productos</a></li>
              <li><a href="/#sobre-nosotros" class="hover:text-white transition-colors">Sobre nosotros</a></li>
            </ul>
          </div>

          <!-- Legal -->
          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-white/50 mb-4">Legal</h4>
            <ul class="space-y-2 text-white/60 text-sm">
              <li><span>Aviso legal (pendiente)</span></li>
              <li><span>Política de privacidad (pendiente)</span></li>
              <li><span>Política de cookies (pendiente)</span></li>
            </ul>
            <p class="mt-4 text-xs text-white/40 leading-relaxed">
              Esta web no sustituye el consejo veterinario. Consulta con tu veterinario antes de cambiar la alimentación o suplementos.
            </p>
          </div>
        </div>

        <div class="mt-10 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-3 text-white/40 text-xs">
          <p>&copy; {new Date().getFullYear()} Solución Canina. Todos los derechos reservados.</p>
          <p>Hecho para ayudarte a elegir mejor.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
