---
import { type Herramienta } from '../utils/herramientas';

interface Props {
  herramienta: Herramienta;
  heading?: 'h2' | 'h3';
}

const { herramienta, heading = 'h2' } = Astro.props;
const HeadingTag = heading;

---

<a
  href={herramienta.href}
  class="herramienta-card group block border-t-2 border-neutral-900 pt-4 pb-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-4"
  aria-label={`${herramienta.pregunta} Abrir calculadora.`}
>
  <HeadingTag class="font-serif text-[1.5rem] leading-snug font-semibold tracking-tight text-neutral-900 group-hover:underline decoration-1 underline-offset-4">
    {herramienta.pregunta}
  </HeadingTag>
  <p class="mt-2 text-[15px] text-neutral-600 leading-relaxed">
    Pide: {herramienta.inputLabels.map((input) => (input.unit ? `${input.label.toLowerCase()} (${input.unit})` : input.label.toLowerCase())).join(', ')}
  </p>
  <span class="mt-3 inline-block text-[15px] font-semibold text-primary-700">Calcular →</span>
</a>
