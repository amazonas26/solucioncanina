---
import { type Herramienta, type HerramientaAccent } from '../utils/herramientas';
import HerramientaIcon from './HerramientaIcon.astro';

interface Props {
  herramienta: Herramienta;
  heading?: 'h2' | 'h3';
}

const { herramienta, heading = 'h2' } = Astro.props;
const HeadingTag = heading;

const ACCENTS: Record<
  HerramientaAccent,
  { icon: string; wash: string; chip: string; cta: string; ghost: string; glow: string; title: string }
> = {
  teal: {
    icon: 'bg-primary-600 text-white group-hover:bg-primary-700',
    wash: 'hover:border-primary-300 hover:bg-primary-50/80',
    chip: 'bg-primary-50 text-primary-800',
    cta: 'text-primary-700',
    ghost: 'text-primary-600',
    glow: 'bg-primary-400/30',
    title: 'group-hover:text-primary-800',
  },
  navy: {
    icon: 'bg-navy-700 text-white group-hover:bg-navy-800',
    wash: 'hover:border-navy-300 hover:bg-navy-50/90',
    chip: 'bg-navy-50 text-navy-800',
    cta: 'text-navy-700',
    ghost: 'text-navy-600',
    glow: 'bg-navy-400/25',
    title: 'group-hover:text-navy-800',
  },
  mint: {
    icon: 'bg-primary-100 text-primary-700 group-hover:bg-primary-600 group-hover:text-white',
    wash: 'hover:border-primary-200 hover:bg-primary-50/70',
    chip: 'bg-primary-50 text-primary-800',
    cta: 'text-primary-700',
    ghost: 'text-primary-500',
    glow: 'bg-primary-300/40',
    title: 'group-hover:text-primary-800',
  },
  sky: {
    icon: 'bg-navy-100 text-navy-700 group-hover:bg-navy-700 group-hover:text-white',
    wash: 'hover:border-navy-200 hover:bg-navy-50/80',
    chip: 'bg-navy-50 text-navy-800',
    cta: 'text-navy-700',
    ghost: 'text-navy-500',
    glow: 'bg-navy-300/35',
    title: 'group-hover:text-navy-800',
  },
  forest: {
    icon: 'bg-primary-800 text-primary-50 group-hover:bg-primary-600',
    wash: 'hover:border-primary-300 hover:bg-primary-50/80',
    chip: 'bg-primary-50 text-primary-900',
    cta: 'text-primary-800',
    ghost: 'text-primary-700',
    glow: 'bg-primary-500/25',
    title: 'group-hover:text-primary-800',
  },
  warm: {
    icon: 'bg-accent-500/15 text-accent-700 group-hover:bg-accent-500 group-hover:text-white',
    wash: 'hover:border-accent-400/50 hover:bg-accent-500/[0.06]',
    chip: 'bg-accent-500/10 text-neutral-800',
    cta: 'text-accent-700',
    ghost: 'text-accent-500',
    glow: 'bg-accent-400/35',
    title: 'group-hover:text-neutral-900',
  },
};

const accent = ACCENTS[herramienta.accent];
---

<a
  href={herramienta.href}
  class:list={[
    'herramienta-card group relative flex flex-col overflow-hidden rounded-2xl border border-neutral-200 bg-white p-5 shadow-card',
    'transition-[transform,box-shadow,border-color,background-color] duration-300 ease-out',
    'hover:shadow-card-hover motion-safe:hover:-translate-y-1',
    'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2',
    accent.wash,
  ]}
  aria-label={`${herramienta.pregunta} Abrir calculadora.`}
>
  <span
    class:list={[
      'pointer-events-none absolute -top-10 -left-8 h-28 w-28 rounded-full blur-2xl opacity-0 transition-opacity duration-300 group-hover:opacity-100',
      accent.glow,
    ]}
    aria-hidden="true"
  ></span>
  <span
    class:list={[
      'pointer-events-none absolute -right-3 -bottom-4 opacity-[0.08] transition-all duration-300 group-hover:opacity-[0.16] motion-safe:group-hover:scale-110 motion-safe:group-hover:-rotate-6',
      accent.ghost,
    ]}
    aria-hidden="true"
  >
    <HerramientaIcon id={herramienta.id} size={88} />
  </span>

  <div class="relative flex items-start justify-between gap-3">
    <div
      class:list={[
        'flex h-11 w-11 shrink-0 items-center justify-center rounded-xl shadow-sm',
        'transition-[transform,background-color,color] duration-300 ease-out',
        'motion-safe:group-hover:scale-110 motion-safe:group-hover:-rotate-6',
        accent.icon,
      ]}
    >
      <HerramientaIcon id={herramienta.id} size={20} />
    </div>
    <span
      class:list={[
        'mt-1 inline-flex items-center gap-1 text-[11px] font-black uppercase tracking-wider',
        accent.cta,
      ]}
    >
      Calcular
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 motion-safe:group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </span>
  </div>

  <HeadingTag
    class:list={[
      'relative mt-3 text-[15px] md:text-base font-serif font-black leading-snug tracking-tight text-neutral-900 transition-colors duration-300',
      accent.title,
    ]}
  >
    {herramienta.pregunta}
  </HeadingTag>

  <ul class="relative mt-3 flex flex-wrap gap-1.5" aria-label="Datos que pide la calculadora">
    {herramienta.inputLabels.map((input) => (
      <li class:list={['rounded-md px-2 py-0.5 text-[11px] font-semibold', accent.chip]}>
        {input.label}
        {input.unit && (
          <span class="ml-0.5 font-bold opacity-60">{input.unit}</span>
        )}
      </li>
    ))}
  </ul>
</a>
