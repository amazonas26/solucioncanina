---
import { type Herramienta } from '../utils/herramientas';

interface Props {
  herramienta: Herramienta;
}

const { herramienta } = Astro.props;
---

<a
  href={herramienta.href}
  class="group flex flex-col h-full rounded-2xl border border-neutral-200 bg-white p-6 md:p-7 hover:border-primary-300 hover:shadow-md hover:-translate-y-0.5 transition-all"
>
  <h2 class="text-xl md:text-2xl font-serif font-black text-neutral-900 leading-snug group-hover:text-primary-700 transition-colors">
    {herramienta.nombre}
  </h2>

  <dl class="mt-5 space-y-4 text-sm flex-grow">
    <div>
      <dt class="text-[10px] font-black uppercase tracking-widest text-primary-600 mb-1">Para qué sirve</dt>
      <dd class="text-neutral-600 leading-relaxed">{herramienta.paraQue}</dd>
    </div>
    <div>
      <dt class="text-[10px] font-black uppercase tracking-widest text-neutral-400 mb-1">Qué pide</dt>
      <dd class="text-neutral-600 leading-relaxed">{herramienta.inputs}</dd>
    </div>
    <div>
      <dt class="text-[10px] font-black uppercase tracking-widest text-neutral-400 mb-1">A quién le sirve</dt>
      <dd class="text-neutral-600 leading-relaxed">{herramienta.paraQuien}</dd>
    </div>
  </dl>

  <span class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-primary-700">
    Abrir calculadora
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
  </span>
</a>
