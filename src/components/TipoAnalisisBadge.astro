---
import {
  TIPO_ANALISIS_BADGE_CLASS,
  TIPO_ANALISIS_DEFAULT,
  tipoAnalisisHref,
  type TipoAnalisis,
} from '../utils/tipoAnalisis';

interface Props {
  tipo?: TipoAnalisis;
}

const { tipo = TIPO_ANALISIS_DEFAULT } = Astro.props;
const href = tipoAnalisisHref(tipo);
const badgeClass = TIPO_ANALISIS_BADGE_CLASS[tipo];
---

<a
  href={href}
  title={`Qué significa «${tipo}»`}
  class={`underline decoration-dotted underline-offset-4 transition-colors ${badgeClass}`}
>
  {tipo}
</a>
