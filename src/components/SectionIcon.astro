---
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className = "" } = Astro.props;

// Mapeo de paths SVG por nombre de icono. Cada entrada se renderiza dentro de un único
// <svg> con los atributos comunes, evitando duplicar diez veces el boilerplate en el HTML.
const PATHS: Record<string, string> = {
  bed: '<path d="M3 7v11"/><path d="M21 12v6"/><path d="M3 14h18"/><path d="M7 14V9a2 2 0 0 1 2-2h7a5 5 0 0 1 5 5v2"/><path d="M3 10h4"/>',
  joint:
    '<path d="M7 8a3 3 0 1 1 4.2-2.8"/><path d="M17 16a3 3 0 1 1-4.2 2.8"/><path d="M8.5 9.5 14.5 15.5"/><path d="m13 7 4 4"/><path d="m7 13 4 4"/>',
  bowl:
    '<path d="M4 11h16l-1.4 5.5A4 4 0 0 1 14.7 20H9.3a4 4 0 0 1-3.9-3.5L4 11Z"/><path d="M7 11c0-2.2 2.2-4 5-4s5 1.8 5 4"/><path d="M10 4h4"/>',
  kidney:
    '<path d="M8 4c-2.4 0-4 2.2-4 5.7C4 14 6.1 18 9 18c1.7 0 3-1.4 3-3.1V8.6C12 6 10.3 4 8 4Z"/><path d="M16 4c2.4 0 4 2.2 4 5.7C20 14 17.9 18 15 18c-1.7 0-3-1.4-3-3.1V8.6C12 6 13.7 4 16 4Z"/>',
  calm:
    '<path d="M12 21s-7-4.4-7-11a4 4 0 0 1 7-2.7A4 4 0 0 1 19 10c0 6.6-7 11-7 11Z"/><path d="M8 12h8"/>',
  senior:
    '<path d="M6 19c1.2-3 3.2-4.5 6-4.5S16.8 16 18 19"/><circle cx="12" cy="8" r="4"/><path d="M18 4v5"/><path d="M20.5 6.5h-5"/>',
  muzzle:
    '<path d="M5 10a7 7 0 0 1 14 0v4a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4v-4Z"/><path d="M8 13h8"/><path d="M9 17v-4"/><path d="M15 17v-4"/><path d="M7 9h10"/>',
  lead:
    '<path d="M7 7a4 4 0 1 1 5.7 3.6L7.5 15.8a2.4 2.4 0 1 0 3.4 3.4L19 11"/><path d="M6 6h.01"/>',
  ramp:
    '<path d="M3 18h18"/><path d="m5 18 10-10h4"/><path d="M10 13h3"/><path d="M7 16h3"/>',
  // Raspall amb pues.
  brush:
    '<path d="M4 15h16v3a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-3Z"/><path d="M7 15v-3"/><path d="M10 15v-4"/><path d="M14 15v-4"/><path d="M17 15v-3"/><path d="M12 11V4"/>',
  // Gota (incontinència).
  drop: '<path d="M12 3s-6 6.6-6 11a6 6 0 0 0 12 0c0-4.4-6-11-6-11Z"/><path d="M9.5 15a2.5 2.5 0 0 0 2.5 2.5"/>',
  paw:
    '<circle cx="11" cy="14" r="4"/><circle cx="6" cy="9" r="2"/><circle cx="11" cy="6" r="2"/><circle cx="16" cy="9" r="2"/><circle cx="18" cy="14" r="2"/>',
};

const inner = PATHS[name] ?? PATHS.paw;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
  set:html={inner}
/>
