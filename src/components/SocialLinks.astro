---
import { SOCIAL_PROFILES } from '../utils/seo';
import { SOCIAL_ICONS } from './socialIcons';
---

<nav aria-label="Redes sociales">
  <ul class="flex items-center gap-2">
    {SOCIAL_PROFILES.map((profile) => {
      const Icon = SOCIAL_ICONS[profile.name];
      return (
        <li>
          <a
            href={profile.href}
            target="_blank"
            rel="me noopener noreferrer"
            aria-label={`Solución Canina en ${profile.name}`}
            class="inline-flex items-center justify-center w-9 h-9 rounded-full text-white/70 hover:text-white hover:bg-white/10 transition-colors"
          >
            <Icon size={18} aria-hidden="true" />
          </a>
        </li>
      );
    })}
  </ul>
</nav>
