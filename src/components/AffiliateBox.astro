---
import { CheckCircle2 } from 'lucide-react';
interface Props {
  title: string;
  image: string;
  link: string;
  pros: string[];
  price?: string;
  badge?: string; // e.g. "Mejor Opción", "Más Económico"
}

const { title, image, link, pros, price, badge } = Astro.props;
---

<div class="my-8 rounded-xl border border-neutral-200 bg-neutral-50/50 overflow-hidden relative">
  {badge && (
    <div class="absolute top-0 left-0 bg-navy-700 text-white text-[10px] font-bold px-3 py-1 rounded-br-lg z-10 uppercase tracking-wider">
      {badge}
    </div>
  )}
  <div class="flex flex-col sm:flex-row p-6 gap-6 pt-10 sm:pt-6">
    <div class="w-full sm:w-1/3 flex-shrink-0 flex items-center justify-center bg-white rounded-lg p-4 border border-neutral-100 h-[200px]">
      <img src={image} alt={title} width="300" height="300" loading="lazy" decoding="async" class="max-w-full max-h-full object-contain mix-blend-multiply" />
    </div>
    
    <div class="flex-1 flex flex-col justify-center">
      <h3 class="text-lg sm:text-xl font-bold font-serif text-neutral-900 mb-3 leading-snug !mt-0">
        {title}
      </h3>
      
      {pros && pros.length > 0 && (
        <ul class="space-y-1.5 mb-5 p-0 list-none">
          {pros.map((pro) => (
            <li class="flex items-start gap-2 text-sm text-neutral-600 m-0 leading-snug">
              <CheckCircle2 size={14} className="text-primary-500 shrink-0 mt-0.5" />
              <span>{pro}</span>
            </li>
          ))}
        </ul>
      )}
      
      <div class="mt-auto flex flex-col sm:flex-row items-center gap-4">
        {price && (
          <div class="text-xl font-black text-neutral-900 shrink-0">
            {price}
          </div>
        )}
        <a 
          href={link} 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-6 py-3 text-sm font-bold text-black bg-[#FF9900] hover:bg-[#E68A00] rounded-lg transition-colors flex-1 w-full !no-underline whitespace-nowrap"
        >
          Ver precio en Amazon
        </a>
      </div>
    </div>
  </div>
</div>
