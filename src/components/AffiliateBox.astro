---
import { CheckCircle2 } from 'lucide-react';
interface Props {
  title: string;
  image: string;
  link: string;
  pros: string[];
  price?: string;
  badge?: string; // e.g. "Mejor Opción", "Más Económico"
}

const { title, image, link, pros, price, badge } = Astro.props;
---

<div class="my-10 rounded-2xl border border-primary-100 bg-gradient-to-br from-white to-primary-50/20 overflow-hidden relative shadow-sm hover:shadow-md hover:scale-[1.005] hover:border-primary-200 transition-all duration-300 group/affbox">
  {badge && (
    <div class="absolute top-0 left-0 bg-navy-700 text-white text-[10px] font-black px-4 py-1.5 rounded-br-xl z-10 uppercase tracking-[0.1em] shadow-sm">
      {badge}
    </div>
  )}
  <div class="flex flex-col sm:flex-row p-6 gap-6 pt-10 sm:pt-6">
    <div class="w-full sm:w-1/3 flex-shrink-0 flex items-center justify-center bg-white rounded-xl p-4 border border-neutral-100 h-[200px] group-hover/affbox:shadow-sm group-hover/affbox:border-primary-100 transition-all duration-300">
      <img src={image} alt={title} width="300" height="300" loading="lazy" decoding="async" class="max-w-full max-h-full object-contain mix-blend-multiply transition-transform duration-500 group-hover/affbox:scale-105" />
    </div>
    
    <div class="flex-1 flex flex-col justify-center">
      <h3 class="text-lg sm:text-xl font-serif font-black text-neutral-900 mb-3 leading-snug !mt-0 group-hover/affbox:text-primary-800 transition-colors duration-300">
        {title}
      </h3>
      
      {pros && pros.length > 0 && (
        <ul class="space-y-2 mb-5 p-0 list-none">
          {pros.map((pro) => (
            <li class="flex items-start gap-2.5 text-sm text-neutral-600 m-0 leading-relaxed">
              <CheckCircle2 size={15} className="text-primary-500 shrink-0 mt-0.5 group-hover/affbox:scale-110 transition-transform duration-300" />
              <span>{pro}</span>
            </li>
          ))}
        </ul>
      )}
      
      <div class="mt-auto flex flex-col sm:flex-row items-center gap-4">
        {price && (
          <div class="text-2xl font-black text-neutral-900 shrink-0 tracking-tight">
            {price}
          </div>
        )}
        <a 
          href={link} 
          target="_blank" 
          rel="sponsored nofollow noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-8 py-3.5 text-sm font-black text-black bg-gradient-to-r from-[#FF9900] to-[#FFB84D] hover:from-[#E68A00] hover:to-[#FF9900] rounded-xl transition-all duration-300 flex-1 w-full !no-underline whitespace-nowrap shadow-md shadow-orange-500/10 hover:shadow-orange-500/20 hover:-translate-y-0.5 active:translate-y-0"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover/affbox:translate-x-0.5"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
          Ver precio en Amazon
        </a>
      </div>
    </div>
  </div>
</div>
