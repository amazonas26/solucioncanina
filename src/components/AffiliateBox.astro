---
import { getCollection } from 'astro:content';
import { fechaPrecio, formatFechaPrecio } from '../utils/precioConsultado';
interface Props {
  title: string;
  image?: string;
  link: string;
  pros: string[];
  price?: string;
  badge?: string; // e.g. "Mejor Opción", "Más Económico"
}

const { title, image, link, pros, price, badge } = Astro.props;
const isInternalProduct = link.startsWith('/producto/');
const ctaLabel = isInternalProduct ? 'Ver análisis' : 'Dónde comprarlo';

// Si enlaza una ficha del catálogo, imagen y precio salen de ella: los del MDX
// se quedaban viejos (y la imagen era a veces una foto de stock).
const productSlug = isInternalProduct ? link.replace(/^\/producto\//, '').replace(/\/$/, '') : null;
const producto = productSlug
  ? (await getCollection('articulos')).find((a) => a.data.slug === productSlug)
  : undefined;
const imagen = producto ? producto.data.imagen : image;
const precio = producto ? producto.data.precio : price;
const precioFecha = producto && precio ? fechaPrecio(productSlug) : null;
---

<div class="not-prose my-12 border-t-2 border-neutral-900 pt-5 font-sans">
  <div class="flex flex-col sm:flex-row gap-6">
    {imagen && (
      <a href={link} class="w-full sm:w-[200px] shrink-0 aspect-square bg-neutral-50 flex items-center justify-center p-4 overflow-hidden" tabindex="-1" aria-hidden="true">
        <img src={imagen} alt="" width="300" height="300" loading="lazy" decoding="async" class="!w-auto !h-auto max-w-full max-h-full object-contain mix-blend-multiply" />
      </a>
    )}

    <div class="flex flex-col min-w-0 flex-1">
      {badge && <p class="!mb-0 text-sm font-semibold text-clay-600">{badge}</p>}
      <h3 class="!mt-1 !mb-0 font-serif !text-2xl font-semibold text-neutral-900 !leading-snug">{title}</h3>

      {pros && pros.length > 0 && (
        <ul class="list-none !pl-0 !mb-0 mt-3 space-y-1.5">
          {pros.map((pro) => (
            <li class="!m-0 flex items-start gap-2.5 text-[15px] text-neutral-800 leading-snug">
              <span class="text-primary-600 font-bold shrink-0" aria-hidden="true">+</span>
              <span>{pro}</span>
            </li>
          ))}
        </ul>
      )}

      <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
        {precio && <span class="text-2xl font-bold text-neutral-900 tabular-nums">{precio}</span>}
        <a
          href={link}
          target={isInternalProduct ? undefined : "_blank"}
          rel={isInternalProduct ? undefined : "sponsored nofollow noopener noreferrer"}
          class="inline-flex items-center gap-2 bg-neutral-900 text-paper px-6 py-3 text-sm font-semibold hover:bg-primary-800 transition-colors !no-underline"
        >
          {ctaLabel} <span aria-hidden="true">→</span>
        </a>
      </div>
      {precioFecha && (
        <p class="!mb-0 mt-3 text-xs text-neutral-500 leading-relaxed">
          Precio en Amazon.es consultado el {formatFechaPrecio(precioFecha)}. Puede haber cambiado.
        </p>
      )}
      {!isInternalProduct && (
        <p class="!mb-0 mt-3 text-xs text-neutral-500 leading-relaxed">
          Te llevamos a Amazon. Solución Canina no vende directamente:
          ganamos una pequeña comisión si decides comprar allí.
        </p>
      )}
    </div>
  </div>
</div>
