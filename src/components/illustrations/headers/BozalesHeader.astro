---
interface Props {
  title: string;
  decorative?: boolean;
}

const { title, decorative = false } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 1600 900"
  width="100%"
  height="100%"
  preserveAspectRatio="xMidYMid slice"
  fill="none"
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  class="block"
>
  {!decorative && (
    <>
      <title>{title}</title>
      <desc>Perro sentado de perfil con bozal de cesta, silueta plana en los colores de Solución Canina.</desc>
    </>
  )}
  <defs>
    <pattern id="ill-bozales-dots" width="24" height="24" patternUnits="userSpaceOnUse">
      <circle cx="2.5" cy="2.5" r="1.5" fill="#1B3A5C" fill-opacity="0.11" />
    </pattern>
  </defs>
  <rect width="1600" height="900" fill="#eef3f8" />
  <rect width="1600" height="900" fill="url(#ill-bozales-dots)" />
  <circle cx="1280" cy="220" r="300" fill="#d4deeb" fill-opacity="0.75" />
  <circle cx="1280" cy="220" r="168" fill="#a9bdd7" fill-opacity="0.35" />
  <ellipse cx="800" cy="812" rx="420" ry="22" fill="#1B3A5C" fill-opacity="0.07" />

  <g transform="translate(20 -90)">
    <g fill="#3C9E91">
      <ellipse cx="700" cy="560" rx="200" ry="165" />
      <rect x="690" y="640" width="78" height="148" rx="39" />
      <rect x="796" y="654" width="70" height="134" rx="35" />
      <circle cx="900" cy="400" r="140" />
      <ellipse cx="1120" cy="430" rx="150" ry="58" />
      <ellipse cx="820" cy="300" rx="40" ry="78" transform="rotate(-24 820 300)" />
    </g>
    <path
      d="M470 470 L555 575 L720 340"
      stroke="#1B3A5C"
      stroke-width="32"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <ellipse cx="1258" cy="426" rx="16" ry="13" fill="#1B3A5C" />
    <path d="M860 380 Q905 408 950 380" stroke="#1B3A5C" stroke-width="9" stroke-linecap="round" />
    <path
      fill="#1B3A5C"
      fill-rule="evenodd"
      d="M1048 392 h200 a36 36 0 0 1 0 72 h-200 a28 28 0 0 1 0 -72z M1130 428 m -18 0 a 18 18 0 1 1 36 0 a 18 18 0 1 1 -36 0z M1210 428 m -18 0 a 18 18 0 1 1 36 0 a 18 18 0 1 1 -36 0z"
    />
    <path
      d="M1048 450 C980 520 900 515 860 460 C910 470 980 458 1048 450Z"
      fill="#1B3A5C"
    />
  </g>
</svg>
