---
interface Props {
  title: string;
  decorative?: boolean;
}

const { title, decorative = false } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 1600 900"
  width="100%"
  height="100%"
  preserveAspectRatio="xMidYMid slice"
  fill="none"
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  class="block"
>
  {!decorative && (
    <>
      <title>{title}</title>
      <desc>Golden Retriever de pie junto a un cepillo, silueta plana en los colores de Solución Canina.</desc>
    </>
  )}
  <defs>
    <pattern id="ill-golden-dots" width="40" height="40" patternUnits="userSpaceOnUse">
      <circle cx="4" cy="4" r="1.4" fill="#1B3A5C" fill-opacity="0.08" />
    </pattern>
  </defs>
  <rect width="1600" height="900" fill="#f6f1e4" />
  <rect width="1600" height="900" fill="url(#ill-golden-dots)" />
  <path d="M-40 740 Q480 520 920 720 T1680 580 V900 H-40Z" fill="#eadfc8" />
  <ellipse cx="1280" cy="200" rx="340" ry="200" fill="#efe6d2" />
  <ellipse cx="800" cy="822" rx="460" ry="24" fill="#1B3A5C" fill-opacity="0.07" />

  <g fill="#3C9E91">
    <ellipse cx="760" cy="520" rx="195" ry="155" />
    <rect x="650" y="620" width="58" height="178" rx="29" />
    <rect x="728" y="638" width="52" height="160" rx="26" />
    <rect x="820" y="628" width="56" height="170" rx="28" />
    <rect x="898" y="646" width="50" height="152" rx="25" />
    <circle cx="1020" cy="340" r="128" />
    <ellipse cx="1188" cy="372" rx="132" ry="56" />
    <ellipse cx="930" cy="268" rx="48" ry="100" transform="rotate(-26 930 268)" />
    <ellipse cx="520" cy="500" rx="140" ry="40" transform="rotate(-20 520 500)" />
    <ellipse cx="430" cy="470" rx="70" ry="24" transform="rotate(-8 430 470)" />
  </g>
  <ellipse cx="1302" cy="368" rx="18" ry="14" fill="#1B3A5C" />
  <path d="M990 322 Q1036 354 1086 326" stroke="#1B3A5C" stroke-width="9" stroke-linecap="round" />

  <rect x="1288" y="620" width="26" height="150" rx="10" fill="#1B3A5C" />
  <rect x="1268" y="754" width="66" height="16" rx="6" fill="#244b7c" />
  <rect x="1264" y="770" width="10" height="48" rx="4" fill="#3C9E91" />
  <rect x="1278" y="770" width="10" height="54" rx="4" fill="#3C9E91" />
  <rect x="1292" y="770" width="10" height="50" rx="4" fill="#3C9E91" />
  <rect x="1306" y="770" width="10" height="54" rx="4" fill="#3C9E91" />
  <rect x="1320" y="770" width="10" height="46" rx="4" fill="#3C9E91" />
</svg>
