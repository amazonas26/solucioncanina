<figure>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 900 520"
    width="100%"
    role="img"
    aria-labelledby="ill-muzzle-title ill-muzzle-desc"
    class="block bg-[#fafafa]"
  >
    <title id="ill-muzzle-title">Cómo medir el hocico del perro</title>
    <desc id="ill-muzzle-desc">
      Longitud desde la punta de la nariz hasta 1-2 cm por debajo del ojo, y circunferencia en el punto más ancho justo debajo de los ojos.
    </desc>
    <rect width="900" height="520" fill="#fafafa" />

    <!-- Head: circle + snout + ear overlapping as one mass -->
    <g fill="#3C9E91">
      <circle cx="355" cy="215" r="118" />
      <ellipse cx="530" cy="238" rx="148" ry="64" />
      <ellipse cx="270" cy="175" rx="52" ry="78" />
    </g>
    <ellipse cx="668" cy="234" rx="17" ry="14" fill="#1B3A5C" />
    <path d="M330 200 Q372 228 414 200" fill="none" stroke="#1B3A5C" stroke-width="7" stroke-linecap="round" />
    <!-- inner-eye reference (where length ends) -->
    <circle cx="392" cy="214" r="4.5" fill="#1B3A5C" />

    <!-- 2 Circunferencia: widest point just below the eyes -->
    <ellipse
      cx="430"
      cy="240"
      rx="92"
      ry="70"
      fill="none"
      stroke="#1B3A5C"
      stroke-width="2.4"
      stroke-dasharray="8 6"
    />
    <path d="M430 170 V148" fill="none" stroke="#1B3A5C" stroke-width="1.75" />
    <circle cx="430" cy="134" r="13" fill="#1B3A5C" />
    <text x="430" y="139" text-anchor="middle" fill="#fff" font-family="Inter, system-ui, sans-serif" font-size="14" font-weight="700">2</text>
    <text x="500" y="78" fill="#1B3A5C" font-family="Inter, system-ui, sans-serif" font-size="20" font-weight="700">Circunferencia</text>
    <text x="500" y="102" fill="#525252" font-family="Inter, system-ui, sans-serif" font-size="15">Punto más ancho, bajo los ojos</text>
    <path d="M444 134 C470 110 488 104 500 104" fill="none" stroke="#1B3A5C" stroke-width="1.6" />

    <!-- 1 Longitud: nose tip → 1–2 cm below inner eye -->
    <g stroke="#FF9900" stroke-width="2.6" stroke-linecap="round" fill="none">
      <path d="M392 228 V355" />
      <path d="M668 248 V355" />
      <path d="M392 355 H668" />
      <path d="M392 347 v16" />
      <path d="M668 347 v16" />
    </g>
    <circle cx="392" cy="228" r="4.5" fill="#FF9900" />
    <circle cx="668" cy="248" r="4.5" fill="#FF9900" />
    <circle cx="530" cy="390" r="13" fill="#1B3A5C" />
    <text x="530" y="395" text-anchor="middle" fill="#fff" font-family="Inter, system-ui, sans-serif" font-size="14" font-weight="700">1</text>
    <text x="530" y="424" text-anchor="middle" fill="#1B3A5C" font-family="Inter, system-ui, sans-serif" font-size="20" font-weight="700">Longitud</text>
    <text x="530" y="448" text-anchor="middle" fill="#525252" font-family="Inter, system-ui, sans-serif" font-size="15">Nariz → 1–2 cm bajo el ojo</text>
  </svg>
  <figcaption class="border-t border-neutral-200 bg-white px-5 py-3 text-center text-sm italic text-neutral-500">
    Mide dos cosas: longitud (punta de la nariz hasta 1–2 cm por debajo del ojo) y circunferencia en el punto más ancho, justo debajo de los ojos.
  </figcaption>
</figure>
