<figure>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 900 520"
    width="100%"
    role="img"
    aria-labelledby="ill-bed-title ill-bed-desc"
    class="block bg-[#fafafa]"
  >
    <title id="ill-bed-title">Cómo medir al perro para la cama</title>
    <desc id="ill-bed-desc">
      Longitud desde la punta del hocico hasta la base de la cola, más 30 cm de margen para la talla mínima.
    </desc>
    <rect width="900" height="520" fill="#fafafa" />

    <g fill="#3C9E91">
      <ellipse cx="430" cy="248" rx="210" ry="72" />
      <circle cx="218" cy="236" r="78" />
      <ellipse cx="128" cy="248" rx="78" ry="32" />
      <ellipse cx="250" cy="186" rx="36" ry="52" />
      <rect x="300" y="290" width="70" height="28" rx="14" />
      <rect x="470" y="292" width="66" height="26" rx="13" />
      <ellipse cx="668" cy="250" rx="48" ry="22" />
    </g>
    <ellipse cx="70" cy="248" rx="14" ry="11" fill="#1B3A5C" />
    <path d="M198 220 Q230 246 264 222" fill="none" stroke="#1B3A5C" stroke-width="6" stroke-linecap="round" />

    <!-- 1 Longitud: hocico → base de cola -->
    <g stroke="#FF9900" stroke-width="2.6" stroke-linecap="round" fill="none">
      <path d="M70 268 V360" />
      <path d="M640 272 V360" />
      <path d="M70 360 H640" />
      <path d="M70 352 v16" />
      <path d="M640 352 v16" />
    </g>
    <circle cx="70" cy="248" r="4.5" fill="#FF9900" />
    <circle cx="640" cy="250" r="4.5" fill="#FF9900" />
    <circle cx="355" cy="392" r="13" fill="#1B3A5C" />
    <text x="355" y="397" text-anchor="middle" fill="#fff" font-family="Inter, system-ui, sans-serif" font-size="14" font-weight="700">1</text>
    <text x="355" y="428" text-anchor="middle" fill="#1B3A5C" font-family="Inter, system-ui, sans-serif" font-size="20" font-weight="700">Longitud</text>
    <text x="355" y="452" text-anchor="middle" fill="#525252" font-family="Inter, system-ui, sans-serif" font-size="15">Hocico → base de la cola</text>

    <!-- 2 Margen +30 cm -->
    <g stroke="#1B3A5C" stroke-width="2.2" stroke-linecap="round" fill="none" stroke-dasharray="7 6">
      <path d="M640 360 H820" />
      <path d="M820 272 V360" />
      <path d="M820 352 v16" />
    </g>
    <circle cx="820" cy="392" r="13" fill="#1B3A5C" />
    <text x="820" y="397" text-anchor="middle" fill="#fff" font-family="Inter, system-ui, sans-serif" font-size="14" font-weight="700">2</text>
    <text x="730" y="330" text-anchor="middle" fill="#1B3A5C" font-family="Inter, system-ui, sans-serif" font-size="18" font-weight="700">+ 30 cm</text>
    <text x="820" y="428" text-anchor="middle" fill="#1B3A5C" font-family="Inter, system-ui, sans-serif" font-size="16" font-weight="700">Margen</text>
    <text x="820" y="452" text-anchor="middle" fill="#525252" font-family="Inter, system-ui, sans-serif" font-size="14">Largo mínimo</text>
  </svg>
  <figcaption class="border-t border-neutral-200 bg-white px-5 py-3 text-center text-sm italic text-neutral-500">
    Mide al perro estirado: punta del hocico hasta la base de la cola (sin el rabo) y suma 30 cm. Ese es el largo mínimo de la cama.
  </figcaption>
</figure>
