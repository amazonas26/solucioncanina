---
import { hasBlogHeader } from './registry';
import { renderBlogHeader } from './compose';

interface Props {
  slug: string;
  title: string;
  decorative?: boolean;
  class?: string;
}

const { slug, title, decorative = false, class: className = '' } = Astro.props;

const svg = hasBlogHeader(slug) ? renderBlogHeader(slug, { title, decorative }) : null;
---

{svg && (
  <div class:list={['blog-header-illustration h-full w-full', className]} set:html={svg} />
)}
