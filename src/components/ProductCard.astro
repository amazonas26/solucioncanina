---

interface Props {
  slug: string;
  nombre: string;
  linkAmazon?: string;
  imagen?: string;
  descripcion?: string;
  precio?: string;
  precioOriginal?: string;
  descuentoPct?: number;
  categoria?: string;
  marca?: string;
  valoracion?: number;
  valoracionesCount?: number;
  /** Posició al rànquing (portada «Lo más comprado») */
  rank?: number;
}

const { slug, nombre, imagen, precio, precioOriginal, descuentoPct, marca, valoracion, valoracionesCount, rank } = Astro.props;

const fmtCount = (n?: number) => {
  if (!n || n <= 0) return null;
  if (n >= 1000) return `${(n / 1000).toFixed(1).replace(/\.0$/, "")}k`;
  return n.toLocaleString("es-ES");
};

// Use a placeholder if no image is provided
const imageUrl = imagen || '/logo.png';
const detailUrl = `/producto/${slug}/`;
const MIN_VISIBLE_RATING = 3.7;
const showStars = typeof valoracion === "number" && valoracion >= MIN_VISIBLE_RATING;
---

<article class="group relative flex flex-col h-full">
  <div class="relative aspect-square bg-neutral-50 flex items-center justify-center p-5 overflow-hidden">
    <img
      src={imageUrl}
      alt=""
      width="400"
      height="400"
      loading="lazy"
      decoding="async"
      class="max-w-full max-h-full object-contain mix-blend-multiply transition-transform duration-300 group-hover:scale-[1.03]"
    />
    {rank && (
      <span class="absolute top-2 left-3 font-serif text-[2.6rem] leading-none font-semibold text-clay-600 tabular-nums" aria-label={`Número ${rank} en ventas`}>{rank}</span>
    )}
  </div>

  <div class="flex flex-col flex-grow pt-3">
    {marca && (
      <p class="text-xs text-neutral-500 truncate">
        {marca}{["ADVANCE", "LENDA", "ARTERO"].includes(marca.toUpperCase()) && " · marca española"}
      </p>
    )}
    <h3 class="mt-1 font-serif text-[1.15rem] leading-snug font-semibold text-neutral-900 line-clamp-3">
      <a href={detailUrl} class="after:absolute after:inset-0 group-hover:underline decoration-1 underline-offset-4">{nombre}</a>
    </h3>

    {(precio || showStars) && (
      <div class="mt-auto pt-3 flex items-end justify-between gap-3">
        {precio ? (
          <div class="min-w-0">
            <span class="block text-[1.05rem] font-bold text-neutral-900 tabular-nums leading-tight">{precio}</span>
            {precioOriginal && (
              <span class="block text-xs text-neutral-500 mt-0.5">
                <s>{precioOriginal}</s>
                {typeof descuentoPct === 'number' && descuentoPct > 0 && (
                  <span class="ml-1 font-semibold text-clay-600">−{descuentoPct} %</span>
                )}
              </span>
            )}
          </div>
        ) : (
          <span />
        )}
        {showStars && (
          <span
            class="shrink-0 text-sm text-neutral-700 tabular-nums"
            aria-label={`Valoración en Amazon: ${valoracion.toFixed(1)} sobre 5${valoracionesCount ? ` con ${valoracionesCount} reseñas` : ''}`}
            title="Valoración en Amazon"
          >
            <span class="text-[#d99a1e]" aria-hidden="true">★</span> {valoracion.toFixed(1)}
            {fmtCount(valoracionesCount) && <span class="text-xs text-neutral-500"> ({fmtCount(valoracionesCount)})</span>}
          </span>
        )}
      </div>
    )}
  </div>
</article>
