---
interface Props {
  nombre: string;
  linkAmazon: string;
  imagen?: string;
  descripcion?: string;
  precio?: string;
  precioOriginal?: string;
  descuentoPct?: number;
  categoria?: string;
  marca?: string;
}

const { nombre, linkAmazon, imagen, descripcion, precio, precioOriginal, descuentoPct, categoria, marca } = Astro.props;

// Use a placeholder if no image is provided
const imageUrl = imagen || 'https://images.unsplash.com/photo-1548199973-03cce0bbc87b?auto=format&fit=crop&q=80&w=800&h=600';
---

<div class="group relative flex flex-col bg-white rounded-xl overflow-hidden shadow-card hover:shadow-card-hover transition-shadow duration-200 border border-neutral-200">
  <!-- Image -->
  <div class="aspect-[4/3] w-full bg-neutral-100 overflow-hidden relative">
    <img
      src={imageUrl}
      alt={nombre}
      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 ease-out"
    />

    {categoria && (
      <div class="absolute top-3 left-3 z-10">
        <span class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider bg-white/95 text-neutral-600 rounded-md shadow-sm border border-neutral-100">
          {categoria}
        </span>
      </div>
    )}

    {typeof descuentoPct === 'number' && descuentoPct > 0 && (
      <div class="absolute top-3 right-3 z-10">
        <span class="px-2 py-1 text-[11px] font-bold bg-red-500 text-white rounded-md shadow-sm">
          -{descuentoPct}%
        </span>
      </div>
    )}
  </div>
  
  <!-- Content -->
  <div class="flex flex-col flex-grow p-4">
    {marca && (
      <p class="text-[10px] font-semibold text-neutral-400 mb-1.5 uppercase tracking-wider">
        {marca}
      </p>
    )}
    
    <h3 class="text-sm font-bold text-neutral-900 line-clamp-2 group-hover:text-primary-600 transition-colors leading-snug mb-2 font-serif">
      {nombre}
    </h3>
    
    {descripcion && (
      <p class="text-xs text-neutral-400 line-clamp-2 mb-3 leading-relaxed flex-grow">
        {descripcion}
      </p>
    )}

    {/* Price */}
    {precio && (
      <div class="flex items-baseline gap-2 mb-3 pb-3 border-b border-neutral-100">
        <span class="text-lg font-extrabold text-neutral-900">
          {precio}
        </span>
        {precioOriginal && (
          <span class="text-xs font-medium text-neutral-400 line-through">
            {precioOriginal}
          </span>
        )}
      </div>
    )}
    
    <div class="mt-auto">
      <a 
        href={linkAmazon} 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center justify-center w-full px-4 py-2.5 text-sm font-bold text-neutral-800 bg-accent-500 hover:bg-accent-600 rounded-lg transition-colors gap-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
        Ver en Amazon
      </a>
    </div>
  </div>
</div>
