---
interface Props {
  slug: string;
  nombre: string;
  linkAmazon: string;
  imagen?: string;
  descripcion?: string;
  precio?: string;
  precioOriginal?: string;
  descuentoPct?: number;
  categoria?: string;
  marca?: string;
  valoracion?: number;
  valoracionesCount?: number;
}

const { slug, nombre, linkAmazon, imagen, descripcion, precio, precioOriginal, descuentoPct, categoria, marca, valoracion, valoracionesCount } = Astro.props;

const fmtCount = (n?: number) => {
  if (!n || n <= 0) return null;
  if (n >= 1000) return `${(n / 1000).toFixed(1).replace(/\.0$/, "")}k`;
  return n.toLocaleString("es-ES");
};

// Use a placeholder if no image is provided
const imageUrl = imagen || 'https://images.unsplash.com/photo-1548199973-03cce0bbc87b?auto=format&fit=crop&q=80&w=800&h=600';
const detailUrl = `/producto/${slug}`;
const MIN_VISIBLE_RATING = 3.7;
const showStars = typeof valoracion === "number" && valoracion >= MIN_VISIBLE_RATING;
---

<div class="group relative flex flex-col h-full bg-white rounded-xl overflow-hidden shadow-card hover:shadow-card-hover transition-shadow duration-200 border border-neutral-200">
  <!-- Image -->
  <a href={detailUrl} class="aspect-[4/3] w-full bg-neutral-100 overflow-hidden relative block">
    <img
      src={imageUrl}
      alt={nombre}
      width="400"
      height="300"
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 ease-out"
    />

    {categoria && (
      <div class="absolute top-3 left-3 z-10">
        <span class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider bg-white/95 text-neutral-600 rounded-md shadow-sm border border-neutral-100">
          {categoria}
        </span>
      </div>
    )}

    {typeof descuentoPct === 'number' && descuentoPct > 0 && (
      <div class="absolute top-0 right-4 z-10">
        <div
          style="clip-path: polygon(0 0, 100% 0, 100% 82%, 50% 100%, 0 82%);"
          class="flex flex-col items-center justify-center w-10 pt-2 pb-4 bg-gradient-to-b from-red-600 to-red-500 shadow-lg shadow-red-500/40"
        >
          <span class="text-[9px] font-black text-white/80 uppercase tracking-widest leading-none mb-0.5">OFF</span>
          <span class="text-sm font-black text-white leading-none">{descuentoPct}%</span>
        </div>
      </div>
    )}
  </a>
  
  <!-- Content -->
  <div class="flex flex-col flex-grow p-4">
    <div class="flex flex-wrap items-center gap-2 mb-1.5">
      {marca && (
        <p class="text-[10px] font-bold text-neutral-400 uppercase tracking-wider">
          {marca}
        </p>
      )}
      {marca && ["ADVANCE", "LENDA", "ARTERO"].includes(marca.toUpperCase()) && (
        <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[8px] font-extrabold bg-amber-50 text-amber-700 border border-amber-200 rounded-md">
          🇪🇸 MARCA ESPAÑOLA
        </span>
      )}
      {categoria === "Alimentación específica" && (
        <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[8px] font-extrabold bg-blue-50 text-blue-700 border border-blue-200 rounded-md">
          🩺 DIETA CLÍNICA
        </span>
      )}
    </div>
    
    <a href={detailUrl} class="block">
      <h3 class="text-sm font-bold text-neutral-900 line-clamp-2 group-hover:text-primary-600 transition-colors leading-snug mb-2 font-serif">
        {nombre}
      </h3>
    </a>
    
    <!-- Description — fixed height so cards always align -->
    <p class="text-xs text-neutral-400 line-clamp-2 mb-3 leading-relaxed h-8">
      {descripcion || '\u00a0'}
    </p>

    {/* Price + Rating */}
    {(precio || showStars) && (
      <div class="flex items-center justify-between gap-3 mb-3 pb-3 border-b border-neutral-100">
        {precio ? (
          <div class="flex items-baseline gap-2 min-w-0">
            <span class="text-lg font-extrabold text-neutral-900">
              {precio}
            </span>
            {precioOriginal && (
              <span class="text-xs font-medium text-neutral-400 line-through">
                {precioOriginal}
              </span>
            )}
          </div>
        ) : (
          <span />
        )}

        {showStars && (
          <div
            class="flex items-center gap-1 shrink-0"
            aria-label={`Valoración ${valoracion.toFixed(1)} sobre 5${valoracionesCount ? ` con ${valoracionesCount} reseñas` : ''}`}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="#FACC15"
              stroke="#EAB308"
              stroke-width="1.5"
              stroke-linejoin="round"
              class="h-4 w-4 shrink-0"
              aria-hidden="true"
            >
              <polygon points="12,2 14.94,8.96 22.5,9.56 16.74,14.62 18.49,22 12,17.93 5.51,22 7.26,14.62 1.5,9.56 9.06,8.96" />
            </svg>
            <span class="text-sm font-bold text-neutral-900 tabular-nums">
              {valoracion.toFixed(1)}
            </span>
            {fmtCount(valoracionesCount) && (
              <span class="text-[11px] font-medium text-neutral-400 tabular-nums">
                ({fmtCount(valoracionesCount)})
              </span>
            )}
          </div>
        )}
      </div>
    )}
    
    <div class="mt-auto">
      <a 
        href={linkAmazon} 
        target="_blank" 
        rel="sponsored nofollow noopener noreferrer"
        class="flex items-center justify-center w-full px-4 py-2.5 text-sm font-bold text-black bg-[#FF9900] hover:bg-[#E68A00] rounded-lg transition-colors whitespace-nowrap"
      >
        Ver precio en Amazon
      </a>
    </div>
  </div>
</div>
